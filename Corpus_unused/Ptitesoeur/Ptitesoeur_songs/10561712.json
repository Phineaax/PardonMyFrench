        },
        {
          "n": "11",
          "text": "J'en ai trop vu, ce monde est moche (moche, mo haaaaa, moche, mo ha haaaa)",
          "rhyme": "OS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "J'suis né j'étais dans l'piège",
