        },
        {
          "n": "14",
          "text": "On est pas blanc comme neige",
          "rhyme": "EZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "On a la haine d'puis qu'on est gosse",
