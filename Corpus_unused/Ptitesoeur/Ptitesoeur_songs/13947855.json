      "lines": [
        {
          "n": "0",
          "text": "Le cash qu'on sort il m'a fait crash out",
          "rhyme": "awt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Ma le-gueu [?] sur c'qu'on a cash out",
          "rhyme": "awt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu fais des posts et c'est comme Diddy",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Si j'te dépose qu'est-ce qu'tu vas filmer ?",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'me sentais passer do you feel me ?",
          "rhyme": "@",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'voyages pas c'est pas les [pilgrims?]",
          "rhyme": "im",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Dans mon appart c'est le [déluge ?]",
          "rhyme": "yZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "J'ai fait des efforts [pour pas m'tuer?]",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Quand même à la fin tout l'monde va périr",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Envoyer valser dans la paye",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Qu'est-ce qu'on nous réserve dans l'après ?",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "C'qu'y a juste avant bish on l'a prévu",
          "rhyme": "y",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Envie du cash et pas du crédit",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Choper une bague sans le crédit",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Ta carrière, elle est pas très crédible",
          "rhyme": "ibl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Tu parles mal et [mon batard s'lève?]",
          "rhyme": "Ev",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Si tu call t'sais qu'on est pas ready",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Vas-t-on se re-tchek au paradis",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "J'dois répéter c'que j'ai djà dit",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "Les concessions pour la vie qu'javais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "MNG party j't'invite jamais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "J't'ai vu baver sur c'que j'avais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "J'en disais peu sur c'que je savais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Jamais j'gamberge comme sous la salle",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "On va pas s'té-plan dans la salle",
