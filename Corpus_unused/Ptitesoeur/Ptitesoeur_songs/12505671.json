      "lines": [
        {
          "n": "0",
          "text": "S.F.N",
          "rhyme": "n",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "A.k.a les most famous nobody du jeu truqué",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "On crée l'argent à partir de rien",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Certains s'demandent si c'est d'la magie noire pendant qu'ton trappeur à buzzcut préféré flex la paye de ses darons",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Et qu'ton label découvre des nouvelles manières de gaspiller la Sacem de Disiz La Peste",
          "rhyme": "Est",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "On est les premiers à avoir mis la main sur la faille",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Et on en paye chaque jour le prix",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Pour le meilleur, et surtout pour le pire",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Neo', tu peux envoyer la suite",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        }
      ],
