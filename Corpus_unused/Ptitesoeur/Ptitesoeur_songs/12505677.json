        {
          "n": "1",
          "text": "J'ai bâti au moins deux cents casas dans ma bre-ch'",
          "rhyme": "iS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'comprends, vraiment rien à d'essayer d'être vraiment moi-même",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Chez nous, on sait pas c'que ça signifie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Toi, tu penses vraiment qu'on s'affiche pour la performance ?",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "On a une mission à accomplir",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        }
