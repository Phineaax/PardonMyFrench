  "lyrics": [
    {
      "section_id": "section_1",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Y a qui d'la veille, là, quand j'voulais m'en aller ?",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Je quitte la pièce, j'entends les passants s'marrer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Petite, j'dessinais, j'jouais pas à la marelle",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'suis partie du royaume avec la crown on my head",
          "rhyme": "Ed",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'ai mis mes deux jambes à la corbeille",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'suis bien trop sensible pour ce corps, babe",
          "rhyme": "ab",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'ai le regard dur que je mérite pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "J'avais neuf ans, j'voulais d'jà m'couper le sexe",
          "rhyme": "Eks",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "T'as mis ta main d'vant, mais pourtant, tu le sais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "La pression baissе depuis qu'j'ai perdu le ciеl",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Le cercueil d'en bas ressemble à un berceau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Ici, la môme avait l'cou pendu à son cerceau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "(Cerceau, cerceau, cerceau, cerceau)",
          "rhyme": null,
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "(Cerceau, cerceau, cerceau, cerceau)",
          "rhyme": null,
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Oh my god, j'ai r'fait des nœuds avec ma head",
          "rhyme": "Ed",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "(Ma head, ma head, ma head, ma head)",
          "rhyme": null,
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "(Ma head, ma head, ma head, ma head)",
          "rhyme": null,
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "J'ai bâti au moins deux cents casas dans ma bre-ch'",
          "rhyme": "iS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "D'année en année, j'enlève les barrières dans ma tête",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "On était d'jà doomed, remets l'bail amer dans ma 'teille (pas demander pardon)",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "La p'tite d'la veille demandait pardon (tu m'as comme rangée dans les cartons)",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "Ils m'ont comme rangé dans les cartons",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "Dis-moi qui t'es vraiment sans les hommes (nan, désolé)",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Fais pas attention, à ceux que je nomme",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "Le tro-m' m'donne l'impression de gerber",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "25",
          "text": "À chacun sa prison de chair (chair)",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "26",
          "text": "D'année en année, j'ai perdu foi en l'humanité",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "27",
          "text": "Mon ego apprécie la luxure et la vanité",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "28",
          "text": "J'voulais en finir avant d'être parasitée par la puberté",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "29",
          "text": "Le nouveau-né est encore pur de toutes les bavures du monde plastique",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "30",
          "text": "Y a rien d'magique, je n'fais qu'imager",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "31",
          "text": "Oh my god, j'ai r'fait des nœuds avec ma head",
          "rhyme": "Ed",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "32",
          "text": "Petite, je n'f'sais qu'imaginer, imaginer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "33",
          "text": "J'ai bâti au moins deux cents casas dans ma bre-ch'",
          "rhyme": "iS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "34",
          "text": "À c't'époque, c'tait pas des bons, ouais, ouais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "35",
          "text": "Dans les flaques j'faisais des bonds, ouais, ouais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "36",
          "text": "J'perdais mon temps dans le bac à sable",
          "rhyme": "abl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "37",
          "text": "Sans avenir, j'ai fait mes bagages",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABCDEFGHBIIJJCJJKLDMMNNAOAAAPACAKHHQR",
      "rhyme_vowel": "AABBBCCBBBDDEEBEEFBBGGHHABAAAFABAFBBCC"
    },
    {
