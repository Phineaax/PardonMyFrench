    {
      "section_id": "section_4",
      "type": "outro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Force de m'guetter, j'me suis gâchée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Les pêchés d'la vie passée sont passés sous les rideaux",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu fais ta part, c'est pas assez",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Trop s'aimer, ça m'a fâchée, mon regard dans l'reflet du bigo",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "D'vant l'miroir, la vie est à chier, les humains, j'en ai assez",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Les humains, j'en ai assez",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'nettoie pas les draps qu'on a tâchés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Les souvenirs de nous m'y attachaient",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABABAAAC",
      "rhyme_vowel": "ABABAAAC"
    }
