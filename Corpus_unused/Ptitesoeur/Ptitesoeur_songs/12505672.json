  "lyrics": [
    {
      "section_id": "section_1",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Avant déjà, la môme avait prévu d'run away",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Le soleil était radieux, et s'est tournée to the right",
          "rhyme": "ajt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu te fiches du r'gard des gens mais quand c'est toi, c'est pas pareil",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Mais quand c'est toi, c'est pas pareil",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Je t'aime un peu plus aujourd'hui que toi, tu t'aimais la veille",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCCC",
      "rhyme_vowel": "ABCCC"
    },
    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'voulais tout arrêter mais ta voix me crie encore",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Encore, encore une dernière dose avant d'passer la porte",
          "rhyme": "ORt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'penserai à toi la prochaine fois qu'j'traumatiserai mon corps",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Encore, encore une dernière chance avant qu'ça ne fasse plus jamais mal",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Rainy day, aujourd'hui, mon grand, tu sors sans l'parapluie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "T'as perdu l'tien car y a son cœur qui bat pour toi là-bas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Rainy day, aujourd'hui, mon grand, tu sors sans l'parapluie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "L'impression d's'être déjà tout dit quand on parle devant l'miroir",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Tu peux même passer l'pied d'l'appart', j'te laisserai saccager ma part",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "T'es beau avec ma part, t'es beau avec mon",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "T'es beau avec ma peine, j'suis si belle avec tes torts",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Ma p'tite, remballe ta hate, bouge ta belle bouille de la corde",
          "rhyme": "ORd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Entre les mauvais accords, prends soin de toi d'abord",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'ai fait l'erreur d'parler au micro comme j'parlais au vide",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Et ensuite, on verra, et ensuite, on verra",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABACDEDFFGAHAIE",
      "rhyme_vowel": "AAABCBCBBDAAACB"
    },
