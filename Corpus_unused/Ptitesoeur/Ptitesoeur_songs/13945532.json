  "lyrics": [
    {
      "section_id": "section_1",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'nique ma peau du desk enfermée dans le old time",
          "rhyme": "ajm",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Me parle pas, j'tais stuck au dièse qui m'faisait sentir comme un old boy",
          "rhyme": "Oj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "C'est ma timp qu'a fait le palace, les hématomes m'rappellent le passé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Les beaux garçons racontent des salades, pour qu'on oublie ce qui s'est passé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'raconte toutes les choses qu'on a cassées",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'ai pas l'habitude d'faire les tales moi",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "On taffe du bureau comme si l'cadavre",
          "rhyme": "avR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Il еn avait jamais assez",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "On prend du temps pour fairе les jalons",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "La cage dans ma tête les rend jaloux",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "On s'f'ra du mal, on f'ra un bad buzz ?",
          "rhyme": "az",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "J'fumais deux fois l'poids de mon poids plume ma gueule",
          "rhyme": "9l",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCCCDECFGHI",
      "rhyme_vowel": "ABCCCAACDEAF"
    },
    {
      "section_id": "section_2",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'consommais deux fois l'poids d'mon poids plume ma gueule",
          "rhyme": "9l",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Y avait pas l'temps pour faire ce taff",
          "rhyme": "af",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Bâtard y a pas d'quoi s'planquer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABC",
      "rhyme_vowel": "ABC"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "B j'ai bossé pour le render",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Ils s'demandent quel est le gender",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'ai fait ma base, elle est impénétrable",
          "rhyme": "abl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Le poids d'la partie l'est à peine étroit",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Le goût d'essence me met [dans plein d'états?]",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "La vie d'la veille, le bien les hoes les [?]",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Le point tendu quand ça m'disait \"haut les mains\"",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Le noir et blanc, je fais la belle chez moi",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'étais même djà tentée par Belzébuth",
          "rhyme": "yt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Ça m'fait du cash même quand je baise ces putes",
          "rhyme": "yt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Toi tu veux bash, tu sais pas d'où ça vient",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Je skippe la mâche mais pas le doux tamien",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "J'suis morte c'est tout, ramène le doute y a rien",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Ca ment certain'ment si j'dis qu'tout va bien",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Fils de tainp' ça va t'faire une césarienne",
          "rhyme": "En",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "MNG gagnait le César hier",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        }
      ],
