      "lines": [
        {
          "n": "0",
          "text": "Déso', j'ai pas les mots, dérangé par les maux d'avant",
          "rhyme": "#",
          "persona_id": "room1"
        },
        {
          "n": "1",
          "text": "Mon ange c'est pas nouveau, mon an- mon ange c'est pas nouveau",
          "rhyme": "o",
          "persona_id": "room1"
        },
        {
          "n": "2",
          "text": "Le monde est à nous deux",
          "rhyme": "2",
          "persona_id": "room1"
        },
        {
          "n": "3",
          "text": "Seulement jusqu'à ce qu'on l'ait vraiment",
          "rhyme": "#",
          "persona_id": "room1"
        },
        {
          "n": "4",
          "text": "« Dis moi à qui tu mens Soeur »",
          "rhyme": "9R",
          "persona_id": "room1"
        },
        {
          "n": "5",
          "text": "Lui c'est un fichu menteur",
