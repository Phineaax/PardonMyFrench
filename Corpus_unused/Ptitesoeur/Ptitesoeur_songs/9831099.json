  "lyrics": [
    {
      "section_id": "section_1",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Sœur leitmotiv pas d'motiv', langue des oiseaux me rend émotive",
          "rhyme": "iv",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "T'entends l'info, deux mobiles, dix bigos dans l'mille",
          "rhyme": "ij",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Pas d'libido, immobile dans l'build",
          "rhyme": "Old",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Ça s'agite dans l'building, j'rigole depuis \"BUILDING7႓\"",
          "rhyme": "iN",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Toi tu viens pas, t'es puni d'set",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Bi', j'pull up 'vec un pull d'incel",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Poser veut rec mais y a plus d'insert",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Merci Internet, merci VeryLeak's",
          "rhyme": "ins",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Dans l'écran, les chiennes c'est des virilistes",
          "rhyme": "ist",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Face aux nobodys pélo, fléchis, fils",
          "rhyme": "is",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'guette le précipice commе un fétichiste",
          "rhyme": "ist",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "J'reçois comme BINAH, GEVURAH (HOD, MALKHUT)",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Production binauralе, le faire comme nous c'est immoral",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "On fait notre cash, c'est with nobody",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Eux, frère, c'est pas des partenaires, à quoi bon en tenir une équipe ?",
          "rhyme": "ip",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "(Tes bish finiront par te faire)",
          "rhyme": null,
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCDEFGHIJIKLMNO",
      "rhyme_vowel": "AABACCCAAAADDAAE"
    },
    {
      "section_id": "section_2",
      "type": "pont",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "C'-C'est Sœur, dernière pièce avant la suite, avant la nou-nouvelle économie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Les anciens commencent à être un peu trop sur la beuteu des nes-jeu, mais on va pas s'laisser faire",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Maintenant assieds-toi et observe-moi gravir les marches",
          "rhyme": "aRS",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABC",
      "rhyme_vowel": "ABC"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Faut une imprimante 3D sortie des talles de Distro",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Des .STL à DL pour un gars qui diss trop",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'creuse un trou à la pelle, j'fais la place pour dix corps",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "On fait l'taf de trois labels en appel sur Discord",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Il est parti 'vec mes barz bish, ramène ça là",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Jeune terroriste pas comme Rosh HaMemshala",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Il a croisé mes grands, il s'est fait racketter",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "*** aka jeune Sephira Keter",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Il tombe en chopant les talles, back to CP1",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Sur scène c'est pas vraiment nous, c'est d'la CGI",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'guette là où y a la merde, c'est sûr faut qu'j'y aille",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Sur scène c'est pas vraiment nous, c'est d'la CGI",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "J'guette là où y a la merde, c'est sûr faut qu'j'y aille",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABBCCDDEFGFG",
      "rhyme_vowel": "AABBCCDDEFCFC"
    },
    {
      "section_id": "section_4",
      "type": "outro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Co-mment le monde- fe-Comment le monde va-t-il prendre fin ?",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "DANGER, DANGER, DANGER",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Quand cela arrivera-t-il ?",
          "rhyme": "il",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Pourrez-vous survivre ?",
          "rhyme": "ivR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "À quoi le monde ressemblera-t-il ?",
          "rhyme": "il",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCDC",
