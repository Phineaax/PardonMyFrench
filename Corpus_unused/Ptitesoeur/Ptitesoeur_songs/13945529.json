  "lyrics": [
    {
      "section_id": "section_1",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'ai fait des bails là, y a des barrières dans ma tête",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'm'éloigne d'l'époque où j'claquais tout dans la plaquette",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Poseur range ta capette, j'me voyais shoot dans la cafète",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'prépare la zumba cafew, on r'compte les crimes qu'on n'a pas faits",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J’pull up [pour?] le holy bastard avec [?] et des gardes",
          "rhyme": "aRd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Tit-pe j'étais en avance, j'croyais pas en la fée des dents",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "L’collègue qu'aller au trois tours, il s'faisait mêler pour quatre cents balles",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "[?] il s'est fait péter le minou",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "[?] c'est mon destin",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "C'bâtard m'a traitée d'pédale j'lui f'sais qu'un dessin",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'pense, j'pense qu'à comment m'faire quatre cents balles dans le caisson",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "J’fais comme ça car personne m'ramène jamais à la raison",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Bâtard pète le caisson",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "[C’est pas il crève] on fait quoi ? on lui coupe le réseau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Aime-moi",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Bâtard j'ai la haine moi",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "J'oublie pas l'époque où j'me taillais pour les fins d'mois",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "MNG entre tes deux jambes",
          "rhyme": "#b",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "J'ai fait la croix sur tant d'ces gens",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "A la base [j'réside dans les chansons?]",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Pour combler le vide dans le ventre",
          "rhyme": "#tR",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AAABCDEFGGHHHIJJJKDHL",
      "rhyme_vowel": "AAAABCBDEEFFFGBBBCCFC"
    },
    {
      "section_id": "section_2",
      "type": "pont",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Un, deux, trois, quatre",
          "rhyme": "atR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'consomme pour pas pister ma race",
          "rhyme": "as",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "On imprime en f'sant serrer tes gosses",
          "rhyme": "Os",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Une fois qu'j'ai fini d'compter l'cash",
          "rhyme": "aS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Avec le plug on fait les gossips",
          "rhyme": "ip",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'ai fait l'tour du monde dans ma cage",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'ai fait l'tour du monde dans ma chair",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "100k la piaule c'est une belle épave",
          "rhyme": "av",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'suis partie loot, j'ai clear l’étage",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCDEFGHF",
