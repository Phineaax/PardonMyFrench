      "lines": [
        {
          "n": "0",
          "text": "Parce qu'ils m'aiment",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Loin du monde plastique",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'ai levé les yeux, c'était fantastique",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'remercie l'univers pour les douleurs tant qu'elles sont surmontables",
          "rhyme": "abl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Maintenant c'est à nous d'nous battre pour laisser personne sur le tas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Jump, jump, jump, jump, jump, jump, jump, jump, jump, jump, jump, jump",
          "rhyme": "(p",
