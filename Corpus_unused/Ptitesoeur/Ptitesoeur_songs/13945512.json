        },
        {
          "n": "6",
          "text": "J'ai mis mes deux piеds sur toutes les tables",
          "rhyme": "abl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "J'consommais même si c'tait létal ma gueule",
          "rhyme": "9l",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Paypal ma gueule, fais-moi un Paypal ma gueule",
          "rhyme": "9l",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Demain ça t'régale mais today ça ne te paye pas ma gueule",
          "rhyme": "9l",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "T'étais venu jusqu'à la porte et tu t'es quand même fait ti-sor",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
