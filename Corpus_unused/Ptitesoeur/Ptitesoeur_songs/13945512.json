    {
      "section_id": "section_5",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "La-la bish est en plein d'dans ça m'passe au-dessus de la head",
          "rhyme": "Ed",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'fais ma merde à plein temps que j'ai le seum ou la haine",
          "rhyme": "En",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'avais mal de partout elle s'étonnait que je bark",
          "rhyme": "aRk",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Il m'en voulait qu'on l'embarque",
          "rhyme": "aRk",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'étais juste reniée dans le parc",
          "rhyme": "aRk",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Y a qui qui m'a pas trahie à part Bobby et la maille ?",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "T'sais gamine j'ai consommé le produit qui niquait l'émail",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Ma bish dépense comme si ça m'aidait à traverser la faille",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'regarde Blizzard premier degré j'sais qu'ils ne feront pas la taille",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "J'fais rentrer les bagatelles, on s'amuse comme au Bagatelle",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "On va pas pop au bal à thème",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Oh oui quand je bara' t'aimes ça",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "On communique comme au kem's",
          "rhyme": "ins",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Avec le M sur le thème",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "J't'ai fait mettre le nez dans ta merde et j'm'étonne que la merde en sort",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        }
