    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'deviens comme sur la PDP",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'gamberge la mâchoire acérée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "C'est nous les nouveaux gwer tendance on reste tant qu'ça les f'ra serrer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "L'addiction m'faisais vomir j'consommais l'médoc qui rend malade",
          "rhyme": "ad",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'ai pris l'problème à l'envers, j'voulais changer l'monde avant ma life",
          "rhyme": "ajf",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Mon frère est en vie god bless j'espère jamais l'dire à l'imparfait",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Y a des trucs on est les premiers humains sur terre à l'avoir fait",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Tous ces bâtards mettent la lumière sur ma gueule j'fais que d'éteindre",
          "rhyme": ")dR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'suis partie d'en bas j'ai compris qu'à la surface c'est que des timps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Au rez-de-chaussée c'est que des timps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Premier étage c'est que des timps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Deuxième étage c'est que des timps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Même sur le toit y a que des timps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "En 2K18 jamais pimpant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "J'avais qu'Sybyr dans mes tympans",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Soeur t'as mal mais qu'est ce que t'entends ?",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "S'faire la malle souvent qu'c'est tentant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Bouge tu connais pas la sentence",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "Tu parles trop t'as pas l'ascendant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "On a dormi pendant tant d'temps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "J'fais la même chose en attendant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "D'faire rentrer deux fois ton crédit",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "Nouveau plav' et c'bâton s'raidit",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Chez nous l'égo trip c'est la vraie vie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "Tel est l'malheur qu'on a prédit",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        }
      ],
