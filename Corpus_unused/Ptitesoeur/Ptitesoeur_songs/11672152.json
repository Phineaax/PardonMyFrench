        },
        {
          "n": "1",
          "text": "Tu vas finir sans rick au hebs",
          "rhyme": "Eps",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Pour mon histoire faut dix novels, il m'faut 100k pas d'prix Nobel",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'cook un plan 'vec la zine au tel'",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'pull up en drip d'Hazbin Hotel",
