        },
        {
          "n": "6",
          "text": "Elle copie c'est une salope elle",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "B, moi j'veux ma paye j'me tire les cheveux d'vant l'écran bleu",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'ai craché tout la veille dans 4 SWEAR et du Le Grand Bleu",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Ta carrière dans un lucky block",
          "rhyme": "Ok",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "3g puis j'rеc les yeux qui bloquent",
          "rhyme": "Ok",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Toi t'as dеs r'mords t'as pas un glock",
          "rhyme": "Ok",
          "persona_id": "Ptite_soeur"
        },
        {
