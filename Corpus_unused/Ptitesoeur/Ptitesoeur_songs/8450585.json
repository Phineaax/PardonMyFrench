        {
          "n": "0",
          "text": "FTX, compte les X, joue aux chiffres comme algorix",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "B on fait un stack, Lil hoe on dépense on prend v'la les bricks",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Chu comme un UFO dans L'NOI bitch c'est pas Malcolm X",
          "rhyme": "iks",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Bitch on vit l'histoire tu peux dig c'est profond comme 1000 comics",
