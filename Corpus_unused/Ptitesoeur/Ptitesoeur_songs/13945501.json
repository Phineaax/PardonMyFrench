        },
        {
          "n": "1",
          "text": "Hum hum, hum hum, hum hum",
          "rhyme": "9m",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AA",
      "rhyme_vowel": "AA"
    },
    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Hein, j'recompte tout ce qu'on n'a pas fait",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Ma zaza fait l'inverse du café",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "C'est pas une tête lui c'est un gaffeur",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "On va l'faire taire avec le gaffer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'ai recyclé la moitié d'mes rimes, deux fois",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Tit-pe j'doomais, B j'faisais jamais les devoirs",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'fixe le soleil, il s'met à pleuvoir",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Tu vis pour les cams, moi j'peux plus m'voir",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "T'es une pute, for real",
          "rhyme": "il",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "J'veux pas d'une p'tite foreign",
          "rhyme": "ajn",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'veux un mat'las d'papier",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Pendant mes rêvеs, jamais loin des hommes",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Ta condition me désolе",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "C'buzz au sommet c'est pour péter l'sol",
          "rhyme": "Ol",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "C'est la bac ou la PETA",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Ouais j'me suis ficha pour ces belles sommes",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Toi tu t'es ficha pour les belles formes",
          "rhyme": "ORm",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "La gloire et l'succès ça t'fait bander",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "Faudrait t'ligoter les yeux bandés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "T'es une hoe d'Genève à la Vendée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Toi tu nous compares à des vendus",
          "rhyme": "y",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "MNG s'est toujours pas rendu, compte",
          "rhyme": "$t",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "D'à quel point c'est un jeu d'fils de pute",
          "rhyme": "yt",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCBDEEEFGBHIJDHKBBBLMN",
      "rhyme_vowel": "ABCBDDDDEDBFGFDFFBBBHGH"
    },
    {
      "section_id": "section_3",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'sentais le frisson sur la Bassline",
          "rhyme": "in",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'avais tout gâcher d'puis a long time",
          "rhyme": "ajm",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu m'as même blessée sur la sideline",
          "rhyme": "in",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Je vide mon sang je call la hotline",
          "rhyme": "ajn",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "La vue d'mon sang c'est pas l'paradise",
          "rhyme": "iz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Realeyes, realise, reallies",
          "rhyme": "ij",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "La vue d'mon sang c'est pas l'paradise",
          "rhyme": "iz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Realeyes, realise, reallies",
          "rhyme": "ij",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABACDEDE",
      "rhyme_vowel": "ABABAAAA"
    },
    {
      "section_id": "section_4",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Ta spirale c'est une boucle",
          "rhyme": "ukl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Ma pyramide elle bouge",
          "rhyme": "uZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "La paix m'a mis dans l'red",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Ouais la paie m'a mis dans l'rouge",
          "rhyme": "uZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'me réveille puis j'pars me coucher",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Avant qu'tu hate on t'a vu loucher",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Y a encore deux ans j'étais fauchée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Lâche ta fierté j'te rends ton hochet",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Pendant la rave ta tête a hoché",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Ok bon revenons-en aux faits",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "L'opportunisme a peut-être trop fait",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "De quoi sacrifier pour son trophée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Bâtard tu crois j'l'ai pas vu v'nir",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Sans ça B y avait pas d'av'nir",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Quelque cash tu donc sous tes habits",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "T'as beau faire crari qu'on est amis",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCBCCCDCDDCEEFF",
      "rhyme_vowel": "AABABBBCBCCBDDDD"
    },
    {
      "section_id": "section_5",
      "type": "pont",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "MNG 2k25 2k26, let's go ça recommence",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "On l'fait à deux ou sans les autres",
          "rhyme": "otR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Entre nous y a pas de romance",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'fume la W, j'rec' sans l'écrire",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Bitch ça tu l'as d'jà eu hier",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "On a baisé l'histoire dans l'ombre",
          "rhyme": "$bR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Maint'nant ça veut mettre la lumière (lumière, lumière)",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "J'ai trop prié pour un monde meilleur",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABACDEDF",
