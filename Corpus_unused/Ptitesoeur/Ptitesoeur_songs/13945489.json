  "lyrics": [
    {
      "section_id": "section_1",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "MNG, on fait le hold-up (Blizzard)",
          "rhyme": "9p",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Ils checkent les skills, ils nous croient older",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "C'est l'être nouveau comme le horla",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "On skip les niveaux comme le hors-la-loi",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'fais d'la merde par ci et du cash par là",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Fais pas belek à ma te-por si tu passes par là",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "T'as qu'un dixième du talent, vingt fois mon tos-ma, bish",
          "rhyme": "iS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Faut d'la place dans ma valise avant qu'on toss la bitch",
          "rhyme": "itS",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCCCCDE",
      "rhyme_vowel": "ABCCCCDD"
    },
    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Bouge ou ça va t'étrangler avec le lacet du pants, bâtard",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Avant y avait que deux meubles au H donc faut le cash de Cascada",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "XX MER, cabote, il veut toujours mon crâne planté dans le ben",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Tant qu'il a les mains prises, j'vais lui frapper les gosses pendant le bench",
          "rhyme": "EnS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Le trip c'est pas la plage",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Ta passion c'est le plagiat",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Un platane dans une Dacia",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "C'bâtard veut m'ficha comme Assya",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'écartais mes plaies d'vant le paycheck",
          "rhyme": "Ek",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "J'encaisse à la hauteur d'mes péchés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "T'es un poseur, ça va te dresser",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Pute sors ses veines, ça va les tresser",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Pour la lame y a pas de dresscode",
          "rhyme": "Od",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Y a pas nos presets dans le preskit",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "J'pull up 'vec Blizzard en après-ski",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Gaspiller le cash, ça on apprécie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "T'écris un bail, il est pas précis",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "T'as pas percé car t'es pas précis",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "J'avais comme d'jà la corde au cou",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "J'lai retirée, guette-moi m'engraisser",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Des cœurs, ma gueule, j'vais pas t'en greffer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "C'bâtard bande sur mes griffes",
          "rhyme": "if",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "J'marque mes deux points dans la grille",
          "rhyme": "ij",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "J'allume un 3-5 et j'le grille vite",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "J'me lève la tête est livide",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "25",
          "text": "Tu veux pas d'ces peurs, okay, leave it",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "26",
          "text": "On s'fait du mal pour check les limites",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "27",
          "text": "J'les guette de haut comme si je lévite",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        }
      ],
