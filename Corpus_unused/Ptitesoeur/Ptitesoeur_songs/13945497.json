        },
        {
          "n": "1",
          "text": "Le guala m'a fait vriller",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Sur le toit là j'devais briller",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Toi c'que tu cook ça sent le brûlé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Dieu merci je n'suis pas broliquée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Envie d'meurtre, je n'suis pas policier",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'cons' tellement j'sors même plus de chez moi",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "On les baise j'vais pas t'faire un schéma",
