    },
    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'voulais l'péter si j'avais pas d'vida",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Bloquée d'vant l'PC y avait pas d'vida",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu deales 'vec Baphomet pour la vida",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'tabasse 3 cannettes et j'fais la vida",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Ça va t'faire fermer ta gueule comme lui?",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Balai dans l'cul du percussionniste",
          "rhyme": "ist",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'tape ma gnôle dans une boisson d'sioniste",
          "rhyme": "ist",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Quand y a pas d'zob à graille t'es paumé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Y avait pas grand monde pour m'épauler",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "MNG entre les deux pôles",
          "rhyme": "ol",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'vois ces bâtards sous pression comme ça",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "J'tiens le monde entre mes deux paumes",
          "rhyme": "om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "MNG t'a bien baisé pas vrai ?",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Tu t'es fait niquer par les prods",
          "rhyme": "ud",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "La Terre est plate, la Terre est creuse",
          "rhyme": "2z",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "J'suis télépathe pour ces lépreux",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "J'allume une tête et j'fais un vœu",
          "rhyme": "y",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "L'animal chef et l'humain beugle",
          "rhyme": "2gl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "Faire comme nous jamais ils s'le permettent",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "Tu peux recracher tout ce sperme",
          "rhyme": "ERm",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Rien n'se transforme tout se perd",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "Rien n'se transforme tout se perd",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "Blizzard transforme tout ce beurre",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Pour en faire bien plus de billets",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        }
