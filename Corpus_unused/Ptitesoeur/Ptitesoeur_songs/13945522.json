  "lyrics": [
    {
      "section_id": "section_1",
      "type": "intro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Il m'a parlé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J’voulais m'faire du mal, mon corps m'a pas préparée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J’re-décris la scène d'la petite sur le parquet",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'avais l'air si douce, les condés m'ont pas plaquée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABA",
      "rhyme_vowel": "AABA"
    },
    {
      "section_id": "section_2",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Les p'tits toussent, ma fumée dans l'bavoir",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "On d'vait tout baiser juste pour savoir",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu fais des tweets quand t’es pas content",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Moi quand j’ouvre ma gueule ça fait l'montant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "On a compris l’jeu ça fait longtemps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'meurs pour l'dièse qui m'a rendue avare",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J’voulais pas l'psy j'étais pas bavard",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "MNG toujours à la Havane",
          "rhyme": "an",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'incruste des diamants dans ma cabane",
          "rhyme": "an",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABBBAACC",
      "rhyme_vowel": "AABBBAAAA"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'avais pas d'swag quand j'devais cavale",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'pense à m'faire souffrir quand je pavanne",
          "rhyme": "an",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Ce monde est moche il faut qu'on l'avale",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "La structure veut m'baiser sans me faire de lavage",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'aime rock le Dolce & Gabbana",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "T'es lock maintenant t'es pas mon gars",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Et au fond y a rien qui a changé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "J'nous voyais unis comme la Pangée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABACDDEE",
      "rhyme_vowel": "AAAAAABB"
    },
    {
