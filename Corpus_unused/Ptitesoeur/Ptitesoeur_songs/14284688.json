    {
      "section_id": "section_10",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Même au bord de la playa, j'rêvais d'une autre vie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Dieu regarde le monde comme si c'était notre fils",
          "rhyme": "is",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Pour supporter ce monde, j'ai pas la notice",
          "rhyme": "is",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "T'applaudis quand je vais mal, comme si t'étais pas fautif",
          "rhyme": "if",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'aime pas la fame, j'aime pas les notifs",
          "rhyme": "if",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'aime rendre l'amour, j'aime quand ils sont émotifs",
          "rhyme": "if",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'ai tout donné de moi, ils en veulent encore",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "J'ai mis des coup de tête d'dans, elle a pas cédé la porte",
          "rhyme": "ORt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Le dernier qui ma dit que ça ira : il m'a vi- (on crée)",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "J'ai sacrifié toute ma vie, pour le vide et voilà",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'avais l'espoir à 7 piges, après je l'ai voilé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Souvent je fermais les yeux sous le ciel étoilé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Comme je t'aime, Neo pour ramener la couleur",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Ils peuvent pas capturer ma voix dans le polar",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Tous les jours, j'gamberge du bureau comme un taulard",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "(Rien me sauve d'la pain, même pas des dizaines de milliers de d-)",
          "rhyme": null,
          "persona_id": "Ptite_soeur"
        }
      ],
