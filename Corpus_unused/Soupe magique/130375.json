      "lines": [
        {
          "n": "0",
          "text": "When you're alone, thoughts start coming in",
          "rhyme": "in",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "1",
          "text": "Punching in that dark lock box and they start rummaging",
          "rhyme": "iN",
