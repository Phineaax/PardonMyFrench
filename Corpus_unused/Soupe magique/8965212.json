      "lines": [
        {
          "n": "0",
          "text": "Okay, cool",
          "rhyme": "ul",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "1",
          "text": "And like that",
          "rhyme": "a",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "2",
          "text": "We really mean it this time",
          "rhyme": "ajm",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "3",
          "text": "I guarantee another era is upon us",
          "rhyme": "ys",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "4",
          "text": "So once again, we gone",
          "rhyme": "on",
          "persona_id": "persona_tyler_baudelaire"
        }
      ],
