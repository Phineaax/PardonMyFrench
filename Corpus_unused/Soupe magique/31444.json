    },
    {
      "section_id": "section_3",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "It's like limbo, how low can you go?",
          "rhyme": "o",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "1",
          "text": "V go lower than your bimbo panty-ho",
          "rhyme": "o",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "2",
          "text": "Damn yo, I say that's pretty damn low",
          "rhyme": "o",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "3",
          "text": "In the city streets with more ammo than Rambo",
          "rhyme": "o",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "4",
          "text": "\"Hambo\" – y'all don't want V in it",
          "rhyme": "it",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "5",
          "text": "Make the coolest cat piss his Coogi in a minute",
          "rhyme": "yt",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "6",
          "text": "When he blow and get ballin' at the top slot",
          "rhyme": "o",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "7",
          "text": "20 G's a head for whoever calling cop shot",
          "rhyme": "o",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "8",
          "text": "Kack, kack, kack, kack, kack — popsnot",
          "rhyme": "o",
          "persona_id": "Viktor_Vaughn"
        }
      ],
      "rhyme": "AAAABCAAA",
      "rhyme_vowel": "AAAABCAAA"
    },
