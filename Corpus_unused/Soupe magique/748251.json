          "persona_id": "persona_chur_bum"
        },
        {
          "n": "7",
          "text": "When you rub my hands switching fifth gear (Wait)",
          "rhyme": "ER",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "8",
          "text": "Forget about it, baby, let's not waste our afternoon (Forget about it, baby)",
          "rhyme": "un",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "9",
          "text": "'Cause we're gonna go fly to the moon (We're gonna go flyin' to the moon)",
