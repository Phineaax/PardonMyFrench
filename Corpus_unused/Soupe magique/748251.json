      "lines": [
        {
          "n": "0",
          "text": "Let's move to California right now",
          "rhyme": "o",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "1",
          "text": "(Pack your bags, go pack your bags)",
          "rhyme": null,
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "2",
          "text": "I have wings on my back, so we don't",
          "rhyme": "#",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "3",
          "text": "(Take the plane, have to take the plane)",
          "rhyme": null,
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "4",
          "text": "Girl, I know you ready, I can see it in your eyes",
          "rhyme": "Ej",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "5",
          "text": "Boy, I know you're not, I can tell you're terrified",
          "rhyme": "e",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "6",
          "text": "Oh, nobody has to know and if they did, they wouldn't care",
