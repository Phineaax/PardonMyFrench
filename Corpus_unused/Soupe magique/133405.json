    },
    {
      "section_id": "section_1",
      "type": "skit",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "\"Sam, the music sounds good, man! You've been practicing!\"",
          "rhyme": "iN",
          "persona_id": "persona_dr_tc"
        },
        {
          "n": "1",
          "text": "\"Thanks\"",
          "rhyme": "#k",
          "persona_id": "persona_sam"
        },
        {
          "n": "2",
          "text": "\"Sam, this is Wolf",
          "rhyme": "Olf",
          "persona_id": "persona_dr_tc"
        },
        {
          "n": "3",
          "text": "He's new here\"",
          "rhyme": "eR",
          "persona_id": "persona_dr_tc"
        },
        {
          "n": "4",
          "text": "\"What's up, dude?\"",
          "rhyme": "yd",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "5",
          "text": "\"Wolf, this is Sam",
          "rhyme": "im",
          "persona_id": "persona_dr_tc"
        },
        {
          "n": "6",
          "text": "Sam and his band have been here at Flog Gnaw for a while",
          "rhyme": "il",
          "persona_id": "persona_dr_tc"
        },
        {
          "n": "7",
          "text": "Sam's gonna show you around while I fill out these last minute field trip slips, alright?",
          "rhyme": "ajt",
          "persona_id": "persona_dr_tc"
        },
        {
          "n": "8",
          "text": "Now you guys have fun\"",
          "rhyme": "yn",
          "persona_id": "persona_dr_tc"
        },
        {
          "n": "9",
          "text": "\"So, you guys are into jazz?\"",
          "rhyme": "az",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "10",
          "text": "\"Look",
          "rhyme": "uk",
          "persona_id": "persona_sam"
        },
        {
          "n": "11",
          "text": "Wolf, Prairie Dog, Ronzell—whatever the fuck your name is",
          "rhyme": "E",
          "persona_id": "persona_sam"
        },
        {
          "n": "12",
          "text": "We don't fuck with you or anybody else here, alright? You stay the fuck out of our way and we'll stay out of yours, capisce?\"",
          "rhyme": "is",
          "persona_id": "persona_sam"
        }
      ],
      "rhyme": "ABCDEFGHIJKLM",
      "rhyme_vowel": "ABCDEAAFEFGHA"
    }
