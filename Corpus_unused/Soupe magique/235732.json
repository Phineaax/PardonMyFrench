      "lines": [
        {
          "n": "0",
          "text": "New-hoo, ooh-hoo, new-hoo, ooh-hoo",
          "persona_id": "eminem"
        },
        {
          "n": "1",
          "text": "New-hoo, ooh-hoo, well, that's nothin'",
          "persona_id": "eminem"
        },
        {
          "n": "2",
          "text": "New-hoo, ooh-hoo, new-hoo, ooh-hoo",
          "persona_id": "eminem"
        },
        {
          "n": "3",
          "text": "New-hoo, ooh-hoo, new-hoo, ooh-hoo",
          "persona_id": "eminem"
