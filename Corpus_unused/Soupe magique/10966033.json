      "lines": [
        {
          "n": "0",
          "text": "Well, I'd like to mention a couple of joints off the FOOD album",
          "rhyme": "Om",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "1",
          "text": "Oh, yeah, oh, yeah, of course, my fault, I'm bugging up, yeah",
          "rhyme": "E",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "2",
