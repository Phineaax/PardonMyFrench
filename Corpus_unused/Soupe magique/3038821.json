        },
        {
          "n": "13",
          "text": "Rappers need to fall off just to save me the trouble. yo",
          "rhyme": "o",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "14",
          "text": "Watch your own back.  Came in and go out alone, black",
