    {
      "section_id": "section_2",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I wrote this one in B.C.D.C. O-section",
          "rhyme": "$",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "1",
          "text": "If you don’t believe me, go get bagged and check then",
