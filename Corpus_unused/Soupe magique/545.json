      "lines": [
        {
          "n": "0",
          "text": "Yeah, to my babies",
          "persona_id": "eminem"
        },
        {
          "n": "1",
          "text": "Stay strong",
          "persona_id": "eminem"
        },
        {
          "n": "2",
          "text": "Dad'll be home soon",
          "persona_id": "eminem"
        },
        {
          "n": "3",
          "text": "And to the rest of the world",
          "persona_id": "eminem"
        },
        {
          "n": "4",
          "text": "God gave you those shoes",
          "persona_id": "eminem"
        },
        {
          "n": "5",
          "text": "To fit you",
          "persona_id": "eminem"
        },
