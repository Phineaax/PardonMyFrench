<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="song_0001" xml:lang="fr">

  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title type="main">Titre de la chanson</title>
        <respStmt>
          <resp>Transcription et annotation</resp>
          <persName xml:id="ann_1">Annotateur·rice 1</persName>
        </respStmt>
      </titleStmt>
      <publicationStmt>
        <p>Corpus de stylométrie d'artistes musicaux, version 0.1</p>
      </publicationStmt>

      <!-- Objet de publication : single / album / EP, etc. -->
      <sourceDesc>
        <biblStruct xml:id="rel_0001">
          <analytic>
            <title level="a">Titre de la chanson</title>
            <author ref="#art_01">Artiste principal</author>
            <idno type="ISRC">FRXXX0000000</idno>
          </analytic>
          <monogr>
            <title level="m">Titre de l'album</title>
            <!-- type contrôlé : single | album | ep | mixtape | compilation | live | soundtrack -->
            <note type="release_type">album</note>
            <idno type="MusicBrainz">mbid-à-compléter</idno>
            <imprint>
              <publisher>Label</publisher>
              <date type="release" when="2019-05-17">17 mai 2019</date>
              <!-- date de première publication du titre (peut différer, ex. single avant album) -->
              <date type="first_publication" when="2019-03">mars 2019</date>
            </imprint>
          </monogr>
          <series>
            <title>Numéro de piste</title>
            <biblScope unit="track">3</biblScope>
          </series>
        </biblStruct>
        <!-- Provenance du texte des paroles -->
        <bibl type="lyrics_source">
          <ptr target="https://exemple.org/paroles"/>
          <date type="retrieved" when="2026-10-14"/>
          <note>Transcription vérifiée à l'écoute ; élisions conservées, casse normalisée.</note>
        </bibl>
      </sourceDesc>
    </fileDesc>

    <encodingDesc>
      <editorialDecl>
        <normalization>
          <p>Ponctuation conservée telle quelle. Répétitions du refrain dupliquées explicitement.</p>
        </normalization>
      </editorialDecl>
      <metDecl type="met" pattern="syll" xml:id="metDecl_fr">
        <p>Décompte syllabique : e muet compté devant consonne, élidé devant voyelle
           et en fin de vers ; diérèse et synérèse notées dans @real.</p>
      </metDecl>
      <metDecl type="rhyme" xml:id="rhymeDecl_fr">
        <p>Rimes étiquetées par lettre au niveau de la strophe (@rhyme) et par
           élément &lt;rhyme&gt; au niveau du vers ; genre et richesse dans @type.</p>
      </metDecl>
    </encodingDesc>

    <profileDesc>
      <langUsage>
        <language ident="fr">Français (rap)</language>
      </langUsage>

      <!-- Artistes, auteur·rices et personas -->
      <particDesc>
        <listPerson>
          <person xml:id="art_01" role="main_artist writer">
            <persName type="stage">Nom de scène</persName>
            <persName type="birth">Nom civil</persName>
            <idno type="Wikidata">Qxxxx</idno>
            <idno type="MusicBrainz">mbid-à-compléter</idno>
          </person>
          <person xml:id="art_02" role="featured">
            <persName>Artiste invité·e</persName>
          </person>
        </listPerson>

        <listPerson type="personas">
          <person xml:id="pers_01">
            <persName type="persona">Alter ego</persName>
            <state type="persona" from="2018">
              <label>alter_ego</label>
              <desc>Description de la construction artistique (ton, thèmes, posture).</desc>
            </state>
          </person>
        </listPerson>

        <listRelation>
          <relation name="persona_of" active="#pers_01" passive="#art_01"/>
        </listRelation>
      </particDesc>

      <!-- Annotation de persona au niveau de la chanson, avec confiance et responsable -->
      <textClass>
        <keywords scheme="#persona_scheme">
          <term ref="#pers_01" cert="high" resp="#ann_1"/>
        </keywords>
      </textClass>
    </profileDesc>

    <revisionDesc>
      <change when="2026-10-14" who="#ann_1">Création du fichier</change>
    </revisionDesc>
  </teiHeader>

  <text>
    <body>
      <div type="song">

        <!-- Couplet 1 : quatrain en rimes croisées, chanté par l'artiste principal -->
        <sp who="#art_01">
          <lg type="verse" n="1" rhyme="abab" met="12" xml:id="s1">
            <l n="1" real="12" met="12">
              Premier vers du <seg type="rhyme_word"><rhyme label="a" type="feminine_sufficient">texte</rhyme></seg>
            </l>
            <l n="2" real="12">
              Deuxième vers du <rhyme label="b" type="masculine_rich">texte</rhyme>
            </l>
            <l n="3" real="13">
              Troisième vers du <rhyme label="a" type="feminine_sufficient">texte</rhyme>
            </l>
            <l n="4" real="12">
              Quatrième vers du <rhyme label="b" type="masculine_rich">texte</rhyme>
            </l>
          </lg>
        </sp>

        <!-- Refrain -->
        <lg type="chorus" n="1" xml:id="s2" rhyme="aa">
          <l n="1">Vers du refrain<rhyme label="a">un</rhyme></l>
          <l n="2">Autre vers du refrain<rhyme label="a">un</rhyme></l>
        </lg>

        <!-- Couplet 2 : invité·e, avec rime interne et ad-lib -->
        <sp who="#art_02">
          <lg type="verse" n="2" rhyme="abab" xml:id="s3">
            <l n="1">Vers avec <rhyme label="x" type="internal">rime</rhyme> interne
              <seg type="adlib">(yeah)</seg></l>
            <l n="2">…</l>
            <l n="3">…</l>
            <l n="4">…</l>
          </lg>
        </sp>

      </div>
    </body>
  </text>

  <!-- Annotations dérivées en standoff : le texte reste la source de vérité -->
  <standOff>
    <annotation type="linguistic" resp="#ann_1" source="spaCy fr_core_news_lg">
      <spanGrp type="lemma">
        <span from="#s1" to="#s1">lemmes calculés, à relier aux mots</span>
      </spanGrp>
    </annotation>
  </standOff>
</TEI>