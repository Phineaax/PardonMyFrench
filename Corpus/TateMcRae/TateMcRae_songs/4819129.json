{"song_id": 4819129, "title": "tear myself apart", "language": "en", "lyricists": [615565, 632564, 615550], "lyrics": [{"section_id": "section_0", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "So it goes, my summer rose", "persona_id": "persona_tate_baseline"}, {"n": "1", "text": "Is cut and thrown away", "persona_id": "persona_tate_baseline"}, {"n": "2", "text": "Petals fall and you don't call", "persona_id": "persona_tate_baseline"}, {"n": "3", "text": "For\u2005days\u2005and days and\u2005days", "persona_id": "persona_tate_baseline"}]}, {"section_id": "section_1", "type": "pre-chorus", "performer": "", "lines": [{"n": "0", "text": "You say, you say it's not\u2005my fault", "persona_id": "persona_tate_baseline"}, {"n": "1", "text": "You say nothing at all", "persona_id": "persona_tate_baseline"}]}, {"section_id": "section_2", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "Can you see my hands shake?", "persona_id": "persona_tate_baseline"}, {"n": "1", "text": "Heart is now an earthquake", "persona_id": "persona_tate_baseline"}, {"n": "2", "text": "I'm left alone to tear myself apart", "persona_id": "persona_tate_baseline"}, {"n": "3", "text": "You make it look so easy", "persona_id": "persona_tate_baseline"}, {"n": "4", "text": "Turn around and leave me", "persona_id": "persona_tate_baseline"}, {"n": "5", "text": "I'm left alone to tear myself apart", "persona_id": "persona_tate_baseline"}, {"n": "6", "text": "To tear myself apart", "persona_id": "persona_tate_baseline"}]}, {"section_id": "section_3", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "No concern for what you've burned", "persona_id": "persona_tate_baseline"}, {"n": "1", "text": "You set yourself ablaze", "persona_id": "persona_tate_baseline"}, {"n": "2", "text": "What survives are sharpened knifes", "persona_id": "persona_tate_baseline"}, {"n": "3", "text": "That go right through the bone", "persona_id": "persona_tate_baseline"}]}, {"section_id": "s