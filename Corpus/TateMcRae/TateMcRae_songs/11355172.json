      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Baby blues, undressin' him",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "1",
          "text": "Funny how you think that I don't notice it",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "2",
          "text": "Actin' like we're friends, we're the opposite",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "3",
          "text": "I know what you are, tryin' so hard",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "4",
          "text": "Runnin' 'round tryna fuck a star, go",
          "persona_id": "persona_tatiana"
        }
      ]
    },
    {
      "section_id": "section_2",
      "type": "chorus",
      "performer": "",
      "lines": [
