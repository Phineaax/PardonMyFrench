          "text": "Take home whoever walks in",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "3",
          "text": "Just keep your eyes off him",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "4",
          "text": "Yes, I'm Miss Possessive",
          "persona_id": "persona_tatiana"
        },
