      "lines": [
        {
          "n": "0",
          "text": "Oh, baby, you got ten fingers 'round my neck at all times",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "1",
          "text": "Oh, baby, you think 'bout me ten times more than even your own life",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "2",
          "text": "And I thought nothin' of it 'til I saw you last",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "3",
          "text": "Got your own, but you started eyein' down on my man",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "4",
          "text": "And my clothes, and my plans",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "5",
          "text": "Know you're prayin' on my downfall (Oh yeah)",
          "persona_id": "persona_tatiana"
        }
      ]
