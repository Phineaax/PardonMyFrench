    {
      "section_id": "section_6",
      "type": "bridge",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I know that you hate when I figure you out",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "1",
          "text": "You get so distant just so you can hear a sound",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "2",
          "text": "Swear that you've been gone but yet your body's still around",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "3",
          "text": "What are you doing now?",
          "persona_id": "persona_tate_baseline"
        }
