            "lines": [
                {
                    "n": "0",
                    "text": "Back stage! ..",
                    "rhyme": "aZ",
                    "persona": "Kool Keith"
                },
                {
                    "n": "1",
                    "text": "See girl after the show I'm not to be idolized",
                    "rhyme": "e",
                    "persona": "Kool Keith"
                },
                {
                    "n": "2",
                    "text": "Overwhelmed by a new obsessed fan",
                    "rhyme": "an",
                    "persona": "Kool Keith"
                },
                {
                    "n": "3",
                    "text": "No I don't wanna answer your questions",
                    "rhyme": "$",
                    "persona": "Kool Keith"
                },
                {
                    "n": "4",
                    "text": "Are you some kind of journalist, follow me around?",
                    "rhyme": "awnd",
                    "persona": "Kool Keith"
                },
                {
                    "n": "5",
                    "text": "Come on in the bathroom",
                    "rhyme": "um",
                    "persona": "Kool Keith"
                },
                {
                    "n": "6",
                    "text": "Now you wanna see how Keith acts at home",
                    "rhyme": "om",
                    "persona": "Kool Keith"
                },
                {
                    "n": "7",
                    "text": "Call your girlfriends",
                    "rhyme": "#",
                    "persona": "Kool Keith"
                },
                {
                    "n": "8",
                    "text": "Now you wanna see the way I P-I-S-S",
                    "rhyme": "$",
                    "persona": "Kool Keith"
                },
                {
                    "n": "9",
                    "text": "Beggin me to get a magic marker to sign my name on your back",
                    "rhyme": "ak",
                    "persona": "Kool Keith"
                },
                {
                    "n": "10",
                    "text": "You're very young, and giggly with pre-washed Levi's on",
                    "rhyme": "$",
                    "persona": "Kool Keith"
                },
                {
                    "n": "11",
                    "text": "You don't know how to act - let's party, how about it?",
                    "rhyme": "it",
                    "persona": "Kool Keith"
                },
                {
                    "n": "12",
                    "text": "I don't wanna party drink Bacardi what you think I look like;",
                    "rhyme": "Ejk",
                    "persona": "Kool Keith"
                },
                {
                    "n": "13",
                    "text": "The purple dragon Barney?",
                    "rhyme": "E",
                    "persona": "Kool Keith"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Back stage!  You're excited..  back stage passes!",
                    "rhyme": "as",
                    "persona": "Kool Keith"
                },
                {
                    "n": "1",
                    "text": "You're excited, girls lookin all around",
                    "rhyme": "awnd",
                    "persona": "Kool Keith"
                },
                {
                    "n": "2",
                    "text": "Back stage!  You're excited..  back stage passes!",
                    "rhyme": "as",
                    "persona": "Kool Keith"
                },
                {
                    "n": "3",
                    "text": "You're excited, stop lookin all around",
                    "rhyme": "awnd",
                    "persona": "Kool Keith"
                },
                {
                    "n": "4",
                    "text": "Back stage!  You're excited..",
                    "rhyme": "e",
                    "persona": "Kool Keith"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "kool",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I'm totally attracted to you, but you turn me off as a fan",
                    "rhyme": "an",
                    "persona": "Kool Keith"
                },
                {
                    "n": "1",
                    "text": "Approachin me back stage with a guy that's not your friend",
                    "rhyme": ")d",
                    "persona": "Kool Keith"
                },
                {
                    "n": "2",
                    "text": "Lyin to get a laminate - is that your man?",
                    "rhyme": "#",
                    "persona": "Kool Keith"
                },
                {
                    "n": "3",
                    "text": "Some weird guy starin at me like Peter Pan",
                    "rhyme": "#",
                    "persona": "Kool Keith"
                },
                {
                    "n": "4",
                    "text": "There's no time to talk about how I got started in rap",
                    "rhyme": "ap",
                    "persona": "Kool Keith"
                },
                {
                    "n": "5",
                    "text": "I'm goin straight home",
                    "rhyme": "om",
                    "persona": "Kool Keith"
                },
                {
                    "n": "6",
                    "text": "You don't know, I'ma leave you alone",
                    "rhyme": "On",
                    "persona": "Kool Keith"
                },
                {
                    "n": "7",
                    "text": "Why should I waste my time, get no sleep?",
                    "rhyme": "ip",
                    "persona": "Kool Keith"
                },
                {
                    "n": "8",
                    "text": "I just got off stage, you're still complainin",
                    "rhyme": ")",
                    "persona": "Kool Keith"
                },
                {
                    "n": "9",
                    "text": "You shoulda stayed on stage longer at the New Orleans Superdome",
                    "rhyme": "Om",
                    "persona": "Kool Keith"
                },
                {
                    "n": "10",
                    "text": "What you want from me?  You took my picture;",
                    "rhyme": "yR",
                    "persona": "Kool Keith"
                },
                {
                    "n": "11",
                    "text": "You got my autograph - I'm not tryin to crack any more Coronas",
                    "rhyme": "a",
                    "persona": "Kool Keith"
                },
                {
                    "n": "12",
                    "text": "I hate the smell of beadies",
                    "rhyme": "i",
                    "persona": "Kool Keith"
                },
                {
                    "n": "13",
                    "text": "And you have a bunch of dinky friends, and a adolescent staff",
                    "rhyme": "af",
                    "persona": "Kool Keith"
                },
                {
                    "n": "14",
                    "text": "You are immature",
                    "rhyme": "yR",
                    "persona": "Kool Keith"
                }
            ]
        },
        {
            "section_id": "section_3",
            "type": "chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
