        },
        {
            "section_id": "section_4",
            "type": "kool",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Laugh at yourself, put your whole world on the shelf",
                    "rhyme": "Elf",
                    "persona": "Kool Keith"
                },
                {
                    "n": "1",
                    "text": "Do that stupid stuff with Weird Al Yankovich",
                    "rhyme": "itS",
                    "persona": "Kool Keith"
                },
                {
                    "n": "2",
                    "text": "Go try to figure out somebody else",
                    "rhyme": "yls",
                    "persona": "Kool Keith"
                },
                {
                    "n": "3",
                    "text": "First of all, you're living through my CD",
                    "rhyme": "aR",
                    "persona": "Kool Keith"
                },
                {
                    "n": "4",
                    "text": "Second you don't know me",
                    "rhyme": "@",
                    "persona": "Kool Keith"
                },
                {
                    "n": "5",
                    "text": "Base your life on fan magazines I go shoppin everyday",
                    "rhyme": "E",
                    "persona": "Kool Keith"
                },
                {
                    "n": "6",
                    "text": "When I'm in a small boring city you don't see me",
                    "rhyme": "@",
                    "persona": "Kool Keith"
                },
                {
                    "n": "7",
                    "text": "If I told you I had eighteen hands",
                    "rhyme": "#",
                    "persona": "Kool Keith"
                },
                {
                    "n": "8",
                    "text": "You're so tuned and tweaked out, your ass would believe me",
                    "rhyme": "@",
                    "persona": "Kool Keith"
                }
            ]
        },
