            "lines": [
                {
                    "n": "0",
                    "text": "Chill at home watchin the Mets",
                    "rhyme": "E",
                    "persona": "Kool Keith"
                },
                {
                    "n": "1",
                    "text": "I'ma tell Suge Knight to call Big Kap and Funkmaster Flex",
                    "rhyme": "Eks",
                    "persona": "Kool Keith"
                },
                {
                    "n": "2",
                    "text": "Tony Green is out of jail with a five billion dollar bail",
                    "rhyme": "aj",
                    "persona": "Kool Keith"
                },
                {
                    "n": "3",
                    "text": "I'ma hire two men with machine guns to do retail",
                    "rhyme": "aj",
                    "persona": "Kool Keith"
                },
                {
                    "n": "4",
                    "text": "Independent promotion, a couple of people got they legs broken",
                    "rhyme": "En",
                    "persona": "Kool Keith"
                },
                {
                    "n": "5",
                    "text": "Record exec found dead, body in Hoboken",
                    "rhyme": "En",
                    "persona": "Kool Keith"
                },
                {
                    "n": "6",
                    "text": "Autopsy explainin what parts remainin",
                    "rhyme": ")",
                    "persona": "Kool Keith"
                },
                {
                    "n": "7",
                    "text": "New York police department, the F.B.I",
                    "rhyme": "i",
                    "persona": "Kool Keith"
                },
                {
                    "n": "8",
                    "text": "Said this guy wasn't playin",
                    "rhyme": ")",
                    "persona": "Kool Keith"
                },
                {
                    "n": "9",
                    "text": "Tape around this punk's mouth, what is he sayin?",
                    "rhyme": ")",
                    "persona": "Kool Keith"
                },
                {
                    "n": "10",
                    "text": "Turned the radio up and cut his arms off",
                    "rhyme": "Of",
                    "persona": "Kool Keith"
                },
                {
                    "n": "11",
                    "text": "And throw him off the top of the Waldorf",
                    "rhyme": "ER",
                    "persona": "Kool Keith"
                },
                {
                    "n": "12",
                    "text": "Call Fat Kat in prison",
                    "rhyme": "$",
                    "persona": "Kool Keith"
                },
                {
                    "n": "13",
                    "text": "Tell him his right hand mand already did that",
                    "rhyme": "a",
                    "persona": "Kool Keith"
                },
                {
                    "n": "14",
                    "text": "Ten cars, meet me at the Lincoln Tunnel with stockin cops",
                    "rhyme": "Op",
                    "persona": "Kool Keith"
                },
                {
                    "n": "15",
                    "text": "We're gonna count to the one-oh, put butter on the bun-oh",
                    "rhyme": "o",
                    "persona": "Kool Keith"
                },
                {
                    "n": "16",
                    "text": "Black killed the program director but first let him sniff some blow",
                    "rhyme": "o",
                    "persona": "Kool Keith"
                },
                {
                    "n": "17",
                    "text": "See the man with the suit?",
                    "rhyme": "i",
                    "persona": "Kool Keith"
                },
                {
                    "n": "18",
                    "text": "Light up the kid with the bomber jacket and Timberland boots",
                    "rhyme": "uts",
                    "persona": "Kool Keith"
                },
                {
                    "n": "19",
                    "text": "Comin at you like Tupac in \"Juice\", I'ma get loose",
                    "rhyme": "uz",
                    "persona": "Kool Keith"
                },
                {
                    "n": "20",
                    "text": "Chorus: Kool Keith (repeat 3X)",
                    "rhyme": "it",
                    "persona": "Kool Keith"
                },
                {
                    "n": "21",
                    "text": "We work nine to nine, we never sleep full time..",
                    "rhyme": "ajm",
                    "persona": "Kool Keith"
                },
                {
                    "n": "22",
                    "text": "Diamonds, we bring violence!",
                    "rhyme": "#s",
                    "persona": "Kool Keith"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "kool",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Send a coffin up to Billboard with flowers in the lobby",
                    "rhyme": "i",
                    "persona": "Kool Keith"
                },
                {
                    "n": "1",
                    "text": "A picture of me with Gene Griffin holdin a hand-grenade",
