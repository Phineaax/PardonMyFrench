                    "rhyme": "@",
                    "persona": "Kool Keith"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "hook",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "We sport the Kangols with the flyest clothes",
                    "rhyme": "at",
                    "persona": "Kool Keith"
                },
                {
                    "n": "1",
                    "text": "\"The legendary, the metaphor king with metaphor swing\"",
