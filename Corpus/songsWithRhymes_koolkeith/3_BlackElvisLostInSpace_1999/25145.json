                },
                {
                    "n": "6",
                    "text": "1-800 number, cancel code see to summer",
                    "rhyme": "9R",
                    "persona": "Black Elvis"
                },
                {
                    "n": "7",
                    "text": "Extreme complicated businessman, can't be reached",
                    "rhyme": "Ed",
                    "persona": "Black Elvis"
                },
                {
                    "n": "8",
                    "text": "No type of headquarters, deserted land, by the waters",
