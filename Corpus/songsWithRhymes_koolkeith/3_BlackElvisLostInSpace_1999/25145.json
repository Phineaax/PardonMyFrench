                    "persona": "Black Elvis"
                },
                {
                    "n": "12",
                    "text": "My George Washington robe, I still travel the globe",
                    "rhyme": "Ob",
                    "persona": "Black Elvis"
                },
                {
                    "n": "13",
                    "text": "On Pan-Am airflights, I roll in cities after midnight",
                    "rhyme": "ajt",
                    "persona": "Black Elvis"
                },
                {
                    "n": "14",
                    "text": "Stand in your lobby unsuspected, you get neglected",
                    "rhyme": "e",
