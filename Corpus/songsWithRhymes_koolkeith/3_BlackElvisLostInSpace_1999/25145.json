                },
                {
                    "n": "2",
                    "text": "Here's my number call me direct, get no feedback",
                    "rhyme": "ak",
                    "persona": "Black Elvis"
                },
                {
                    "n": "3",
                    "text": "No interviews, channel four, see me on the news",
                    "rhyme": "uz",
                    "persona": "Black Elvis"
                },
                {
                    "n": "4",
                    "text": "Erase your message walk streets with my cellular phone",
