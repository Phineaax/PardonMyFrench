                },
                {
                    "n": "15",
                    "text": "Traffic was hectic..",
                    "rhyme": "ik",
                    "persona": "Black Elvis"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Order room service, transfer quick to Holiday Inn",
                    "rhyme": "in",
                    "persona": "Black Elvis"
                },
                {
                    "n": "1",
                    "text": "Check out time nine o'clock, coat on, I'm out again",
