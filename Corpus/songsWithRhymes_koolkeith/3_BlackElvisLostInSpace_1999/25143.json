            "lines": [
                {
                    "n": "0",
                    "text": "Back up the turnpike, watch Mad Max turn into you",
                    "rhyme": "u",
                    "persona": "Black Elvis"
                },
                {
                    "n": "1",
                    "text": "Get gassed at truckstops, leave diesel fuel, burnin through you",
