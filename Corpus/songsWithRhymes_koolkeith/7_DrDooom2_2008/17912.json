        },
        {
            "section_id": "section_2",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Now I'm ready for a burnin flavor",
                    "rhyme": "OR",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "1",
                    "text": "Charcoal and a lot of flame to go",
                    "rhyme": "o",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "2",
                    "text": "The way I cook horse I train you though",
                    "rhyme": "O",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "3",
                    "text": "Similar to \"Beatdown,\" beatin chuck meat to the ground",
                    "rhyme": "awnd",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "4",
                    "text": "Graduated the day I stand in produce section with a gap and gown",
                    "rhyme": "awn",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "5",
                    "text": "Fortified Grade A, I stack big steaks in the truck on payday",
                    "rhyme": "E",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "6",
                    "text": "Mice get served to you for lunch on a good tray",
                    "rhyme": "E",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "7",
                    "text": "Y'all come outside and celebrate the gross animal waste",
                    "rhyme": "ast",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "8",
                    "text": "On food day, I watch the bad meat turn gray",
                    "rhyme": "E",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "9",
                    "text": "Professor from high school John Jay",
                    "rhyme": "E",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "10",
                    "text": "Y'all watch the woods for bears missin",
                    "rhyme": ")",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "11",
                    "text": "And see John, Dr. Dooom play",
                    "rhyme": "E",
                    "persona": "Dr. Dooom"
                }
            ]
        },
