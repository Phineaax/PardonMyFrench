{
    "song_id": 17912,
    "title": "Take That Ride",
    "language": "en",
    "lyricists": [
        1692
    ],
    "lyrics": [
        {
            "section_id": "section_0",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Yeah! I saw the sheriff last night",
                    "rhyme": "ajt",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "1",
                    "text": "But I'm about to ride up to the gas station to wash my hands",
                    "rhyme": "#",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "2",
                    "text": "Get up in that girl, stop barkin back",
                    "rhyme": "ak",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "3",
                    "text": "Bring your puppies wit'cha",
                    "rhyme": "a",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "4",
                    "text": "I'm ready for work, the black skully and green t-shirt",
                    "rhyme": "9Rt",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "5",
                    "text": "Press the elevator button, you will get hurt",
                    "rhyme": "uRt",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "6",
                    "text": "Drive up the road with a huge smirk",
                    "rhyme": "aRk",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "7",
                    "text": "Continental Lincoln with suicide doors",
                    "rhyme": "OR",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "8",
                    "text": "With polar bear nails in the floors",
                    "rhyme": "OR",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "9",
                    "text": "Move symbols on the hood, like some place that glow in the dark",
                    "rhyme": "aRk",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "10",
                    "text": "And say it's all good",
                    "rhyme": "ud",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "11",
                    "text": "Collect junk like Sanford, Connecticut",
                    "rhyme": "y",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "12",
                    "text": "I come around the curves in Stamford",
                    "rhyme": "ORd",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "13",
                    "text": "Cut up the straightaway, up to Boston",
                    "rhyme": "On",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "14",
                    "text": "With a beard on my chin like Rick Ross'ton",
                    "rhyme": "$",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "15",
                    "text": "When I hit London I call a Jamaican chick to give me voodoo",
                    "rhyme": "o",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "16",
                    "text": "Rest in peace to thoughts son",
                    "rhyme": "$",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "17",
                    "text": "Hot sauce on your dog",
                    "rhyme": "Og",
                    "persona": "Dr. Dooom"
                },
                {
                    "n": "18",
                    "text": "I cook up in Austin",
                    "rhyme": ")",
                    "persona": "Dr. Dooom"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "chorus",
            "performer": "",
            "lines": [
