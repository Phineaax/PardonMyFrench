    "lyrics": [
        {
            "section_id": "section_1",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "First patient, pull out the skull, remove the cancer",
                    "rhyme": "ER",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "1",
                    "text": "Breaking his back, chisel necks for the answer",
                    "rhyme": "9R",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "2",
                    "text": "Supersonic-bionic-robot-voodoo power",
                    "rhyme": "9R",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "3",
                    "text": "Equator ex my chance to flex skills on Ampex",
                    "rhyme": "Eks",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "4",
                    "text": "With power meters and heaters gauge anti-freeze",
                    "rhyme": "iz",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "5",
                    "text": "Octagon oxygen, aluminum intoxicants",
                    "rhyme": "#",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "6",
                    "text": "More ways to blow blood cells in your face",
                    "rhyme": "as",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "7",
                    "text": "React with four bombs and six fire missiles",
                    "rhyme": "il",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "8",
                    "text": "Armed with seven rounds of space doo-doo pistols",
                    "rhyme": "Ol",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "9",
                    "text": "You may not believe, living on the Earth planet",
                    "rhyme": "Et",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "10",
                    "text": "My skin is green and silver, forehead looking mean",
                    "rhyme": "in",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "11",
                    "text": "Astronauts get played, tough like the ukelele",
                    "rhyme": "abl",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "12",
                    "text": "As I move in rockets, overriding, levels",
                    "rhyme": "El",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "13",
                    "text": "Nothing's aware, same data, same system",
                    "rhyme": "Em",
                    "persona": "Dr. Octagon"
                }
            ]
        },
