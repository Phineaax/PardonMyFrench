        {
            "section_id": "section_6",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Now my helmet's on, you can't tell me I'm not in space",
                    "rhyme": "as",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "1",
                    "text": "With the National Guard United States Enterprise",
                    "rhyme": "iz",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "2",
                    "text": "Diplomat of swing with aliens at my feet",
                    "rhyme": "it",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "3",
                    "text": "Coming down the rampart through beam on the street",
                    "rhyme": "it",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "4",
                    "text": "Obsolete computes, compounds and dead sounds",
                    "rhyme": "wndz",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "5",
                    "text": "As I locate intricately independent",
                    "rhyme": "#d",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "6",
                    "text": "Economic vomit, I save re-store food",
                    "rhyme": "ud",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "7",
                    "text": "In Capsule D my program is ability",
                    "rhyme": "i",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "8",
                    "text": "For a reaction and response to a no-one",
                    "rhyme": "On",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "9",
                    "text": "Identification Code: Unidentified",
                    "rhyme": "e",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "10",
                    "text": "I got cosmophonic, pressed a button, changed my face",
                    "rhyme": "as",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "11",
                    "text": "You recognized, so what? I turned invisible",
                    "rhyme": "ibl",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "12",
                    "text": "Made myself clear, reappear to you visual",
                    "rhyme": "Ol",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "13",
                    "text": "Disappear again, zapped like an android",
                    "rhyme": "a",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "14",
                    "text": "Face the fact, I fly on planets every day",
                    "rhyme": "E",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "15",
                    "text": "My nucleus friend, prepare, I return again",
                    "rhyme": ")",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "16",
                    "text": "My 7XL is not yet invented",
                    "rhyme": "e",
                    "persona": "Dr. Octagon"
                }
            ]
        },
