            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Space Ranger, contact tubes, send them FedEx",
                    "rhyme": "Eks",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "1",
                    "text": "I program one and go to Earth through the fax machine",
                    "rhyme": "in",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "2",
                    "text": "My number's Seven-Oh-Nine Seven-Five-Five Six-E-L-Three",
                    "rhyme": "e",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "3",
                    "text": "Computer File: Nine-Three",
                    "rhyme": "e",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "4",
                    "text": "Digital level, standing on the terminal",
                    "rhyme": "al",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "5",
                    "text": "Upside down through polygons fighting pentagons",
                    "rhyme": "$",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "6",
                    "text": "Changing blue skin, my brown color's coming back",
                    "rhyme": "ak",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "7",
                    "text": "I'm psychedelic this time, come in rainbow",
                    "rhyme": "o",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "8",
                    "text": "Look at the green lights and y'all see my brain glow",
                    "rhyme": "o",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "9",
                    "text": "Five colours: yellow, black, and red and green, purple",
                    "rhyme": "ypl",
                    "persona": "Dr. Octagon"
                }
            ]
