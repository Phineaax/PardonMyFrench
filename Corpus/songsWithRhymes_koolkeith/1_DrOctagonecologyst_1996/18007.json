                },
                {
                    "n": "11",
                    "text": "You beware, orangutans tappin' on your window",
                    "rhyme": "o",
                    "persona": "Dr. Octagon"
                },
                {
                    "n": "12",
                    "text": "Bulls and coyotes, while roaches walk around your poodle",
