        },
        {
          "n": "7",
          "text": "Tell that new version of me that I'm comin', yeah",
          "rhyme": "E",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "8",
          "text": "My brodie had another baby, that's like number two (Number two)",
