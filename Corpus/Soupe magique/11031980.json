        },
        {
          "n": "2",
          "text": "Who is that? You niggas get too attached to hear it",
          "rhyme": "it",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "3",
          "text": "Fear it, face clear, few wrinkles on my spirit",
          "rhyme": "it",
