      "lines": [
        {
          "n": "0",
          "text": "Yеah, what's gotten into me? Nah, that ain't the energy",
          "rhyme": "i",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "1",
          "text": "That version of T that you knew is a memory",
