        },
        {
          "n": "11",
          "text": "If you ever see him, shout him out",
          "rhyme": "awt",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "12",
          "text": "It's all about the clout, whoever wanna brawl, call 'em out",
