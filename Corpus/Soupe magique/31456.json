    {
      "section_id": "section_4",
      "type": "outro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Would you believe it?",
          "rhyme": "it",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "1",
          "text": "I think I wanted to see you get away with it",
          "rhyme": "it",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "2",
          "text": "You were everything I wasn't, everything I wanted to be",
          "rhyme": "ab",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "3",
          "text": "Everything we all like to be",
          "rhyme": "ab",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "4",
          "text": "Only we know better",
          "rhyme": "e",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "5",
          "text": "We don't take the chances",
          "rhyme": "#s",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "6",
          "text": "We know sooner or later, it always catches up with you",
          "rhyme": "u",
          "persona_id": "Viktor_Vaughn"
        }
      ],
      "rhyme": "AABBCDE",
      "rhyme_vowel": "AABBCDE"
    }
  ]
