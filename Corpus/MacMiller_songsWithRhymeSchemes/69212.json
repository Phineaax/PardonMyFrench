{"song_id": 69212, "title": "Clarity", "language": "en", "lyricists": "[820, 1714839, 28101, 50828, 31688]", "lyrics": [{"section_id": "section_0", "type": "intro", "performer": "", "lines": [{"n": "0", "text": "Clarity", "rhyme": "i"}, {"n": "1", "text": "Clarity", "rhyme": "i"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_1", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "Clarity", "rhyme": "i"}, {"n": "1", "text": "Figure all this out, I ain't gonna take a charity", "rhyme": "i"}, {"n": "2", "text": "Marry me", "rhyme": "@"}, {"n": "3", "text": "Wish everyone could shake and play the tambourine", "rhyme": "in"}, {"n": "4", "text": "Perfect", "rhyme": "Ekt"}, {"n": "5", "text": "I know I love you, I ain't tryna let those words slip", "rhyme": "ip"}, {"n": "6", "text": "Pure bliss", "rhyme": "ajs"}, {"n": "7", "text": "I knew that we would stay together, we in cursive", "rhyme": "iv"}], "rhyme": "AABCDEFG", "rhyme_vowel": "AABACADA"}, {"section_id": "section_2", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Ah (La-la-la, la-la-la, la-la-la-la)", "rhyme": "a"}, {"n": "1", "text": "Ah (La-la-la, la-la-la, la-la-la-la)", "rhyme": "a"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_3", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "Infatuation", "rhyme": "$"}, {"n": "1", "text": "When every single move you make is fascinatin'", "rhyme": ")"}, {"n": "2", "text": "Gravitatin'", "rhyme": ")"}, {"n": "3", "text": "Towards anything that gives a sense of happiness", "rhyme": "Es"}, {"n": "4", "text": "Activist, love activist", "rhyme": "ist"}, {"n": "5", "text": "Sendin' my love for girls who got some cuts at their wrists", "rhyme": "ist"}, {"n": "6", "text": "Hope you found what you lookin' for", "rhyme": "OR"}, {"n": "7", "text": "I hope you find what you lookin' for", "rhyme": "OR"}], "rhyme": "ABBCDDEE", "rhyme_vowel": "ABBCDDEE"}, {"section_id": "section_4", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "You take away the pain and I thank you for that", "rhyme": "a"}, {"n": "1", "text": "If I ever get the chance, bet I'm payin' you back", "rhyme": "ak"}, {"n": "2", "text": "I'ma be waitin' for that", "rhyme": "a"}, {"n": "3", "text": "I'ma be waitin' for that", "rhyme": "a"}], "rhyme": "ABAA", "rhyme_vowel": "AAAA"}, {"section_id": "section_5", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "Misery", "rhyme": "i"}, {"n": "1", "text": "You represent love, you the epitome", "rhyme": "om"}, {"n": "2", "text": "So wish for me", "rhyme": "@"}, {"n": "3", "text": "I'll come out of nowhere, your epiphany", "rhyme": "i"}, {"n": "4", "text": "Disconnect", "rhyme": "Ekt"}, {"n": "5", "text": "From everybody who don't understand my vision yet", "rhyme": "E"}, {"n": "6", "text": "In a jet", "rhyme": "Et"}, {"n": "7", "text": "Is where my mind is, so I light another cigarette to calm me down", "rhyme": "awn"}], "rhyme": "ABCADEFG", "rhyme_vowel": "ABCADDDE"}, {"section_id": "section_6", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Ah (La-la-la, la-la-la, la-la-la-la)", "rhyme": "a"}, {"n": "1", "text": "Ah (La-la-la, la-la-la, la-la-la-la)", "rhyme": "a"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_7", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "So calm me down", "rhyme": "awn"}, {"n": "1", "text": "Everybody who can save me now is not around", "rhyme": "awnd"}, {"n": "2", "text": "Chopper down", "rhyme": "awn"}, {"n": "3", "text": "Busy today, but can you tell me how tomorrow sounds?", "rhyme": "wndz"}, {"n": "4", "text": "In between", "rhyme": "in"}, {"n": "5", "text": "Purgatory ain't as bad as it would seem to be", "rhyme": "ab"}, {"n": "6", "text": "Live a dream", "rhyme": "im"}, {"n": "7", "text": "That's so clich\u00e9, but I can tell you what it means to me", "rhyme": "@"}], "rhyme": "ABACDEFG", "rhyme_vowel": "AAABCACD"}, {"section_id": "section_8", "type"