{"song_id": 2305086, "title": "Doors", "language": "en", "lyricists": "[820, 685]", "lyrics": [{"section_id": "section_0", "type": "intro", "performer": "", "lines": [{"n": "0", "text": "Yeah", "rhyme": "E"}], "rhyme": "A", "rhyme_vowel": "A"}, {"section_id": "section_1", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "I know it's been a minute since I've been away", "rhyme": "e"}, {"n": "1", "text": "Didn't mean to cause you pain, I just needed to escape", "rhyme": "ap"}, {"n": "2", "text": "Ain't sayin' that I'm sober, I'm just in a better place", "rhyme": "as"}, {"n": "3", "text": "I'm on my way over, I'm just runnin' kinda late", "rhyme": "at"}, {"n": "4", "text": "And you know I've been through all the highs", "rhyme": "a"}, {"n": "5", "text": "I've seen all the lows, lost track of time", "rhyme": "ajm"}, {"n": "6", "text": "I'm coming home, you know my mind", "rhyme": "#"}, {"n": "7", "text": "Places it goes, and it goes, and it goes", "rhyme": "is"}], "rhyme": "ABCDEFGH", "rhyme_vowel": "ABBBBBCD"}, {"section_id": "section_2", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "It's only a game", "rhyme": "Ejm"}, {"n": "1", "text": "Don't be afraid", "rhyme": "Ed"}, {"n": "2", "text": "These doors will close", "rhyme": "oz"}, {"n": "3", "text": "And people change", "rhyme": "#Z"}, {"n": "4", "text": "One day you're gone", "rhyme": "on"}, {"n": "5", "text": "Right now you're here", "rhyme": "eR"}, {"n": "6", "text": "Don't leave just yet", "rhyme": "E"}, {"n": "7", "text": "Don't disappear", "rhyme": "ER"}], "rhyme": "ABCDEFGH", "rhyme_vowel": "AABCBDAA"}, {"section_id": "section_3", "type": "outro", "performer": "", "lines": [{"n": "0", "text": "Good morning, baby", "rhyme": "i"}], "rhyme": "A", "rhyme_vowel": "A"}]}