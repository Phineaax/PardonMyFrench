  "lyrics": [
    {
      "section_id": "section_0",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I'm in this fight and I'm swingin', and my arms are gettin' tired",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "1",
          "text": "I'm tryna beat this emptiness, but I'm runnin' out of time",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "2",
          "text": "I'm sinkin' in the sand and I can barely stand",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "3",
          "text": "I'm lost in this dream, I need you to hold me",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "4",
          "text": "I'm scared of lonely",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "5",
          "text": "I try to be patient, but I'm hurtin' deep inside",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "6",
          "text": "And I can't keep waitin', I need comfort late at night",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "7",
          "text": "And I can't find my way, won't you lead me home?",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "8",
          "text": "'Cause I'm lost in this dream, I need you to hold me",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "9",
          "text": "I'm scared of lonely",
          "persona_id": "persona_sasha_fierce"
        }
      ]
    },
    {
      "section_id": "section_1",
      "type": "chorus",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "And I'm scared of bein' the only",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "1",
          "text": "Shadow I see along the wall (Of lonely)",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "2",
          "text": "And I'm scared the only heartbeat",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "3",
          "text": "I hear beatin' is my own (Of lonely)",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "4",
          "text": "And I'm scared of being alone",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "5",
          "text": "I can't seem to breathe when I am lost in this dream",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "6",
          "text": "I need you to hold me",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "7",
          "text": "I'm scared of lonely",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "8",
          "text": "I'm scared of lonely",
          "persona_id": "persona_sasha_fierce"
        }
      ]
    },
    {
      "section_id": "section_2",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I cry at night, 'cause my baby's too far to be by my side",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "1",
          "text": "To wipe away these tears of mine, so I hold my pillow tight",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "2",
          "text": "To imagine you outstretch your hand, lookin' for mine",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "3",
          "text": "'Cause I'm lost in this dream, I need you to hold me",
          "persona_id": "persona_sasha_fierce"
        },
        {
          "n": "4",
          "text": "I'm scared of lonely",
          "persona_id": "persona_sasha_fierce"
        }
