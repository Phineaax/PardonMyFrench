      "lines": [
        {
          "n": "0",
          "text": "Now I'm at a place I thought I'd never be, ooh",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "1",
          "text": "I'm living in a world that's all about you and me, yeah",
          "persona_id": "persona_beyonce_baseline"
        },
