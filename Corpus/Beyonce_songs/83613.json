        },
        {
          "n": "6",
          "text": "When you lose the one you wanted (You wanted)",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "7",
          "text": "'Cause he's taken you for granted (Granted)",
          "persona_id": "persona_beyonce_baseline"
        },
        {
