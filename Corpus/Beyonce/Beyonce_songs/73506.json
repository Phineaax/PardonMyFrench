      "lines": [
        {
          "n": "0",
          "text": "I wanna leave my footprints on the sands of time",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "1",
          "text": "Know there was something that meant something that I left behind",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "2",
          "text": "When I leave this world, I'll leave no regrets",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "3",
          "text": "Leave something to remember, so they won't forget",
          "persona_id": "persona_beyonce_baseline"
        }
      ]
    },
    {
