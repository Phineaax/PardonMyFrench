{"song_id": 78577, "title": "Disappear", "language": "en", "lyricists": [498, 124851, 35027, 124850, 43439], "lyrics": [{"section_id": "section_0", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "If I begged and if I cried", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "Would it change the sky tonight?", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "Would it give me some light?", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "Should I wait for you to call?", "persona_id": "persona_beyonce_baseline"}, {"n": "4", "text": "Is there any hope at all?", "persona_id": "persona_beyonce_baseline"}, {"n": "5", "text": "Are you driftin' by?", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_1", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "When I think about it", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "I know that I was never there or even cared", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "The more I think about it", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "The less that I was able to share with you", "persona_id": "persona_beyonce_baseline"}, {"n": "4", "text": "I try to reach you, I can almost feel you", "persona_id": "persona_beyonce_baseline"}, {"n": "5", "text": "You're nearly here and then", "persona_id": "persona_beyonce_baseline"}, {"n": "6", "text": "You disappear (Disappear, disappear, disappear)", "persona_id": "persona_beyonce_baseline"}, {"n": "7", "text": "You disappear (Disappear, disappear, disappear)", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_2", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "And when I lie all by myself", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "I see your face, I hear your voice", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "My heart stays faithful", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "And time has come and time has passed", "persona_id": "persona_beyonce_baseline"}, {"n": "4", "text": "If it's good, it's got to last", "persona_id": "persona_beyonce_baseline"}, {"n": "5", "text": "It feels so right", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_3", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "When I think about it", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "I know that I was never there or even cared", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "The more I think about it", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "The less that I was able to share with you", "persona_id": "persona_beyonce_baseline"}, {"n": "4", "text": "I try to reach you, I can almost feel you", "persona_id": "persona_beyonce_baseline"}, {"n": "5", "text": "You're nearly here and then", "persona_id": "persona_beyonce_baseline"}, {"n": "6", "text": "You disappear (Disappear, disappear, disappear)", "persona_id": "persona_beyonce_baseline"}, {"n": "7", "text": "You disappear (Disappear, disappear, disappear)", "persona_id": "persona_beyonce_baseline"}, {"n": "8", "text": "You, you disappear (Disappear, disappear, disappear)", "persona_id": "persona_beyonce_baseline"}, {"n": "9", "text": "You disappear", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_4", "type": "bridge", "performer": "", "lines": [{"n": "0", "text": "I missed all the signs, one at a time", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "You were ready", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "What did I know? Starting our lives", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "Now my love, I'm ready to show", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_5", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "When I think about it", "persona_id": "persona_beyonce_baseline"}, {"n": 