    {
      "section_id": "section_0",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I told you how you hurt me, baby",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "1",
          "text": "But you don't care",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "2",
          "text": "Now, I'm cryin' and deserted, baby",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "3",
          "text": "But you don't care",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "4",
          "text": "Ain't nobody tell me this is love",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "5",
          "text": "When you're immune to all my pain",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "6",
          "text": "I need you to tell me this is love",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "7",
          "text": "You don't care? Well, that's okay",
          "persona_id": "persona_beyonce_baseline"
        }
      ]
    },
