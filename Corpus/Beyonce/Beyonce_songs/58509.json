        },
        {
          "n": "2",
          "text": "What happened to our trust? (Happened to our trust?)",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "3",
          "text": "Now you're just givin' up (Now you're just givin' up)",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "4",
          "text": "You used to be so in love (You used to be so in love)",
