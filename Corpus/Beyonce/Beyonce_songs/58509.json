      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Ever since you knew your power",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "1",
          "text": "You made me cry",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "2",
          "text": "And now, everytime our love goes sour",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "3",
          "text": "You won't sympathize",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "4",
          "text": "You see these tears fallin' down to my ears",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "5",
          "text": "I swear you like when I'm in pain, yeah",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "6",
          "text": "I try to tell you all my fears, huh",
          "persona_id": "persona_beyonce_baseline"
        },
        {
          "n": "7",
          "text": "You still don't care? That's okay, hey",
          "persona_id": "persona_beyonce_baseline"
