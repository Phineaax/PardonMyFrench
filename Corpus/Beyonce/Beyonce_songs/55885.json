{"song_id": 55885, "title": "Ave Maria", "language": "en", "lyricists": [498, 35027, 124851, 63120, 1021143, 401419], "lyrics": [{"section_id": "section_0", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "She was lost in so many different ways", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "Out in the darkness with no guide", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "I know the cost of a losing hand", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "There, but for the grace of God, oh, I", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_1", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "I found Heaven on Earth", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "You are my last, my first", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "And then I hear this voice inside", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "Ave Maria", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_2", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "I've been alone when I'm surrounded by friends", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "How could the silence be so loud?", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "But I still go home knowing that I've got you", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "There's only us when the lights go down", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_3", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "You are my Heaven on Earth", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "You are my hunger, my thirst", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "I always hear this voice inside", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "Singing Ave Maria", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_4", "type": "bridge", "performer": "", "lines": [{"n": "0", "text": "Sometimes, love can come and pass you by", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "While you're busy makin' plans", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "Suddenly hit you and then you realize", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "It's out of your hands", "persona_id": "persona_beyonce_baseline"}, {"n": "4", "text": "Baby, you got to understand", "persona_id": "persona_beyonce_baseline"}]}, {"section_id": "section_5", "type": "chorus", "performer": "", "lines": [{"n": "0", "text": "You are my Heaven on earth", "persona_id": "persona_beyonce_baseline"}, {"n": "1", "text": "You are my last, my first", "persona_id": "persona_beyonce_baseline"}, {"n": "2", "text": "And then I hear this voice inside", "persona_id": "persona_beyonce_baseline"}, {"n": "3", "text": "Ave Maria", "persona_id": "persona_beyonce_baseline"}, {"n": "4", "text": "Ave Maria", "persona_id": "persona_beyonce_baseline"}, {"n": "5", "text": "Ave Maria", "persona_id": "persona_beyonce_baseline"}]}], "album_id": 11096}