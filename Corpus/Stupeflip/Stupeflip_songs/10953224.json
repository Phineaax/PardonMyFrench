      "lines":[
        {
          "n":"0",
          "text":"Elle est ma certitude",
          "rhyme":"yd",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Me donne un courage fou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Combat ma solitude",
          "rhyme":"yd",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Quand je suis dans mon trou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Elle m'hypnotise la tête",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Me rend intelligеnt",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Elle me fait faire la fêtе",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Me fait aimer les gens",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Toujours je crois en elle",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Même quand elle m'laisse tomber",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Elle revient de plus belle",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Pour me relever (Ma musique)",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"J'aurais rien fait sans elle",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Et elle n'a pas de prix",
          "rhyme":"i",
