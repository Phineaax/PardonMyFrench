        {
          "n":"2",
          "text":"Elle me fera danser",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Quand j'suis désespéré (Ma musique)",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Elle est là dans mon cœur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"C'est pour moi comme ma sœur",
