        },
        {
          "n":"10",
          "text":"Elle rallum'ra le feu",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Quand j'en ai rien à fout' (Ma musique)",
          "rhyme":"u",
