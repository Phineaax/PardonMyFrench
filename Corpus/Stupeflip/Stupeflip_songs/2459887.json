{
  "song_id":2459887,
  "title":"Fille Psychotique (maquette 2008)",
  "language":"fr",
  "lyricists":[
    55334
  ],
  "lyrics":[
    {
      "section_id":"section_0",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Ne me regarde pas comme ça droit dans les yeux",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Et surtout ne crois pas que tu me fais peur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"N'essaie pas, je suis plus amoureux",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et crois-moi je ref'rai plus la même erreur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Ton cerveau connaît de vrais problèmes",
          "rhyme":"Em",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Mais maintenant compte plus sur moi pour t'aider",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"T'es trop ouf et tu tapes sur l'système",
          "rhyme":"Em",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Et tes SMS, je les ai ai tous jetés",
          "rhyme":"e",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABABCDCD",
      "rhyme_vowel":"ABABCDCD"
    },
    {
      "section_id":"section_1",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
