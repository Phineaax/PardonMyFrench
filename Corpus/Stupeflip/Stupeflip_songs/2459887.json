          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Une psycho girl",
          "rhyme":"9Rl",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Woh, oh, oh oh",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Psycho girl",
          "rhyme":"9Rl",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Tes rires machiavéliques",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Une psycho girl",
          "rhyme":"9Rl",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Woh, oh",
          "rhyme":"o",
