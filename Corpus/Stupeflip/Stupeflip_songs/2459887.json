{"song_id": 2459887, "title": "Fille Psychotique (maquette 2008)", "language": "fr", "lyricists": [55334], "lyrics": [{"section_id": "section_0", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "Ne me regarde pas comme \u00e7a droit dans les yeux", "rhyme": "2", "persona_id": "kingju"}, {"n": "1", "text": "Et surtout ne crois pas que tu me fais peur", "rhyme": "9R", "persona_id": "kingju"}, {"n": "2", "text": "N'essaie pas, je suis plus amoureux", "rhyme": "2", "persona_id": "kingju"}, {"n": "3", "text": "Et crois-moi je ref'rai plus la m\u00eame erreur", "rhyme": "9R", "persona_id": "kingju"}, {"n": "4", "text": "Ton cerveau conna\u00eet de vrais probl\u00e8mes", "rhyme": "Em", "persona_id": "kingju"}, {"n": "5", "text": "Mais maintenant compte plus sur moi pour t'aider", "rhyme": "e", "persona_id": "kingju"}, {"n": "6", "text": "T'es trop ouf et tu tapes sur l'syst\u00e8me", "rhyme": "Em", "persona_id": "kingju"}, {"n": "7", "text": "Et tes SMS, je les ai ai tous jet\u00e9s", "rhyme": "e", "persona_id": "kingju"}], "rhyme": "ABABCDCD", "rhyme_vowel": "ABABCDCD"}, {"section_id": "section_1", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Tu n'es qu'une psycho girl", "rhyme": "9Rl", "persona_id": "kingju"}, {"n": "1", "text": "M\u00e9chante et hyst\u00e9rique", "rhyme": "ik", "persona_id": "kingju"}, {"n": "2", "text": "Une psycho girl", "rhyme": "9Rl", "persona_id": "kingju"}, {"n": "3", "text": "Woh, oh, oh oh", "rhyme": "o", "persona_id": "kingju"}, {"n": "4", "text": "Psycho girl", "rhyme": "9Rl", "persona_id": "kingju"}, {"n": "5", "text": "Tes rires machiav\u00e9liques", "rhyme": "ik", "persona_id": "kingju"}, {"n": "6", "text": "Une psycho girl", "rhyme": "9Rl", "persona_id": "kingju"}, {"n": "7", "text": "Woh, oh", "rhyme": "o", "persona_id": "kingju"}], "rhyme": "ABACABAC", "rhyme_vowel": "ABACABAC"}, {"section_id": "section_2", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "Je me souviens bien quand t'