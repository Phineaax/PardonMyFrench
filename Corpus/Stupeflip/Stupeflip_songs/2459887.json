        }
      ],
      "rhyme":"ABACABAC",
      "rhyme_vowel":"ABACABAC"
    },
    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Je me souviens bien quand t'étais à l'hôpital",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Tu m'avais dit que t'aimais faire souffrir",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Tu m'avais dit que tu aimais faire du mal",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"À ce moment-là j'aurais pas dû en rire",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Tu joues à la dingue mais t'en es bien consciente",
          "rhyme":"#t",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"T'es bien contente, tu m'as manipulé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Quand j'y repense, dès l'début t'étais chiante",
          "rhyme":"#t",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Ton p'tit manège sera bientôt démasqué",
          "rhyme":"e",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABABCDCD",
      "rhyme_vowel":"ABABCDCD"
    },
