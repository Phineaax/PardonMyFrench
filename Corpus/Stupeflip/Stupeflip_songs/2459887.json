    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Ça fait une demi-heure que tu sonnes à l'interphone",
          "rhyme":"On",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Tu peux toujours, je ne t'ouvrirai pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Tu peux crier et tu peux tout casser",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Des spécialistes vont se pencher sur ton cas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Tu es belle, oui, mais bien trop cruelle",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Et tu verras un jour il faudra payer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Tu fais la belle et tu fais ta rebelle",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Faudra bien finir par te faire interner",
          "rhyme":"e",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCBDCDC",
      "rhyme_vowel":"ABCBDCDC"
