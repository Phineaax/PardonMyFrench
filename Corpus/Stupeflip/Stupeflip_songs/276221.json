    {
      "section_id":"section_3",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"J'vends soixante millions d'disques avec la Stup Danse",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"C'est la seule danse qui pense et qui fracasse le silence",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"C'est la danse qui fait craquer l'parquet",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Les meufs sont larguées, les mecs sont estomaqués",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"C'est la zik bizarre, le cauchemar",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Tentaculaire comme un calamar",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Et les radios n'en voudront pas, ça c'est sûr",
          "rhyme":"yR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Et moi j'aurai jamais d'villa sur la côte d'azur (ça c'est sûr)",
          "rhyme":"yR",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABCDDEE",
      "rhyme_vowel":"AABCDDEE"
    },
