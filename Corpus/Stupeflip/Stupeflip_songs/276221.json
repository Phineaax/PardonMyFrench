    {
      "section_id":"section_5",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Ils collent à mes yeux !",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Ils marchent sur mes cheveux !",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Sillonnent dans mon cou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Ils me prennent pour un joujou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Les garçons",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Les mecs",
          "rhyme":"Ek",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"C'est toujours pareil",
          "rhyme":"Ej",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Dieu n'a pas fait d'paupières pour les oreilles",
          "rhyme":"Ej",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABBCDEE",
      "rhyme_vowel":"AABBCDDD"
    },
    {
      "section_id":"section_6",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Moi j'suis Reverb'man",
          "rhyme":"an",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'ai d'la reverb dans la voix",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"C'est un style à moi",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Qu'aucun autre gars a",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"J'aime bien, le reverb ça donne de la profondeur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"« N'aie pas de regret », comme Mylène farmer",
          "rhyme":"9R",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABBBCC",
      "rhyme_vowel":"AAAABB"
    },
    {
      "section_id":"section_7",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Hup hup hup Barbatruc",
          "rhyme":"yk",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Ça c'est l'ère du Stup !",
          "rhyme":"yp",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"T'as toujours pas capté qu'est-ce c'était qu'ce truc",
          "rhyme":"yk",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Juste un truc foutraque qui frappe tape comme une matraque",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Ou un truc lucide brûlant comme l'acide citrique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Alors cherche comme un porc",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Gratte, gratte dans la terre",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Gratte dans la terre et trouve les pommes de terre",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Les jaloux sont obligés d'se taire",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"C'est dans l'chocolat qu'sont les clés du mystère",
          "rhyme":"ER",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABACDEFFFF",
      "rhyme_vowel":"AAABCDEEEE"
    },
