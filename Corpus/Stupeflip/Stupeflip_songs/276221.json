    },
    {
      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Mais qu'est-ce qui s'passe quand la caisse claire fracasse",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Quand la basse tabasse envoie les sons dans l'espace ?",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"C'est le danse du flip",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"C'est pour ceux qui fument des clopes",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"C'est crade comme une sale fripe",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Alors tout l'monde en slop",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Capaclop cataclop",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Sur mon fier destroyer j'envoie des vagues d'électrochocs",
          "rhyme":"Ok",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Les femmes enceintes nuisent à votre entourage",
          "rhyme":"aZ",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Le son est glauque comme un marécage",
          "rhyme":"aZ",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABCBCCDEE",
      "rhyme_vowel":"AABCBCCCAA"
    },
