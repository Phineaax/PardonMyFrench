  "lyrics":[
    {
      "section_id":"section_0",
      "type":"intro",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"- Pourquoi les terriens sont ils tous aussi méchants ?",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Hein ? Dis le moi toi ? Pourquoi ? Hein ?",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"- Bah j'sais pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Ah mais peut être parce que...",
          "rhyme":"@",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"[Refrain]X2",
          "rhyme":"iks",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"C'est la nature humaine, toujours l'même problème",
          "rhyme":"Em",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Écraser l'autre sinon c'est toi qui te fais ken",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"C'est la nature humaine, toujours l'même problème",
          "rhyme":"Em",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Attends la maman pendant un long moment",
          "rhyme":"#",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCDEFGFA",
      "rhyme_vowel":"ABCDEFFFA"
    },
    {
      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Force à manger le petit",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Donne-lui du colin blanc, il l'avale avec de l'eau",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Dans une timbale en fer",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Un poisson tout fade avec l'odeur du fer",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Dans un casier en fer, un p'tit vêt'ment d'enfant",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Une cagoule et des gants, attends, attends la maman",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Attends la maman pendant un long moment",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Le savon est très jaune, l'odeur est très forte",
          "rhyme":"ORt",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Elle fait tourner les têtes",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Les petits crient beaucoup, ils deviendront grand",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"A l'extérieur les grilles attendent sagement",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Un enfant fou vient de décapiter une mouche",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"On lui met du scotch sur la bouche",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Il appelle “au secours” tous les jours dans la cour",
          "rhyme":"uR",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Traumatisé pour toujours",
          "rhyme":"uR",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCCDDDEFDDGGHH",
      "rhyme_vowel":"ABCCDDDECDDFFFF"
    },
