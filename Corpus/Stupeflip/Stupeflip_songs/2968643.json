    },
    {
      "section_id":"section_5",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"La vie à deux pas facile, faut prendre sur soi, faire des concessions",
          "rhyme":"$",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"J'ai pas envie d'faire de mômes, société d'*merde* c'est sans conditions",
          "rhyme":"$",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Maintenant j'ai même plus de larmes je reste zen mais j'suis essoré",
          "rhyme":"e",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"Si un jours tu changes d'avis, j'suis toujours là j'veux bien essayer",
          "rhyme":"e",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"AABB",
      "rhyme_vowel":"AABB"
    },
