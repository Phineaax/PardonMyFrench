      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Ce que je t'écris je le crie et c'est le secret de ma secte",
          "rhyme":"Ekt",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Mes textes claquent, t'agacent comme un insecte",
          "rhyme":"Ekt",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Mon son cradingue, crack, pète comme une cracotte",
          "rhyme":"Ot",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Tout le monde se frotte alors à quat' pattes, cocotte",
          "rhyme":"Ot",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Ouais j'trippe sur les trucks trash",
