        },
        {
          "n":"2",
          "text":"Tout ce qui craint enfin presque",
          "rhyme":"Esk",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Le Crou cravache dans la boue",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Casse la cruche",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Le Crou en cravate agressif comme une perruche",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Quant à toi mon gars je sais tout ce que tu fais ?",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"T'es assis, debout, couché, en train d'écouter un cd",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Tu écoutes du son à travers du matériel",
          "rhyme":"El",
