      "lines":[
        {
          "n":"0",
          "text":"Bandes de p'tites *bip*",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"C'est King Ju au microphone",
          "rhyme":"On",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Eh ouais, hahaha !",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et toi petite tu veux savoir où c'est le prochain concert de Stupeflip ?!",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"C'est la semaine prochaine et c'est dans ton cul",
          "rhyme":"y",
