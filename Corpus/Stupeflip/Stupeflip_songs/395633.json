        },
        {
          "n":"5",
          "text":"J'suis pas sûr de sucrer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Sous [crom' ?] cramé, j'ai l'sacré à massacrer",
