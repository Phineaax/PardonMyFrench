{
  "song_id":13556450,
  "title":"Comme les zot’ (version crue)",
  "language":"fr",
  "lyricists":[
    55334
  ],
  "lyrics":[
    {
      "section_id":"section_0",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Comme Jacques Higelin, j'suis \"tombé du ciel\"",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Comme Michel Jonasz, j'suis \"un peu naze\"",
          "rhyme":"az",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Comme Patrick Bruel, j'ai \"cassé la voix\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et comme Francis Lalanne, faut qu'tu \"penses a moi\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Et comme Carlos, j'te fais un \"big bisou\"",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Comme Mylène Farmer, \"je suis un garçon\"",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Comme Balavoine, j'suis pas \"un héros\"",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Comme Christian Clavier, j'dis \"OK !\"",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Comme Pascal Obispo, j'suis \"tombé pour elle\"",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Comme Dany Brillant, \"j'ai... j'ai perdu la tête\"",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Comme Jean-Pierre François, \"je te survivrai\"",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Comme Depalmas, \"j'en rêve encore\"",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Commе Jean-Jacques Goldman, \"je marchе seul\"",
          "rhyme":"9l",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Comme Alizée, \"c'est pas ma faute\"",
          "rhyme":"ot",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Comme Bashung, \"j'ai pris la contre allée\"",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"Comme Bibie, j'y vais \"tout doucement\"",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"Comme Lio, j'crois qu'\"la vie est si triste\"",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"Comme Gainsbourg, \"j'en ai bavé, pas vous ?\"",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"18",
          "text":"Comme Michel Berger, j'irai dans \"le paradis blanc\"",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"19",
          "text":"Comme Danielle Guichard, j'pense à \"mon vieux\"",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"20",
          "text":"Comme Yves Duteil, \"j'ai la guitare qui me démange\"",
          "rhyme":"#Z",
          "persona_id":"kingju"
        },
        {
          "n":"21",
          "text":"Comme France Gall, c'est \"tout pour la musique\"",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"22",
          "text":"Comme Herbert Léonard, j'te fais \"pour le plaisir\"",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"23",
          "text":"Et comme Patrick Sébastien, \"j'suis génial !\"",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"24",
          "text":"Comme C. Jérôme, \"j'vois qu'tu flirtes avec lui\"",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"25",
          "text":"Comme Bertignac, \"j'vais pas me laisser traîner là\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"26",
          "text":"Comme Jean-Pierre Madère, \"disparue…\"",
          "rhyme":"y",
          "persona_id":"kingju"
        },
        {
          "n":"27",
          "text":"Comme Serge Lama, \"je suis malade\"",
          "rhyme":"ad",
          "persona_id":"kingju"
        },
        {
          "n":"28",
          "text":"Comme Michel Fugain, j'dis \"viva la vida !\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"29",
          "text":"Comme Renaud, j'suis \"une bande de jeunes\"",
          "rhyme":"9n",
          "persona_id":"kingju"
        },
        {
          "n":"30",
          "text":"Comme Images, j'irai \"au bout de la nuit\"",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"31",
          "text":"Comme Gilbert Bécaud, j'dis \"aïe !\"",
          "rhyme":"aj",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCCDEFGAHIJKLGMNDMOPQRSTCUVCWTX",
      "rhyme_vowel":"ABBBCDEFAAAGHEFIJCIKIJJBJBLBBHJB"
    }
  ]
