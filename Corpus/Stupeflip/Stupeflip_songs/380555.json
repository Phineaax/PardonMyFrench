  "lyrics":[
    {
      "section_id":"section_0",
      "type":"intro",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"- Oh, on s'en fout, hein ?",
          "rhyme":")",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"- Ouais !",
          "rhyme":"E",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"AB",
      "rhyme_vowel":"AB"
    },
    {
      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Moi je suis Pop-Hip",
          "rhyme":"ip",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"Et je voudrais faire un tube",
          "rhyme":"yb",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Un truc qui déchire",
          "rhyme":"iR",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"Pas d'la soupe en bouillon cube",
          "rhyme":"yb",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"4",
          "text":"J'veux faire un carton",
          "rhyme":"$",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"5",
          "text":"Passer chez Michel Drucker",
          "rhyme":"9R",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"6",
          "text":"M'acheter une maison",
          "rhyme":"$",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"7",
          "text":"Y'en a marre de la misère !",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"8",
          "text":"Quand je s'rai au top",
          "rhyme":"Op",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"9",
          "text":"Je f'rai sans arrêt la fête",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"10",
          "text":"J's'rai le roi d'la pop",
          "rhyme":"Op",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"11",
          "text":"J'aurai mille paires de baskets",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"12",
          "text":"J'achèterai plein de trucs",
          "rhyme":"yk",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"13",
          "text":"Des Kit Kat et des chouquettes",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"14",
          "text":"Et des trucs qu'on croque",
          "rhyme":"Ok",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"15",
          "text":"Pour sans arrêt faire la fête",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"ABCBDEDFGHGHIHJH",
      "rhyme_vowel":"ABABCDCEFEFEBEFE"
    },
    {
      "section_id":"section_2",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Car moi je suis Pop-Hip",
          "rhyme":"ip",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"Écoute ma voix en stéréo !",
          "rhyme":"o",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Et moi j'ai la formule magique",
          "rhyme":"ik",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"J'adore passer à la radio !",
          "rhyme":"o",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"4",
          "text":"Moi j'fais des refrains qui déchirent",
          "rhyme":"iR",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"5",
          "text":"Pas comme tous ces cons de bobos !",
          "rhyme":"o",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"6",
          "text":"J'ai l'son qui plaît même aux mamies",
          "rhyme":"i",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"7",
          "text":"Et qui fait jumper tes amis !",
          "rhyme":"i",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"ABCBDBEE",
      "rhyme_vowel":"ABABABAA"
    },
    {
      "section_id":"section_3",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Quand je s'rai connu",
          "rhyme":"y",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"J'aurai plus besoin de taf",
          "rhyme":"af",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Et même dans la rue",
          "rhyme":"y",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"Je signerai des autographes",
          "rhyme":"af",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"4",
          "text":"J'aurai des groupies",
          "rhyme":"i",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"5",
          "text":"Qui seront trop hystériques",
          "rhyme":"ik",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"6",
          "text":"Et tout plein d'amis",
          "rhyme":"i",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"7",
          "text":"Même chez les hommes politiques",
          "rhyme":"ik",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"8",
          "text":"Dans le show business",
          "rhyme":"Es",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"9",
          "text":"On me f'ra la révérence",
          "rhyme":"#s",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"10",
          "text":"Bises à Marc Lavoine",
          "rhyme":"an",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"11",
          "text":"Des gala partout en France",
          "rhyme":"#s",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"12",
          "text":"J'f'rai d'la pub pour les slips",
          "rhyme":"ip",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"13",
          "text":"Et je f'rai le stade de France",
          "rhyme":"#s",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"14",
          "text":"On m'criera \"Pop-Hip !\"",
          "rhyme":"ip",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"15",
          "text":"Je serai une référence",
          "rhyme":"#s",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"ABABCDCDEFGFHFHF",
      "rhyme_vowel":"ABABCCCCDEBECECE"
