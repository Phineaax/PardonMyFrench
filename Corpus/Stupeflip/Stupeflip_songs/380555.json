    {
      "section_id":"section_5",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Écoute ce p'tit piano",
          "rhyme":"o",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"C'est trop extra super chouette",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Pas besoin de promo",
          "rhyme":"o",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"Ça te reste dans la tête",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"4",
          "text":"Ramène tous tes amis",
          "rhyme":"i",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"5",
          "text":"Champomy et cacahuètes",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"6",
          "text":"Ça plaît même aux mamies",
          "rhyme":"i",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"7",
          "text":"Parfait pour les soirées crêpes",
          "rhyme":"Ep",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"8",
          "text":"Allez viens dans ma boum",
          "rhyme":"um",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"9",
          "text":"Là j'ai préparé des trucs",
          "rhyme":"yk",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"10",
          "text":"Y'a des fraises Tagada",
          "rhyme":"a",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"11",
          "text":"Y'a des bonbecs et du sucre",
          "rhyme":"ykR",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"12",
          "text":"On va tout faire péter",
          "rhyme":"e",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"13",
          "text":"Et même s'ils appellent les flics",
          "rhyme":"ik",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"14",
          "text":"On va trop s'éclater",
          "rhyme":"e",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"15",
          "text":"Ça va faire vibrer les vitres !",
          "rhyme":"itR",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
