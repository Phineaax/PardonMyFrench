        },
        {
          "n":"12",
          "text":"Ils vont me sucer le cerveau",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Non maman non ne le fais pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Je serai doux comme un agneau",
