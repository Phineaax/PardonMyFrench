{"song_id": 382114, "title": "Le cartable", "language": "fr", "lyricists": [55334], "lyrics": [{"section_id": "section_0", "type": "h\u00e9l\u00e8ne", "performer": "", "lines": [{"n": "0", "text": "King Ju, tu ne me fais pas peur", "rhyme": "9R", "persona_id": "kingju"}, {"n": "1", "text": "M\u00eame si tu as une dr\u00f4le d'odeur", "rhyme": "9R", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_1", "type": "king-ju", "performer": "", "lines": [{"n": "0", "text": "Ne t'approche pas je suis violent", "rhyme": "Ol", "persona_id": "kingju"}, {"n": "1", "text": "Je n'\u00e9prouve pas de sentiments", "rhyme": "#", "persona_id": "kingju"}], "rhyme": "AB", "rhyme_vowel": "AB"}, {"section_id": "section_2", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "King-Ju\u2026 King-Ju\u2026 pour toi je f'rais n'importe quoi", "rhyme": "a", "persona_id": "kingju"}, {"n": "1", "text": "King-Ju.. King-Ju\u2026 s'teuplait ne m'abandonne pas\u2026", "rhyme": "a", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_3", "type": "h\u00e9l\u00e8ne", "performer": "", "lines": [{"n": "0", "text": "Tu sais un jour tu as souris", "rhyme": "i", "persona_id": "kingju"}, {"n": "1", "text": "Je sais qu'au fond tu es gentil", "rhyme": "i", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_4", "type": "king-ju", "performer": "", "lines": [{"n": "0", "text": "Je suis un monstre, un animal", "rhyme": "al", "persona_id": "kingju"}, {"n": "1", "text": "Sans faire expr\u00e8s je te ferais du mal", "rhyme": "al", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_5", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "King-Ju\u2026 King-Ju\u2026 pour toi je f'rais n'importe quoi", "rhyme": "a", "persona_id": "kingju"}, {"n": "1", "text": "King-Ju.. King-Ju\u2026 s'teuplait ne m'abandonne pas", "rhyme": "a", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_6", "type": "h\u00e9l\u00e8ne", "performer": "", "lines": [{"n": "0", "text": "Je voudrais bien vivre avec toi", "rhyme": "a", "persona_id": "kingju"}, {"n": "1", "text": "Je m'frais toute petite tu verras", "rhyme": "a", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_7", "type": "king-ju", "performer": "", "lines": [{"n": "0", "text": "Petit poussin, je n'suis pas fr\u00e9quentable", "rhyme": "abl", "persona_id": "kingju"}, {"n": "1", "text": "Alors oublies-moi et reprends ton cartable", "rhyme": "abl", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_8", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "King-Ju\u2026 King-Ju\u2026 pour toi je f'rais n'importe quoi", "rhyme": "a", "persona_id": "kingju"}, {"n": "1", "text": "King-Ju.. King-Ju\u2026 s'teuplait ne m'abandonne pas", "rhyme": "a", "persona_id": "kingju"}], "rhyme": "AA", "rhyme_vowel": "AA"}, {"section_id": "section_9", "type": "king-ju", "performer": "", "lines": [{"n": "0", "text": "AAAAAAAAAAAAAHHHH", "rhyme": "a", "persona_id": "kingju"}], "rhyme": "A", "rhyme_vowel": "A"}, {"section_id": "section_10", "type": "outro", "performer": "", "lines": [{"n": "0", "text": "Madame, Monsieur", "rhyme": "2", "persona_id": "kingju"}, {"n": "1", "text": "Le r\u00e8glement de votre facture", "rhyme": "yR", "persona_id": "kingju"}, {"n": "2", "text": "Du 14/10/2003 d'un montant de 168,45 euros", "rhyme": "o", "persona_id": "kingju"}, {"n": "3", "text": "Ne nous est pas encore parvenue", "rhyme": "y", "persona_id": "kingju"}, {"n": "4", "text": "Sans nouvelles de votre part avant le 17/11/2003", "rhyme": "@", "persona_id": "kingju"}, {"n": "5", "text": "Nous serions malheureusement dans l'obligation de limiter tr\u00e8s fortement nos fournitures ou de les suspendre", "rhyme": "#dR", "persona_id": "kingju"}, {"n": "6", "text": "Je vous rappelle que les locataires devront souscrire une assurance", "rhyme": "#s", "persona_id": "kingju"}, {"n": "7", "text": "Couvrant les risques locatifs et justifier chaque ann\u00e9e des primes de la dite assurance", "rhyme": "#s", "persona_id": "kingju"}], "rhyme": "ABCDEFGG", "rhyme_vowel": "ABCBDEEE"}], "album_id": 52114}