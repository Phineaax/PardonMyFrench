      "section_id":"section_5",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Le Stup faut pas les mettre on t'sent à un kilomètre",
          "rhyme":"EtR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"C'est qui les maîtres ?",
          "rhyme":"EtR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"C'est les nôtres",
          "rhyme":"otR",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Pas d'bâtards chez mes apôtres",
          "rhyme":"otR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Qui est neutre ? Quoi émettre ?",
          "rhyme":"EtR",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Dans l'concept tu t'empêtres",
          "rhyme":"EtR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Prends la porte, t'es qu'un pitre",
          "rhyme":"itR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Pas d'pitié si tu t'emportes",
          "rhyme":"ORt",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Stup Salut, club privé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Bienveillance et dérivé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Faudra bien y arriver",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Mec t'empêcher de dériver",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"J'suis sans rivaux",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"J'suis ravi",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Check le Stup Charivari",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"Mec le C.R.O.U. va te dévorer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"Mais sans teuteu j'arrive a rien (chaud)",
          "rhyme":")",
          "persona_id":"kingju"
