{"song_id": 3247173, "title": "Moi j\u2019aime le Stupeflip Crou", "language": "fr", "lyricists": [55334], "lyrics": [{"section_id": "section_0", "type": "intro", "performer": "", "lines": [{"n": "0", "text": "J'adore ce truc", "rhyme": "yk", "persona_id": "kingju"}, {"n": "1", "text": "Le 4-5-7-7", "rhyme": "@", "persona_id": "kingju"}, {"n": "2", "text": "J'adore ce truc", "rhyme": "yk", "persona_id": "kingju"}], "rhyme": "ABA", "rhyme_vowel": "ABA"}, {"section_id": "section_1", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Moi j'aime le Stupeflip Crou", "rhyme": "u", "persona_id": "kingju"}, {"n": "1", "text": "J'adore ce truc qui te pousse \u00e0 bout", "rhyme": "u", "persona_id": "kingju"}, {"n": "2", "text": "Moi j'aime le Stupeflip Crou", "rhyme": "u", "persona_id": "kingju"}, {"n": "3", "text": "J'adore ce truc qui te pousse \u00e0 bout", "rhyme": "u", "persona_id": "kingju"}], "rhyme": "AAAA", "rhyme_vowel": "AAAA"}, {"section_id": "section_2", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "L'\u00e9pouvantable \u00e9pouvantail est dans la place", "rhyme": "as", "persona_id": "kingju"}, {"n": "1", "text": "Tu te sens ballonn\u00e9, t'es p\u00e2lot l\u00e0", "rhyme": "a", "persona_id": "kingju"}, {"n": "2", "text": "Faudrait qu'un skeud pour nous d\u00e9boulonner", "rhyme": "e", "persona_id": "kingju"}, {"n": "3", "text": "Du boulot ? Nan", "rhyme": "#", "persona_id": "kingju"}, {"n": "4", "text": "La menuiserie revient te pilonner", "rhyme": "e", "persona_id": "kingju"}, {"n": "5", "text": "La rythmique te plaque", "rhyme": "ak", "persona_id": "kingju"}, {"n": "6", "text": "Ce son qui tue ne t'a pas couillonn\u00e9", "rhyme": "e", "persona_id": "kingju"}, {"n": "7", "text": "C'est bouillonnant, d\u00e9j\u00e0 mort", "rhyme": "OR", "persona_id": "kingju"}, {"n": "8", "text": "Comme un revenant, j'suis revenu", "rhyme": "y", "persona_id": "kingju"}, {"n": "9", "text": "Foutre le dawa pas pour les revenus", "rhyme": "y", "persona_id": "kingju"}, {"n": "10", "text": "T'es ravi l\u00e0", "rhyme": "a", "persona_id": "kingju"}, {"n": "11", "text": "J'te vois bouger t'es sur la piste l\u00e0, tu kiffes l\u00e0", "rhyme": "a", "persona_id": "kingju"}, {"n": "12", "text": "Mets-toi \u00e7a en boucle et boucle-la", "rhyme": "a", "persona_id": "kingju"}, {"n": "13", "text": "\"Clac !\" fait le verre en tombant sur le lino", "rhyme": "o", "persona_id": "kingju"}, {"n": "14", "text": "C'est la Stup-Stup clique mais on a pas de limo", "rhyme": "o", "persona_id": "kingju"}, {"n": "15", "text": "On est les as de la transe-danse", "rhyme": "#s", "persona_id": "kingju"}, {"n": "16", "text": "Toujours en cadence, \u00e7a balance", "rhyme": "#s", "persona_id": "kingju"}, {"n": "17", "text": "J'entends le bruit des ambulances", "rhyme": "#s", "persona_id": "kingju"}, {"n": "18", "text": "On a le total respect pour toutes les zouzs et les minots", "rhyme": "o", "persona_id": "kingju"}, {"n": "19", "text": "Cette fois-ci plus de Pop-Hip car il s'est fait \u00e9liminer", "rhyme": "e", "persona_id": "kingju"}, {"n": "20", "text": "C'est le branle-bas d'combat", "rhyme": "a", "persona_id": "kingju"}, {"n": "21", "text": "On est toujours dans la course", "rhyme": "uRs", "persona_id": "kingju"}, {"n": "22", "text": "Et fuck les b\u00e2tards qui nous traiteront de Bisounours", "rhyme": "uRs", "persona_id": "kingju"}], "rhyme": "ABCDCECFGGBBBHHIIIHCBJJ", "rhyme_vowel": "AABCBABDEEAAAFFCCCFBAGG"}, {"section_id": "section_3", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Moi j'aime le Stupeflip Crou (Stupeflip)", "rhyme": "u", "persona_id": "kingju"}, {"n": "1", "text": "J'adore ce truc qui te pousse \u00e0 bout (hahaha)", "rhyme": "u", "persona_id": "kingju"}, {"n": "2", "text": "Moi j'aime le Stupeflip Crou", "rhyme": "u", "persona_id": "kingju"}, {"n": "3", "text": "J'adore ce truc qui te pousse \u00e0 bout", "rhyme": "u", "persona_id": "kingju"}], "rhyme": "AAAA", "rhyme_vowel": "AAAA"}, {"section_id": "section_4", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "J'suis c'triste autiste, Stup-lyriciste", "rhyme": "ist", "persona_id": "kingju"}, {"n": "1", "text": "Triste ant\u00e9christ qui fiste les fils de...", "rhyme": "@", "persona_id": "kingju"}, {"n": "2", "text": "Ma force, elle est dans ces pistes", "rhyme": "ist", "persona_id": "kingju"}, {"n": "3", "text": "Et ces sons d'fous font flipper les radiesth\u00e9sistes", "rhyme": "ist", "persona_id": "kingju"}, {"n": "4", "text": "Pourquoi tu insistes ?", "rhyme": "ist", "persona_id": "kingju"}, {"n": "5", "text": "La vie est si triste", "rhyme": "ist", "persona_id": "kingju"}, {"n": "6", "text": "Check un peu ma carte aquoiboniste", "rhyme": "ist", "persona_id": "kingju"}, {"n": "7", "text": "Triste terroriste, encore pire que la peste", "rhyme": "Est", "persona_id": "kingju"}, {"n": "8", "text": "Contre les greedies qu'auraient trahi les manifestes j'peste", "rhyme": "Est", "persona_id": "kingju"}, {"n": "9", "text": "Stup Crou ! Incrompr\u00e9hensible, clairvoyant", "rhyme": "#", "persona_id": "kingju"}, {"n": "10", "text": "La zik c'est pas d\u00e9voy\u00e9", "rhyme": "e", "persona_id": "kingju"}, {"n": "11", "text": "N'oublie pas les non-voyants", "rhyme": "#", "persona_id": "kingju"}, {"n": "12", "text": "On est hyper gentils, super-super-super cool", "rhyme": "ul", "persona_id": "kingju"}, {"n": "13", "text": "On est doux comme des p'tits chats", "rhyme": "a", "persona_id": "kingju"}, {"n": "14", "text": "Beaucoup plus sympas qu'les aut'", "rhyme": "o", "persona_id": "kingju"}, {"n": "15", "text": "On est super marrants, toujours tranquille", "rhyme": "il", "persona_id": "kingju"}, {"n": "16", "text": "Tr\u00e8s pos\u00e9s (et on s'\u00e9nerve jamais !)", "rhyme": "e", "persona_id": "kingju"}, {"n": "17", "text": "Car il faut jamais s'\u00e9nerver", "rhyme": "e", "persona_id": "kingju"}, {"n": "18", "text": "On reste cool-cool-cool-cool-cool, ok ?", "rhyme": "e", "persona_id": "kingju"}, {"n": "19", "text": "J'suis pas un embrouilleur, ok ?", "rhyme": "e", "persona_id": "kingju"}], "rhyme": "ABAAAAACCDEDFGHIEEEE", "rhyme_vowel": "ABAAAAACCDEDFGHAEEEE"}, {"section_id": "section_5", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Moi j'aime le Stupeflip Crou (Paris 13e)", "rhyme": "u", "persona_id": "kingju"}, {"n": "1", "text": "J'adore ce truc qui te pousse \u00e0 bout", "rhyme": "u", "persona_id": "kingju"}, {"n": "2", "text": "Moi j'aime le Stupeflip Crou (Elle aime le Stupeflip Crou)", "rhyme": "u", "persona_id": "kingju"}, {"n": "3", "text": "J'adore ce truc qui te pousse \u00e0 bout", "rhyme": "u", "persona_id": "kingju"}], "rhyme": "AAAA", "rhyme_vowel": "AAAA"}, {"section_id": "section_6", "type": "outro", "performer": "", "lines": [{"n": "0", "text": "J'adore ce truc", "rhyme": "yk", "persona_id": "kingju"}, {"n": "1", "text": "J'adore ce truc", "rhyme": "yk", "persona_id": "kingju"}, {"n": "2", "text": "J'adore ce truc", "rhyme": "yk", "persona_id": "kingju"}, {"n": "3", "text": "J'adore ce truc", "rhyme": "yk", "persona_id": "kingju"}], "rhyme": "AAAA", "rhyme_vowel": "AAAA"}], "album_id": 334025}