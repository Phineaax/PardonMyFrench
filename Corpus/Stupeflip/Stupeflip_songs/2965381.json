      "lines":[
        {
          "n":"0",
          "text":"C'est pas d'la soupe, j'balance des bombes",
          "rhyme":"$b",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'suis dans ma stup-soucoupe, ma zic est ma soupape",
          "rhyme":"ap",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'découpe ce truc au coupe-coupe",
          "rhyme":"up",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Ma clique hardrock te braque",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"T'file des claques et fume tes clopes",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'suis hip hop cyclope qui va te BIP, BIP",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"STUPEFLIP, super top ça te tartine le slop",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"C'est la panique dans ton fut",
          "rhyme":"y",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Pas de flop pour ma clique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Le son du crou te tient en laisse",
          "rhyme":"Es",
