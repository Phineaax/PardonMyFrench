          "text":"Jeudi 10 juin à dix heures trente-quatre",
          "rhyme":"atR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"« Mon pote, niveau informatique, je suis Maître Jedi, okay ?",
          "rhyme":"E",
          "persona_id":"kingju"
        },
