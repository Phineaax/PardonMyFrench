    {
      "section_id":"section_3",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Y en a qui se croient dans Dallas, glorifiant la loi du plus fort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Y en a qu'ont jamais tort, qui se pavanent et font les fiers",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Y en a des pathétiques, de drôles de volatiles",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Sûrs de détenir les clés d'une vérité trop volatile",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Y en a qui critiquent la télé mais sont rivés dessus",
          "rhyme":"y",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Y en a qui sont intoxiqués alors qu'ils pensent au-dessus d'ça",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Y en a qui pètent un câble, qui cherchent des boucs émissaires",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Qui sont rendus responsables de leur propre misère",
          "rhyme":"ER",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCCDEBB",
      "rhyme_vowel":"ABCCDEBB"
