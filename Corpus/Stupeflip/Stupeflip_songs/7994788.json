        },
        {
          "n":"43",
          "text":"Ceux qui font tourner la machine",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"44",
          "text":"Z'ont pas envie d'les calculer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"45",
          "text":"Z'ont l'cœur d'acier comme des robots",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"46",
          "text":"Checke le sourire superficiel",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"47",
