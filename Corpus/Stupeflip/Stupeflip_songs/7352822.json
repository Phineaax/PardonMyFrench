  "lyrics":[
    {
      "section_id":"section_0",
      "type":"intro",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"- \"Pff, ch'ais pas moi, j'connais pas trop...\"",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"- \"Moi, j'trouve qu'il est tombé en dépression.\"",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"- \"N'importe quoi !\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"- \"Ouais, en dépression, ouais... Et là ça s'voit.\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"- \"Une fois, j'me souviens, euuh...\"",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"- \"On dirait les trucs sur Internet il est vraiment en dépression.\"",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"- \"...y'avait une vidéo où il ouvrait la porte \"Aaah\", et tout, \"ça va mal\"...\"",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"- \"Aahh...\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"- \"...avec des cernes, comme ça, \"ah, oui, oui\".\"",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"- \"Ben il vient d'faire un dernier truc, il a été- il a été-, il est là, il vient d'faire un dernier truc où il est là, c'est horrible c'qu'i' sort... il est mal, tu vois c'que j'veux dire ?\"",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"- \"J'me souviens avant, et euuh...\"",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"- \"On dirait qu'ils sont vraiment en train d'le niquer, là.\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"- \"...qu'c'était tout, machin-tout. La dernière fois qu'j'l'ai vu, i' s'ra tout maigre, tout pâle, tout creusant... enfin pas maigre, pas maigre, mais euh...\"",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"- \"Tu l'as vu où ? Tu l'as vu en vrai ?\"",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"- \"Noon, sur une vidéo envoyée, genre euh, y'avait des journalistes qui étaient v'nus chez lui et tout.\"",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"- \"Aah, oui.\"",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"- \"Et, genre, i' f'sait genre bonne figure et tout \"Ça va ?\"...\"",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"- \"Récente ?\"",
          "rhyme":"#t",
          "persona_id":"kingju"
        },
        {
          "n":"18",
          "text":"- \"Ouais...\"",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"19",
          "text":"- \"Ça doit pas être facile quand même.\"",
          "rhyme":"Em",
          "persona_id":"kingju"
        },
        {
          "n":"20",
          "text":"- \"Mais, 'fin, il était pas maigre, mais bon, par rapport à avant...\"",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"21",
          "text":"- \"Nan mais c'est juste que-\"",
          "rhyme":"@",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCCDBECFGDCHIDFCJIKLM",
      "rhyme_vowel":"ABCCDBCCEEDCFGDECHGGHI"
