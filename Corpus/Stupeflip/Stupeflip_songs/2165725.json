{"song_id": 2165725, "title": "Crou Genesis", "language": "fr", "lyricists": [55334], "lyrics": [{"section_id": "section_1", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "Voici la r\u00e9gion Sud", "rhyme": "yd", "persona_id": "kingju"}, {"n": "1", "text": "Elle tourne sur elle-m\u00eame \u00e0 une vitesse ph\u00e9nom\u00e9nale", "rhyme": "al", "persona_id": "kingju"}, {"n": "2", "text": "Si les r\u00e9gions Sud et Ouest se t\u00e9lescopaient", "rhyme": "E", "persona_id": "kingju"}, {"n": "3", "text": "Le choc provoqu\u00e9 serait d'une puissance consid\u00e9rable", "rhyme": "abl", "persona_id": "kingju"}, {"n": "4", "text": "Voici la r\u00e9gion Est", "rhyme": "E", "persona_id": "kingju"}, {"n": "5", "text": "Cette gigantesque boule de gaz est tellement l\u00e9g\u00e8re", "rhyme": "ER", "persona_id": "kingju"}, {"n": "6", "text": "Que si on la posait sur l'eau", "rhyme": "o", "persona_id": "kingju"}, {"n": "7", "text": "Elle flotterait", "rhyme": "E", "persona_id": "kingju"}], "rhyme": "ABCDCEFC", "rhyme_vowel": "ABCBCCDC"}], "album_id": 25755}