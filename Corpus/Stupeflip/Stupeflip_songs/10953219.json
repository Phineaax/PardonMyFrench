  "lyrics":[
    {
      "section_id":"section_0",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Okay, je remets l'couvert",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Râteau, techniques de karaté",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Prosternez-vous tous devant le king qu'a souvent tout raté",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Le casse-pipe s'approche, moche comme un coup d'taloche",
          "rhyme":"OS",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Mais qu'est-ce qui cloche quand ça clashe",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Et quand c'est louche, qu'est-ce ça cache ?",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"On influence les esprits boueux, le Stup c'est comme ta bouée",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"T'as chopé l'Stup Virus alors, au pieu, t'es cloué",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Moi j'suis trop bizarre pour la masse, le petit bonhomme en mousse",
          "rhyme":"us",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"C't'un massacre de masse quand ils encaissent les secousses",
          "rhyme":"us",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABBCDDBBEE",
      "rhyme_vowel":"ABBCDDBBEE"
    },
    {
      "section_id":"section_1",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"C'est l'truc explosif !",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Le son qui te fait tomber les tifs",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Mec, t'as pas l'étoffe, file une taff de ton spliff",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"C'est l'truc explosif !",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Le son qui t'prend par la truffe (trop ouf)",
          "rhyme":"yf",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"C-C-C'est l'son qui t'fait quitter l'taff",
          "rhyme":"af",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"C'est l'truc explosif !",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Le son qui te fait tomber les tifs",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Mec, t'as pas l'étoffe, file une taff de ton spliff",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"C'est l'truc explosif !",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Le son qui t'prend par la truffe",
          "rhyme":"yf",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Ça- Ça- Ça c'est l'ère du Stup !",
          "rhyme":"yp",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AAAABCAAAABD",
      "rhyme_vowel":"AAAABCAAAABB"
    },
    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Tu prends la mouche, ferme ta bouche",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Mec, fais pas ta Sainte-Nitouche",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Le biz d'la zik est louche et c'est pour ça qu'j'évite les flashs",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'ai trop d'sticks dans ma poche, y'a plus qu'à allumer la mèche",
          "rhyme":"ES",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Rascar Kapac fait pas partie d'ces cons qui lèchent",
          "rhyme":"ES",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'vois qu'tu t'attaches, yeux d'biche",
          "rhyme":"iS",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'mont'e pas ma gueule comme ces taches",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Checke les Stup-apaches qui se cachent dans les Appalaches",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Au fait, ça biche ?",
          "rhyme":"iS",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"T'aimes la fraîche",
          "rhyme":"ES",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Et tu t'sens les coudées franches",
          "rhyme":"#S",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Prends ça dans ta face et disparais sous l'avalanche",
          "rhyme":"#S",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABCCDBBDCEE",
      "rhyme_vowel":"AABCCDBBDCEE"
