      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Rap mort, squelette, étrange cérémonie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Mosh pit de fous, provoque la Stupégémonie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Des psalmodies sur cette boucle circulaire",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Circulez, y'a rien à faire, personne ne cautionne tout ce cirque, alors",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Bouge tes cartilages, je veux te voir te désosser, désaxer, sortir de ce corps et tout casser",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Tu penses qu'à ça",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"T'aimes les sons glauques comme un crustacé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"T'en as pas plus qu'assez, tu sais qu'c'est beaucoup plus que ça",
          "rhyme":"a",
          "persona_id":"kingju"
        }
      ],
