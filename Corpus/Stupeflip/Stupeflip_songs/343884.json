        },
        {
          "n":"3",
          "text":"J'ai trop envie de la posséder",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Trop agréable ! C'est une super matière",
          "rhyme":"ER",
