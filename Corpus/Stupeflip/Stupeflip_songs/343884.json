  "lyrics":[
    {
      "section_id":"section_0",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Je l'ai vu hier à Châtelet",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Il était beau derrière sa vitrine",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"On aurait dit qu'il me regardait",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'espère qu'il plaira à ma cousine",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Avec lui je serai plus fort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Il m'aidera dans les moments durs",
          "rhyme":"yR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Avec lui je frimerai à mort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Il m'aidera et guérira mes blessures",
          "rhyme":"yR",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABABCDCD",
      "rhyme_vowel":"ABABCDCD"
    },
    {
      "section_id":"section_1",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"J'ai vu dans ce magasin ce petit blouson en daim, j'irai l'essayer demain il me plait bien",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'ai vu dans ce magasin ce petit blouson en daim, ah ouais, ça ouais, je suis sûr qu'il m'ira bien",
          "rhyme":")",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AA",
      "rhyme_vowel":"AA"
    },
    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Ils font 79 euros",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Évidemment, ça ça fait un peu cher",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Mais le problème, ils sont supers beaux",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et niveau tunes c'est un peu la misère",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Le magasin était fermé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Depuis qu'j'les ai vus, j'ai trop hâte",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'ai trop envie de les essayer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Quand j'les aurai, je retrouverai la patate !",
          "rhyme":"at",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABABCDCD",
      "rhyme_vowel":"ABABCDCD"
    },
    {
      "section_id":"section_3",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"J'ai vu dans ce magasin cette paire de mocassins, j'les essayerai demain, ils me plaisent bien",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'ai vu dans ce magasin cette paire de mocassins, ah ouais, ça ouais, je suis sûr qu'ils m'iront bien",
          "rhyme":")",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AA",
      "rhyme_vowel":"AA"
    },
    {
      "section_id":"section_4",
