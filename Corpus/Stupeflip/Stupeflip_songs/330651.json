    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"J'ai trainé sur Internet, ça ma bousillé la cafetière",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"Ma vie est triste et morose, je suis souvent solitaire",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Je serai doux et attentif, avec toi je ferais des efforts",
          "rhyme":"OR",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"Je ne suis plus dépressif quand j'suis tout contre ton corps",
          "rhyme":"OR",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"AABB",
      "rhyme_vowel":"AABB"
    },
    {
