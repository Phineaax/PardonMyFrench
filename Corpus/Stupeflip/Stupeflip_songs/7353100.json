{"song_id": 7353100, "title": "Cimeti\u00e8re", "language": "fr", "lyricists": [55334], "lyrics": [{"section_id": "section_0", "type": "intro", "performer": "", "lines": [{"n": "0", "text": "- \"...d\u00e9but, l\u00e0, comme phrase...\"", "rhyme": "az", "persona_id": "kingju"}], "rhyme": "A", "rhyme_vowel": "A"}, {"section_id": "section_1", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "Je sors de terre comme dans un cimeti\u00e8re, fier", "rhyme": "e", "persona_id": "kingju"}, {"n": "1", "text": "Yeh", "rhyme": "e", "persona_id": "kingju"}, {"n": "2", "text": "Je sors de terre comme dans un cimeti\u00e8re, fier", "rhyme": "e", "persona_id": "kingju"}, {"n": "3", "text": "D'avoir d\u00e9couvert qu'i' faut plus r'garder en arri\u00e8re", "rhyme": "ER", "persona_id": "kingju"}, {"n": "4", "text": "Je pique le mic et m'applique", "rhyme": "ik", "persona_id": "kingju"}, {"n": "5", "text": "Mes r\u00e9pliques te plaquent et t'impliquent", "rhyme": "ik", "persona_id": "kingju"}, {"n": "6", "text": "Puisque plastique est mon physique", "rhyme": "ik", "persona_id": "kingju"}, {"n": "7", "text": "Waaaaw, je sais, tu ??di a?? rigolo (heuu)", "rhyme": "o", "persona_id": "kingju"}, {"n": "8", "text": "Je sors de t\u0435rre", "rhyme": "ER", "persona_id": "kingju"}, {"n": "9", "text": "J'suis enrag\u00e9 au micro", "rhyme": "o", "persona_id": "kingju"}, {"n": "10", "text": "Mes t\u0435xtes atypiques t'interpellent", "rhyme": "El", "persona_id": "kingju"}, {"n": "11", "text": "P\u00eale-m\u00eale, tel quel", "rhyme": "El", "persona_id": "kingju"}, {"n": "12", "text": "Mes mots malins te laissent un go\u00fbt de miel", "rhyme": "El", "persona_id": "kingju"}, {"n": "13", "text": "Mais fuis car je n'ai pas beaucoup dormi", "rhyme": "i", "persona_id": "kingju"}, {"n": "14", "text": "J'ai un Uzi, j'm'en suis pas servi", "rhyme": "i", "persona_id": "kingju"}, {"n": "15", "text": "Mais gaffe", "rhyme": "af", "persona_id": "kingju"}, {"n": "16", "text": "Je suis le genre de b\u00eate que l'on d\u00e9busque dans une f\u00eate", "rhyme": "Et", "persona_id": "kingju"}, {"n": "17", "text": "Compl\u00e8tement bourr\u00e9 en train d'voler des cacahu\u00e8tes", "rhyme": "Et", "persona_id": "kingju"}, {"n": "18", "text": "Comme King Ju, l'\u00e9pouvantable \u00e9pouvantail", "rhyme": "aj", "persona_id": "kingju"}, {"n": "19", "text": "Je sors de terre comme dans un cimeti\u00e8re", "rhyme": "ER", "persona_id": "kingju"}, {"n": "20", "text": "Et moi c'est King Ju, l'\u00e9pouvantable \u00e9pouvantail", "rhyme": "aj", "persona_id": "kingju"}], "rhyme": "AAABCCCDBDEEEFFGHHIBI", "rhyme_vowel": "AAABCCCDBDBBBCCEBBEBE"}, {"section_id": "section_2", "type": "outro", "performer": "", "lines": [{"n": "0", "text": "Je sors de terre comme dans un cimeti\u00e8re, fier", "rhyme": "e", "persona_id": "kingju"}, {"n": "1", "text": "Fier", "rhyme": "e", "persona_id": "kingju"}, {"n": "2", "text": "Fier", "rhyme": "e", "persona_id": "kingju"}, {"n": "3", "text": "- \"... t'as fait \"ro\", c'\u00e9tait bien- c'\u00e9tait bien le \"ro\", \"pique le mic\"...\"", "rhyme": "ik", "persona_id": "kingju"}], "rhyme": "AAAB", "rhyme_vowel": "AAAB"}], "album_id": 334025}