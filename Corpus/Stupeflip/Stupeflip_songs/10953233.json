{"song_id": 10953233, "title": "Croucrou Terror (Poltergeist)", "language": "fr", "lyricists": [55334], "lyrics": [{"section_id": "section_0", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "Le Stup une dictature molle", "rhyme": "Ol", "persona_id": "kingju"}, {"n": "1", "text": "Tu t'y agrippes quand \u00e7a va mal", "rhyme": "al", "persona_id": "kingju"}, {"n": "2", "text": "Provoque pas de demi-molle", "rhyme": "Ol", "persona_id": "kingju"}, {"n": "3", "text": "Et cette fois-ci \u00e7a va faire mal", "rhyme": "al", "persona_id": "kingju"}, {"n": "4", "text": "Parce que je mets dans le mille \u00e0 chaque fois", "rhyme": "a", "persona_id": "kingju"}, {"n": "5", "text": "Le Stup s'adresse \u00e0 chaque fan", "rhyme": "an", "persona_id": "kingju"}, {"n": "6", "text": "\u00c0 chaque femme qui plane et qui s'envole en deltaplane", "rhyme": "an", "persona_id": "kingju"}, {"n": "7", "text": "Le Crou est vaste, il t'aspire, il a la tronche \u00e0 Casper", "rhyme": "e", "persona_id": "kingju"}, {"n": "8", "text": "Y'en a qui pour r\u00e9ussir, tueraient p\u00e8re et m\u00e8re", "rhyme": "ER", "persona_id": "kingju"}, {"n": "9", "text": "Moi, j'suis dans la t\u00eate des gens, je n'y vois rien de normal", "rhyme": "al", "persona_id": "kingju"}, {"n": "10", "text": "Le Crou c't'un animal, Stup-ph\u00e9nom\u00e8ne paranormal", "rhyme": "al", "persona_id": "kingju"}], "rhyme": "ABABCDDEFBB", "rhyme_vowel": "ABABBBBCDBB"}, {"section_id": "section_1", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "1", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "2", "text": "Le Crou th\u00e9orise sans effort", "rhyme": "OR", "persona_id": "kingju"}, {"n": "3", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "4", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "5", "text": "Le Crou terrorise, les plus forts !", "rhyme": "OR", "persona_id": "kingju"}], "rhyme": "AAAAAA", "rhyme_vowel": "AAAAAA"}, {"section_id": "section_2", "type": "couplet", "performer": "", "lines": [{"n": "0", "text": "J't'\u00e9clates comme la terre cuite", "rhyme": "it", "persona_id": "kingju"}, {"n": "1", "text": "Quand j't'allumes au ball-trap", "rhyme": "ap", "persona_id": "kingju"}, {"n": "2", "text": "Les carottes sont cuites", "rhyme": "it", "persona_id": "kingju"}, {"n": "3", "text": "Mon style t'agresses comme un bad-trip", "rhyme": "ip", "persona_id": "kingju"}, {"n": "4", "text": "Les agressifs, j'en fais des tripes ou du salami", "rhyme": "i", "persona_id": "kingju"}, {"n": "5", "text": "J'suis Rascar Capac et mon mac est mon seul ami", "rhyme": "i", "persona_id": "kingju"}, {"n": "6", "text": "Car j'ai la niaque et j'suis pas rapano\u00efaque", "rhyme": "ak", "persona_id": "kingju"}, {"n": "7", "text": "Capuche d'Apoutsiak, mon style est dur comme un poil de Yak", "rhyme": "ak", "persona_id": "kingju"}, {"n": "8", "text": "T'approches pas gamin car j'ai du Gin dans le sang", "rhyme": "#", "persona_id": "kingju"}, {"n": "9", "text": "Au-del\u00e0 de nos diff\u00e9rences on se ressemble 100%", "rhyme": "#bl", "persona_id": "kingju"}], "rhyme": "ABACDDEEFG", "rhyme_vowel": "ABAAAABBCC"}, {"section_id": "section_3", "type": "refrain", "performer": "", "lines": [{"n": "0", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "1", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "2", "text": "Le Crou th\u00e9orise sans effort", "rhyme": "OR", "persona_id": "kingju"}, {"n": "3", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "4", "text": "Croucrou Terror", "rhyme": "OR", "persona_id": "kingju"}, {"n": "5", "text": "Le Crou terrorise, les plus forts !", "rhyme": "OR", "persona_id": "kingju"}], "rhyme": "AAAAAA", "rhyme_vowel": "AAAAAA"}], "album_id": 1253883}