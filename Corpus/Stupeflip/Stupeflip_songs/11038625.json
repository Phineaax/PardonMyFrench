          "n":"0",
          "text":"Attention Stup Virus",
          "rhyme":"ys",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Enlève-moi ce truc de la cervelle !",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"C'est impossible désolé ta été Stup intoxiqué",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Attention Stup Virus",
          "rhyme":"ys",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Comment je peux m'en débarrasser !",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Ya rien à faire désolé ta été Stup empoisonné",
          "rhyme":"e",
