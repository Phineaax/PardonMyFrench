  "lyrics":[
    {
      "section_id":"section_1",
      "type":"intro",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Je suis seul dans une grande maison hantée toute noire...",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'ai peur...",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'ai vraiment peur...",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'ai vu une bête...",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"J'entends des bruits...",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'entends des putains de bruits !",
          "rhyme":"i",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABBCDD",
      "rhyme_vowel":"ABBCDD"
    },
    {
      "section_id":"section_2",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Je suis le phénomène-omène, mélomane, stup-phénomène",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Pas d'blème, j'chie sur les bâtards, les malmène",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Je suis le stup-phénomène, mélo-mélomane, phénomène",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Pas d'blème, j'chie sur les bâtards, les malmène",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Je suis le phénomène-omène, mélomane, stup-phénomène",
          "rhyme":"En",
