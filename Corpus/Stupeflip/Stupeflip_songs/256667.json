      "lines":[
        {
          "n":"0",
          "text":"Ainsi font font font les petites marionnettes",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Les gens s'pètent la tête on les ramasse à la brouette",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Les litres de Get 27 se déversent",
          "rhyme":"ERs",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"La piste trempée comme après une grosse averse",
          "rhyme":"ERs",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Un gros truc qui crache, genre qui dégage les bronches",
          "rhyme":"$S",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Les trucs qui t'tranchent, genre qui t'agressent la tronche",
          "rhyme":"$S",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Ouais j'suis crade comme une sale fripe et gras comme une frite",
          "rhyme":"it",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Te frotte pas au Crou ou on t'cloue comme la grippe !",
          "rhyme":"ip",
