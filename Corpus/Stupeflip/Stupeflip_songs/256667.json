      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Eh ouais j'fais de l'art comme d'autres égorgent un porc",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'y vais au coupe-coupe j'continuerai jusqu'à la mort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Les gens semêm-xue rus ruomuh 'd sap tno' uq m'emmerdent à mort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Les gens qui jugent les gens au premier abord ont tort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Les artistes font leur promo sans prendre de risques",
          "rhyme":"isk",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Viennent tous les 3 ans pour un nouveau tour de piste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Mon nouveau concept featuring avec Priscilla",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Ça pulse au camping entre Alizée et Madonna !",
