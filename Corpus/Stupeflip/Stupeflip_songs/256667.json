      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Tu t'sens pas dans ton assiette ?",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Mon style en CRR, viens faire la fête !",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Est ce qu'y en a qui aiment les casse-têtes",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Sans queue ni tête ?",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"T'frotte pas au Crou ou on t'fracasse la cruche",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"On a l'crâne en friche trépané dès la crèche",
          "rhyme":"ES",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Tu t'sens pas dans ton assiette ?",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Mon style en crrr, viens faire la fête ! Est ce qu'y'en a qui aiment les casse-têtes",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Sans queue ni tête ?",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Ceux qui nous crachent dessus c'est des rats",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Allez plutôt cracher sur Hélagrh arrages",
          "rhyme":"aZ",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AAAABCAAADE",
      "rhyme_vowel":"AAAABAAAACC"
    },
    {
      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Mais moi j'aime bien la guitare électrique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'aime bien c'est grave, ça fout la triqueu",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'aime bien les CRRCRR qu'ça fait quand ça crache",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'aime bien quand ça s'fâche comme dans un groupe de thrash",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Un gros truc qui tache, genre qui arrache",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Un truc qui s'mâche, qui s'mouche et s'recrache",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Alors t'frotte pas au Crou, ou on t'fracasse la cruche",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"On a l'crâne en friche trépané dès la crèche",
          "rhyme":"ES",
