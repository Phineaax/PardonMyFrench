        },
        {
          "n":"7",
          "text":"Je vous souhaite une bonne écoute et vous retrouve avec plaisir après ce track",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Le Stup Crou c'est une mysterieuse formation active depuis 1999",
