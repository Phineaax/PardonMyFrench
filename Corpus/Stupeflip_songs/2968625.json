      "lines":[
        {
          "n":"0",
          "text":"Tu ris comme un fou quand tu cries pour le Crou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Ça te casses comme la Kro, dans le crom j'fais des trous",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Ta mâchoire s'décroche, quand tu hoches la caboche, mioche",
          "rhyme":"OS",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Rate pas le coche, pauv' tâche, on te lynche",
          "rhyme":"#S",
          "persona_id":"kingju"
