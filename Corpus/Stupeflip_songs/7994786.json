    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Tu me verras plus jamais sur scène",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'ai disparu comme les ruches",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'continue c'truc à l'arrache",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Dans ma piaule, je fais l'autruche",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"J'ai re- [bip] [bip] [bip] [bip] -na",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Car tout devenait complètement flou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"C'est sûr, j'ai toujours pas fait l'break",
          "rhyme":"Ek",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Mais dans le fond, je m'en contrefous",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"La poule aux œufs d'or a fait des œufs durs",
          "rhyme":"yR",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Fini la super bête de foire",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Sur l'industrie, je fais des ratures",
          "rhyme":"yR",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Me méfie des trucs trop fédérateurs",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"J'préfère rester dans mon canapé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"M'en bas les steaks si tu piges pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"C'est pas normal de s'exposer devant des gens que tu ne connais pas",
          "rhyme":"a",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCBDEFEGHGIJDD",
