    {
      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Une meuf à donf, look d'fantôme",
          "rhyme":"om",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Agite son boule devant les boomers",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Sous alcool, plus de douleurs",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Le DJ sent la sueur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Une horde de gargouilles farfouillent, tripotent les potards",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Dépassent les aigus d'bâtard",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Un son qui fout des cauchemars",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"La teuf est comme un cloaque moite",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Ambiance \"Alien - Number one\"",
          "rhyme":"On",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Des claviers genre Halloween",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"L'inverse de Balavoine",
          "rhyme":"an",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Une vieille dame qui jerke, part en trip",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Ses os s'craquent",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Son mec porte un masque Étrange Noël de monsieur Jack",
          "rhyme":"ak",
          "persona_id":"kingju"
        }
      ],
