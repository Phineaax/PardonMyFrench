      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Accroche-toi bien à ma taille avant qu'le matos ne dérouille",
          "rhyme":"uj",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Tes problèmes, on s'en bat les couilles",
          "rhyme":"uj",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Alors, finis ton verre de sky",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Béleu ba-ba-bai",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Béleu ba-ba-bai",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'vois qu'tu t'agites, le DJ grimace",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Basses dans ta face et des rictus bien dégueulasses",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Ça grouille de trucs dans la marmite",
          "rhyme":"it",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Quelques créatures crapotent",
          "rhyme":"Ot",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Ici, pas de flashes qui crépitent",
          "rhyme":"it",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"C'est sombre comme dans une grotte",
          "rhyme":"Ot",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Une sorcière ricane dans un style épileptique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"C'est la chenille qui redéraille, atmosphère apocalyptique",
          "rhyme":"ik",
          "persona_id":"kingju"
        }
      ],
