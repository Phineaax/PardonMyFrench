    {
      "section_id":"section_3",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"C'est pour les ??flip trucks?? qui sautent et les stremons qui partent en sucette",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Jamais ce truc ne s'arrête",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Y'a qu'les voisins qu'ça irrite",
          "rhyme":"it",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Mais qu'est-qu'c'est qu'ce truc qui pulse à mort, excite les globules (C'est Raggaloween !)",
          "rhyme":"yl",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Salsa du démon pour tes guiboles",
          "rhyme":"Ol",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Horreur ! Malheur ! Chaleur !",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"C'est pire que Thriller",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Ce truc qui pète est très lourd",
          "rhyme":"uR",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"T'as capté sur le trailer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Les esprits s'baladent trop longtemps emprisonnés",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"C'est la fête des morts !",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Les gateaux sont empoisonnés",
          "rhyme":"e",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABCDEEFGGHG",
