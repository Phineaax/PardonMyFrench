    },
    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"J'ai traîné sur Internet, ça m'a bousillé la cafetière",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"Ma vie est triste et morose, je suis souvent solitaire ('litaire, 'litaire, 'litaire)",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Je s'rai doué, attentif, avec toi je f'rai des efforts",
          "rhyme":"OR",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"Je ne suis plus dépressif quand j'suis tout contre ton corps (ton corps, ton corps, ton corps)",
          "rhyme":"OR",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"AABB",
