        },
        {
          "n":"7",
          "text":"Tcherno qui fume, 8.6, ça tourne en rond, ça n'a pas de sens",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Paradis artificiel, tous les jours je fais du sale",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"S'arrêter c'est difficile, continuer c'est suicidaire",
