      "lines":[
        {
          "n":"0",
          "text":"Je ne fais que des une-feuille",
          "rhyme":"9j",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Dans ma tête, je sens les failles",
          "rhyme":"aj",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'emmènerai dans mon cercueil un p'tit bout d'truc et de la thaï",
          "rhyme":"aj",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Je suis devant mon ordi et le temps s'est arrêté",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Je fais que des tourneries et jamais ça va s'arrêter",
