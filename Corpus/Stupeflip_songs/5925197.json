    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Homme pressé, tu presses les gens comme des citrons",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Vas-y dis moi qui t'es quand t'as plus ton look de patron",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Es-tu gentil avec ta femme ?",
          "rhyme":"am",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Qu'est-ce que tu racontes à tes enfants ?",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Est-ce qu'il te reste un peu de morale ?",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Comment t'ont élevé tes parents ?",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"On t'rit au nez à Rotterdam ou à Rio",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"T'es qu'un flan, du riz au lait même si tu te vends avec brio",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Allez va t'matter dans une glace",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Dis-moi ce que tu vois dans le reflet",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Est-ce un rapace ? Est-ce une limace ?",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Rappelle-toi quand t'étais mouflet",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"T'approche pas j'suis boule de nerfs",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"J'ai l'cervelet qui sent la guerre",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"T'as qu'à te taire car t'as tort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"Va t'enterrer six pieds sous terre",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"C'est ça bosse, bosse, bosse, coco !",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"Écrase toi et met ton orgueil au porte manteau",
          "rhyme":"o",
          "persona_id":"kingju"
        }
