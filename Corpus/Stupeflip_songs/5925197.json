    {
      "section_id":"section_1",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Ce son est peaufiné à la menuiserie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"C'est pas une histoire d'argent, ce savoir-faire n'a pas de prix",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Déjà tout petit on y avait réfléchi",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Le son du Crou pulse à mort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Y'a du boulot sur l'établi",
          "rhyme":"i",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AAABA",
      "rhyme_vowel":"AAABA"
    },
    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Maman s'il te plaît ne m'envoie plus à l'hôpital",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Je n'en peux plus je m'y sens mal",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Pas l'hôpital, pas l'hôpital",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Là-bas les gens sont trop bizarres",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Quand j'pense à eux j'fais des cauchemars",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Mentalement je n'ai pas d'retard",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Maman je ne veux plus les voir",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Je te jure que je suis plus fou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"C'était avant quand j'étais fou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"L'aut' fois ils voulaient me taper",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Je n'supporte pas l'anti poux",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Je t'en supplie les appelle pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Ils vont me sucer le cerveau",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Non maman non ne le fais pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Je serai doux comme un agneau",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"Ils me donnent des coups de trique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"Ils disent que je l'ai mérité",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"Ils me bourrent de barbituriques alors que je n'avais rien fait",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"18",
          "text":"S'il te plaît s'il te plaît",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"19",
          "text":"Tu sais bien qu'ils vont m'attacher",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"20",
          "text":"Maman je t'en supplie je ne veux plus y retourner",
          "rhyme":"e",
          "persona_id":"kingju"
        }
      ],
