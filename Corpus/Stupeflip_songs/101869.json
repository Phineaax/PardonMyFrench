      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"M.c.Salò part en vrille, complètement bourré",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Sky-whi à la main maint'nant ça va déchirer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"L'mec qu'habite là m'laisse passer c'que j'veux",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Il est plus comme avant : maint'nant il est très gentil",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Une fille qui m'snobait me dit qu'elle m'trouve super cool",
          "rhyme":"ul",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'l'écoute même pas et j'me r'sers de l'alcool",
          "rhyme":"Ol",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'mets les aigus à fond et j'me sers une pinte",
          "rhyme":")t",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Mais j'ai mis trop fort, putain j'ai pété les enceintes",
          "rhyme":")t",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABCDEFF",
      "rhyme_vowel":"AABCDEFF"
