      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Moi j'voulais faire un disque maison, sans maison de disque",
          "rhyme":"isk",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Un truc dingue, bizarre, noir en prenant des risques",
          "rhyme":"isk",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Objectif : instaurer la terreur sur la Terre",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Une rythmique de fer, et coup d'pied dans la fourmilière",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Y'en a qu'attendent la suite, persuadés qu'la source est tarie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Manque de bol : on revient fort encore plus tarés !",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Ça reste cracra comme une croûte qui suinte",
          "rhyme":")t",
          "persona_id":"kingju"
