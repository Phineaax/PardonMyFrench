        },
        {
          "n":"2",
          "text":"Le public rit, le public crie, « comique comique ah ah ah c'est un comique ! »",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Comique, le clown, l'acrobate comique",
          "rhyme":"ik",
