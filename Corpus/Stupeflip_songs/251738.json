          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"[Refrain : King Ju et Cadillac] x2",
          "rhyme":"iks",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Alors quoi quoi quoi ! Tu veux tester Stupeflip ?",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Le crou crou, la menuiserie et toute la clique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Alors quoi quoi ! Tu veux tester Stupeflip ? Le crou crou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"On est allé voir un spectac'",
          "rhyme":"ak",
