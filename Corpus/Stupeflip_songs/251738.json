      "lines":[
        {
          "n":"0",
          "text":"Alors quoi quoi, tu veux tester Stupeflip ? Flip",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Le gang des motards, la menuiserie et toute la clique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Rascar Capac revient dingue et les nerfs en boules",
          "rhyme":"ul",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Sur un truc qui crache, violent comme un coup de boule",
          "rhyme":"ul",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Un truc hystérique, l'antithèse du coup de fric",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Stup contre-attaque, violent comme un coup d'trique",
          "rhyme":"ik",
