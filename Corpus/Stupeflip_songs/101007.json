      "lines":[
        {
          "n":"0",
          "text":"Tu veux la patate qui défonce ?",
          "rhyme":"$s",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Le truc qui s’frotte avec les ronces",
          "rhyme":"$s",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Ton-car dans l’stick, écoute ce monstre",
          "rhyme":"$stR",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Écoute ce couteau qui s’enfonce !",
          "rhyme":"$s",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Le truc est vivant dans les têtes",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Même s’il est cramé dans les fnacs",
