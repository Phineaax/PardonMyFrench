      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Moi j’suis Reverb Man",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Et j’suis d’retour pour foutre la zone",
          "rhyme":"on",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Moi j’fais des ceintures de banane",
          "rhyme":"an",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et des trous dans la couche d’ozone",
          "rhyme":"on",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Continue à t’foutre de ma gueule",
          "rhyme":"9l",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Et j’te nique la tête au lance flamme",
          "rhyme":"am",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Mon style labo est bien débile",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Il te séduit comme une vieille femme",
          "rhyme":"am",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"J’ai bien quelques potes dans l’show-biz’",
          "rhyme":"iz",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Mais j’m’en méfie comme de la peste",
          "rhyme":"Est",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"J’suis obligé d’leur faire la bise",
          "rhyme":"iz",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Mais tout au fond d’moi j’les déteste",
          "rhyme":"Est",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Mon style c’est reverb au maxi",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Genre j’suis tombé au fond d’un trou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Ca m’donne un p’tit côté sexy",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"Dans un style moins grave que Garou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"T’fie pas à ma p’tite voix d’gamine",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"J’mesure deux mètres et j’ai une batte",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"18",
          "text":"Ca s’enchaîne a coups d’barre a mine",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"19",
          "text":"Et ça s’termine à grands coups de latte",
          "rhyme":"at",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCBDEFEGHGHIJIJKLKL",
      "rhyme_vowel":"ABCBDCECEFEFEGEGECEC"
