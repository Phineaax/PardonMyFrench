    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Quatre par quatre j’descend les marches avec la rage",
          "rhyme":"aZ",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"L.E.C.R.O.U s’réveille, tape dans les cages",
          "rhyme":"aZ",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Un liquide froid dans l’œsophage",
          "rhyme":"aZ",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Trois ans d’silence mais rien à foutre",
          "rhyme":"utR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Mon flow t’ravage comme l’Ebola",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"C’t’à s’demander qui l’encula",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Stup se réveille comme Dracula",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"J’ai toujours du sang plein la bouche",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Une vie d’cradingue avec les mouches",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"J’veux l’truc qui t’éclate la caboche",
          "rhyme":"OS",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Comme le CD qu’j’ai dans la poche",
          "rhyme":"OS",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"J’fais pas du ramassis d’variet’",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Ça serre aux tempes comme une casquette",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Sourds aux attaques, je tisse ma toile",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Seul dans mon squat comme une mygale",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"Le truc est vivant dans les têtes",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"Même s’il est cramé dans les fnacs",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"Les p’tits d’seize ans trippent dans les fêtes",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"18",
          "text":"L’envie d’becqu’ter comme un big mac",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"19",
          "text":"Mon son s’insinue dans les tripes",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"20",
          "text":"West Annexion, Crou stupeflip",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"21",
          "text":"Ton-car dans l’stick, pathétique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"22",
          "text":"72 une date hystérique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"23",
          "text":"Comme une urgence, ça file rapide",
          "rhyme":"id",
          "persona_id":"kingju"
        },
        {
          "n":"24",
          "text":"Sirène strident, d'baston futile",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"25",
          "text":"Les mecs se carapatent facile",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"26",
          "text":"Face à l’armée des druides fossiles",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"27",
          "text":"Autour de moi ça part en slim",
          "rhyme":"im",
          "persona_id":"kingju"
        },
        {
          "n":"28",
          "text":"Nouvelle génération d’connasses",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"29",
          "text":"Face à ces fils de putes qui sucent",
          "rhyme":"ys",
          "persona_id":"kingju"
        },
        {
          "n":"30",
          "text":"Moi j’peux m’regarder dans une glace !",
          "rhyme":"as",
          "persona_id":"kingju"
        }
      ],
