    },
    {
      "section_id":"section_6",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Tu tapes dans le fiacre, crac, crac, gratte le fond",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"T'envoûtes les gamines, formidable, pas un rond",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Même si t'es pas riche, t'es mignon, tends l'oignon",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Ça racle les tiroirs, tous les soirs, dans le noir",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Ta p'tite gueule de mec, tranchée, paf paf, fais-le tard",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Folle de ton p'tit corps, du sport, sans effort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"T'es l'ténor qui bouillave à mort, dans l'plumard",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Je suis dans ta grotte, grotte, grotte, ça résonne",
