      "lines":[
        {
          "n":"0",
          "text":"— Hé, c'est pas grave",
          "rhyme":"av",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"— Laisse tomber, j'te dis !",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"— Allez viens, on prend l'métro",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"— Mais puisque j'te dis de m'laisser tranquille !",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"— Allez, Cadillac",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"— T'as rien compris !",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"— Allez viens, Cadillac",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"— Mais qu'est-ce que tu m'racontes ? Pourquoi ?",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"— Faut qu’t'y fasse",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"— Non mais dis-moi, MC Salo. Explique-moi qu'est-ce qui s'passe",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"— Écoute, j'en sais pas plus que toi, Cadillac",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"— Mais qu'est-ce qu'on nous fait",
          "rhyme":"E",
          "persona_id":"kingju"
        }
