    {
      "section_id":"section_3",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Stup Virus, truc vorace, fuite de son qui te laisse des puces",
          "rhyme":"ys",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Le son te ronge la carapace, c'est l'infarctus, sa laisse des traces",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Ton sang s'imbibe de Stupeflip, nouvel album toujours pas de flop",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"C'est pas de la pop c'est tip top et ce truc n'a pas d'antidote",
          "rhyme":"Ot",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Stup Virus, sa fout la frousse, mais sur youteub vert est le pouce",
          "rhyme":"us",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"La bave au lèvre tu fais de la mousse, y'a le bouton replay qui trépasse",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"« Le Stup Virus » truc atroce, sa te laisse sans connaissance",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Ta liste Spotify infectée par la Stup Danse",
          "rhyme":"#s",
          "persona_id":"kingju"
        }
      ],
