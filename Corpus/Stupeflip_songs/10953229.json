      ],
      "rhyme":"AAAA",
      "rhyme_vowel":"AAAA"
    },
    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Bordel, bordel, j'aime ta compagnie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'aime ta chaleur, ta couleur et ton esprit",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'aime quand tu dessines des p'tits paysages",
          "rhyme":"aZ",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'aime quand l'yaourt s'transforme en fromage",
          "rhyme":"aZ",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"C'est jamais ennuyeux, c'est jamais la même chose",
          "rhyme":"oz",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Même si ça sent pas la rose",
          "rhyme":"oz",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"La sauce tomate sur les murs, mais c'est pas grave",
          "rhyme":"av",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Puis c'est pas d'ma faute si les éponges ont fait la grève",
          "rhyme":"Ev",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Mets-toi à l'aise, j'te prépare un café",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Mais non j'vais pas t'intoxiquer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Il t'fout l'cafard mon capharnaüm ?",
          "rhyme":"Om",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Mais c't'une œuvre d'art pour le MET Museum",
          "rhyme":"2m",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABBCCDEFFGH",
      "rhyme_vowel":"AABBCCBDEEFG"
    },
