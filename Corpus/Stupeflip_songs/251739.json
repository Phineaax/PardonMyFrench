          "n":"0",
          "text":"La religion du Stup",
          "rhyme":"yp",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Je suis prête à me sacrifier pour la religion du Stup",
          "rhyme":"yp",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Je ferai tout ce qu'il me demandera",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Jusqu'à donner ta vie ?",
          "rhyme":"i",
