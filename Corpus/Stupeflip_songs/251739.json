      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"La journaliste qui pleure, une femme dans la douleur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Un enfant mort de peur, qui s'exprime dans la terreur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Stup Crou, avec l'énigme pour emblème",
          "rhyme":"Em",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Une armée de dingues, motivés par la peine",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"C'est l'exception et de la compassion",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Pour la seule religion qui fait naître des vocations",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"La caisse claire claque et fait son travail de sape",
          "rhyme":"ap",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Les neurones s’arrêtent, c'est Stup qui tape",
          "rhyme":"ap",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABCDDEE",
