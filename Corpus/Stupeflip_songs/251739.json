    {
      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Le stup monastère est maintenant plongé dans le noir",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Le son du Crou se multiplie comme une bande de cafards",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Une religion, comme un discours de Raël",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"À genoux, les petits enfants devant le père Noël",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"La pupille dilatée, les adeptes en transe",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Les gens prosternés saisissent le Crou comme une chance",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Stupéfiant, le truc t'obsède et tout s'efface",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Les humains flippent, les annexions laissent des traces",
          "rhyme":"as",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABBCCDD",
      "rhyme_vowel":"AABBCCAA"
