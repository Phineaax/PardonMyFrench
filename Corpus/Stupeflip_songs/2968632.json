    {
      "section_id":"section_6",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Je suis l'altruiste, lyriciste, qui fiste, les fils de",
          "rhyme":"@",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Cyber-Aqua bonniste, ma force est dans cette liste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'résiste, j'assiste, influence dadaïste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'existe, persiste, un STUP radiesthésiste (You know the CROU)",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Alchimiste, puriste, tendance bisounoursiste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Number one sur ta liste, de la boucle un spécialiste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Nihiliste, cubiste, autiste, guitariste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"L’existence est si triste, encore pire que la peste",
          "rhyme":"Est",
          "persona_id":"kingju"
        }
      ],
