        {
          "n":"0",
          "text":"Salaud de droite",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"T'as 35 ans tu vis à Neuilly",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Le soir avec tes amis, tu t'éclates dans les rallyes",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Tu flippes pour tes deux bagnoles",
          "rhyme":"Ol",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Ta résidence secondaire",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Je veux te voir te faire latter sur un quai de RER",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Salaud de droite",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"T'es vieux et t'as la haine des jeunes",
          "rhyme":"9n",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"T'as connu les 30 glorieuses pour toi c'était bien plus fun",
          "rhyme":"yn",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"T'appelles sans arrêt les flics",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Parce que ta vie est trop vide",
          "rhyme":"id",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Et dans la bouffe de ton caniche, j'foutrais bien du pesticide",
          "rhyme":"id",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABBCDEAFGHII",
      "rhyme_vowel":"ABBCDEAFGBBB"
