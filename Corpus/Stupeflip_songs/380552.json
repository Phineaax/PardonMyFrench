        },
        {
          "n":"3",
          "text":"Tu veux une société de l'effort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Mais toi t'auras du boulot",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Placé par papa-maman",
          "rhyme":"#",
