      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"C'que j'décris, je l'crie et c'est l'secret d'ma secte",
          "rhyme":"Ekt",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Mes textes claquent, t'agacent comme un insecte",
