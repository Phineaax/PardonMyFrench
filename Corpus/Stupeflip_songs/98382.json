      "lines":[
        {
          "n":"0",
          "text":"Stupeflip Stupeflip c'est l'truc stupéfiant",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Beaucoup d'travail comme pour un album d'Astérix",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Stupeflip Stupeflip c'est l'truc stupéfiant",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Ça t'agrippe, ça t'attrape et ça fait pas d'sentiments",
          "rhyme":"#",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABAA",
      "rhyme_vowel":"ABAA"
    },
    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Stupeflip Stupeflip qu'est ce que c'est qu'ce truc?",
          "rhyme":"yk",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Ca t'prend par la croupe et te r'tourne comme une crêpe",
          "rhyme":"Ep",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"C'est l'truc trapu qui prend aux tripes",
          "rhyme":"ip",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"T'AS PAS COMPRIS?",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Stupeflip tape comme un type devenu aigri",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Ca vient d'nulle part et ça t'file un coup d'barre",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Ca c'est pour les couche-tard qu'ont toujours envie d'boire",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"C'est cru, ça craque, ça saute et ça s'accroît",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Moi c'est Stup, moi c'est Flip, à chacun sa croix",
          "rhyme":"a",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCDDEEFF",
