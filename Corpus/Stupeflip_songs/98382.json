      "lines":[
        {
          "n":"0",
          "text":"Tu veux une petite démonstration?",
          "rhyme":"$",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Ouais",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"OK... J'vais t'montrer...",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'suis un p'tit peu rouillé...",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Ca fait longtemps qu'j'ai pas joué...",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Attends, voyons voir...",
          "rhyme":"aR",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCCCD",
      "rhyme_vowel":"ABCCCD"
    },
