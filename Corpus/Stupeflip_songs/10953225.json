    {
      "section_id":"section_5",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"La bastastelia n'en a pas fini de souffrir",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Nos divisions tuent n'ayons pas à en rougir",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Nous sommes différents nos idées sont aux antipodes",
          "rhyme":"Od",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Oui nous les punirons ils ne sont que gastéropodes",
          "rhyme":"Od",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Ils partent en randonnée sans attendre les plus faibles",
          "rhyme":"Ebl",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Ne respectent rien, ni le blé, ni le seigle",
          "rhyme":"Egl",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Tellement facile de faire appel aux bas instincts",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Nous les traduirons au sein du Sinode Pibouin",
          "rhyme":")",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABBCDEE",
      "rhyme_vowel":"AABBCCDD"
