    {
      "section_id":"section_7",
      "type":"outro",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"(Haaaaaaaaaaa !)",
          "rhyme":null,
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"(Haaaaaaaaaaa !)",
          "rhyme":null,
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Je suis dans une veine !",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Je pulse dans ta carotide !",
          "rhyme":"id",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Et pourtant c'est chacun pour sa peau !",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"(Yeaaaah !)",
          "rhyme":null,
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'ai tout compris maintenant !",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Absolument tout !",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Et j'ai qu'un seul l'objectif :",
          "rhyme":"if",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Ne faire chier personne !",
          "rhyme":"On",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Y'a tellement d'gens qui croient détenir la vérité !",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Genre moi j'détiens la vérité !",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Mais tu détiens rien du tout !",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"La seule vérité c'est qu'tu vas [bruits de tir de fusil d'assaut]",
          "rhyme":"o",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABCDAEFGHIIFD",
