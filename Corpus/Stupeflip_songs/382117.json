      "lines":[
        {
          "n":"0",
          "text":"Le règlement de votre facture",
          "rhyme":"yR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Du 14\/10\/2003 d'un montant de 168,45 euros",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Ne nous est pas encore parvenu",
          "rhyme":"y",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Sans nouvelles de votre part avant le 17\/11\/2003",
          "rhyme":"@",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Nous serions malheureusement dans l'obligation de limiter très fortement nos fournitures ou de les suspendre",
