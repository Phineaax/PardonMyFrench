  "lyrics":[
    {
      "section_id":"section_0",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Argent,  mon ami, tu n'es pas très fidèle",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Et tu n'es pas souvent là quand j'ai vraiment besoin de toi",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Mais où es-tu Argent quand mon frigo fait pipi ?",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Quand j'ai beaucoup trop perçu mon ami le RMI",
          "rhyme":"i",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABCC",
      "rhyme_vowel":"ABCC"
    },
    {
      "section_id":"section_1",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Argent, je t'aurais avec ta couleur bizarre",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Sans que j'ai à faire le canard",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Regarde moi je ne suis pas transparent",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et prends un air intelligent",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Argent Argen-ent",
          "rhyme":"#",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABBB",
      "rhyme_vowel":"AABBB"
    },
    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Argent, je te remarque quand t'es plus avec moi",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Mais la plupart du temps, j'en ai rien à foutre de toi",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Tu t'incrustes dans ma tête pourtant j'tai pas invité",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et tu m'as bien nargué les jours où j'ai pas pu payer",
          "rhyme":"e",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABB",
      "rhyme_vowel":"AABB"
    },
