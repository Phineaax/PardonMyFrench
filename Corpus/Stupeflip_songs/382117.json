      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Argent pov' nul, tu m'fais un peu pitié",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Pi t'as pas l'air très malin vec' ta dégaine en papier",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Alors rampe comme un chien et surtout excuse-toi",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Toute façon t’existeras plus quand j'aurais plus besoin d'toi",
          "rhyme":"a",
          "persona_id":"kingju"
        }
