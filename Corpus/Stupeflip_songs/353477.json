      "lines":[
        {
          "n":"0",
          "text":"Quatre cent soixante-dix moins douze égal treize",
          "rhyme":"Ez",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Divisé par sept égal sept cent soixante-seize",
          "rhyme":"Ez",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Sept cent soixante-seize moins quinze égal vingt",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Vingt plus rien égale neuf cent quatre-vingt",
          "rhyme":")",
