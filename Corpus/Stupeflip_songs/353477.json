      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Ils collent à mes yeux",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Ils marchent sur mes cheveux",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Sillonnent dans mon cou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Ils me prennent pour un joujou",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Les garçons, les mecs, c'est toujours pareil",
          "rhyme":"Ej",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Dieu n'a pas fait de paupières pour les oreilles",
          "rhyme":"Ej",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABBCC",
