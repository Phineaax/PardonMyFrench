    },
    {
      "section_id":"section_6",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Moi c'est Reverb-man j'ai d'la réverbe dans la voix",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"C'est un style à moi qu'aucun autre gars a",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'aime bien la reverbe ça m'donne de la profondeur",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Comme Mylène Farmer",
          "rhyme":"9R",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABB",
      "rhyme_vowel":"AABB"
    },
    {
      "section_id":"section_7",
      "type":"kingju",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Avant un putain d'concert, j'suis vraiment trop flippé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Et après un putain d'concert j'suis qu'un chanteur abandonné",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"La vie d'musicien elle est vraiment pas belle",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Dans les chambres d'Hôtel y'a des  photocops d'aquarelles",
          "rhyme":"El",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABB",
