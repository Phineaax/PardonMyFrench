    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Moi c'est Sado-modo, tranquillo, cent-trente kilos d'viande de veau",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Les cheeses dans mon ventre pèsent lourd comme un sac à dos",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'suis de l'époque du Wu, Ice Cube, pas des rigolos",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'digère le bon son : Big Du, pas Calozéro",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Pas rasé, gros zéro, muchacho en pancho",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Cool avec les gos, sans gros mots",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Besame mucho, punch coco, poule au pot, style Celentano",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"J'peux être intello même si plat est mon encéphalo (Yeah)",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Pas d'allo maman bobo, pas d'problème d'égo",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Sado-modo est réglo, j'me sens lourd, menthe à l'eau",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Sueur qui coule, slow tempo, pas d'alu même si fait chaud",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Toujours classe en pédalo",
          "rhyme":"o",
          "persona_id":"kingju"
        }
