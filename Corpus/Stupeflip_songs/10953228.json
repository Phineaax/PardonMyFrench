      "lines":[
        {
          "n":"0",
          "text":"Ils sont comme des serpents, ils pissent sur mes sentiments",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Incroyables cons et dans mon cou ils plantent leurs dents",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"De quoi devenir paranoïde",
          "rhyme":"id",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Pov' nazes, z'ont la haine",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Font chier bourrés sous stéroïdes",
          "rhyme":"id",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Arrogants, ils s'la jouent testostérone",
          "rhyme":"On",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Va falloir lâcher l'affaire (le membre caché du)",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Ils sont jaloux",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Ils observent leurs voisins",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Z'ont pas envie de les voir heureux, cette seule vision lеs rend zinzins",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Ça les renvoiе à leur triste réalité",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Vie d'merde, taf de merde, du cervelas dans l'cervelet",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Z'ont du flamby dans l'slop",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Bande de salopes",
          "rhyme":"Op",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Faut qu'ils restent tranquilles ou j'les découpe comme une escalope",
          "rhyme":"Op",
          "persona_id":"kingju"
        }
      ],
