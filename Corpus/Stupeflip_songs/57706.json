    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Arrête de crier, j'ai les oreilles qui sifflent",
          "rhyme":"ifl",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Arrête de pleurer quand les animaux souffrent",
          "rhyme":"ufR",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Tu vois bien, le Crou avance masqué",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Les anciens gentils sont devenus détraqués",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"J'ai vu les fans du Stup, la flamme dans leurs yeux",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'ai vu un être humain qui essayait d'être heureux",
          "rhyme":"2",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'ai vu la région Sud écrasée sous le soleil",
          "rhyme":"Ej",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"J'ai vu les moines du Stup prier dans leur sommeil",
          "rhyme":"Ej",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"J'entends les guerriers qui avancent",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Des cris dans la nuit",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Les autistes pleurent et le silence fait du bruit",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"L'ère du Stup, pas si humoristique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Donne-moi de l'argent, du courage et du plastique",
          "rhyme":"ik",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"Les humains sont amers",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"La musique s'amplifie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"Les Argémiones ont attaqué par défi",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"Les régions fédérées, créées dans la lumière",
          "rhyme":"ER",
          "persona_id":"kingju"
        },
        {
          "n":"17",
