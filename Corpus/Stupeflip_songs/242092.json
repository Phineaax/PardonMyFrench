        },
        {
          "n":"10",
          "text":"Et je suis ressuscité !",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"Et je viens me vengeeer !",
          "rhyme":"ER",
