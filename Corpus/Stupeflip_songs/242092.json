    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"King Ju s'exprime, c'est la déprime qui prime",
          "rhyme":"im",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'ai pas bonne mine",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Parce que je suis bourré d'aspirines",
          "rhyme":"in",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Je n'ai pas l'habitude des moments où j'ai le moral",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Comme J.R. Ewing, j'suis un rat, j'suis pas normal",
          "rhyme":"al",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Alors gaffe, gaffe à l'affalé qui falsifie ses dires",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Mais gaffe, gaffe au fou furieux qui s'fait les pires délires",
          "rhyme":"iR",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Bon, j'suis le genre de bête",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Qu'on débusque que dans une fête",
          "rhyme":"Et",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Glauque",
          "rhyme":"ok",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Non... je touche pas à la coke",
          "rhyme":"ok",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABBCCDDEEFF",
      "rhyme_vowel":"AAABBAACCDD"
