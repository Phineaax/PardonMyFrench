      ],
      "rhyme":"ABCAD",
      "rhyme_vowel":"ABCAA"
    },
    {
      "section_id":"section_2",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Toujours pas de meuf, pas de taf, pas de bouffe",
          "rhyme":"uf",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Les factures s'amoncellent",
          "rhyme":"El",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Moi j'étouffe, scotché sur mon pouf",
          "rhyme":"uf",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'suis trop mef'",
          "rhyme":"Ef",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Je descend plein d'Leffe qui m'fracasse la carcasse",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'brûle, du tcherno dégueulasse (bah !)",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"King Ju number one, te fie pas à ma tronche",
          "rhyme":"$S",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"L'habit fait pas le moine, j'ai du sang plein la bouche",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"En zig-zag j'évolue, v'là l'veule vilain !",
          "rhyme":")",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Le zazou qui zone dans la ZUP naze et qui fout rien",
          "rhyme":")",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"ABACDDEFGG",
      "rhyme_vowel":"ABABCCDAEE"
