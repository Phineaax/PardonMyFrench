    {
      "section_id":"section_6",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Alors viens faire un tour dans mon cloaque moite",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"24 sur 24, dans mon squat",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'bouffe des pâtes et des boîtes",
          "rhyme":"at",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'me touche, sous la douche",
          "rhyme":"uS",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"En lisant Hot Vidéo",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Pour 40 boules, tu peux zieuter les p'tites photos",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'suis une tâche, un pourri, un raté",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"J'ai passé trop d'temps à me demander comment faire pour ne rien glander",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"J'suis malade tout le temps",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"C'est pour ça que j'ingurgite p-p-p-pplein de médicaments",
          "rhyme":"#",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AAABCCDDEE",
