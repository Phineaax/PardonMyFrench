    {
      "section_id":"section_8",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Bouffe le mic, ça fait (Aaaaahhh !)",
          "rhyme":"E",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Appelle-moi King Ju l'toqué",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Ou bien Rascar Capac",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"J'suis l'andouille qui boit du 'sky",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"J'ai des couilles quand j'braille",
          "rhyme":"aj",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'aime bien Greg Nice, et la zique de San Ku Kaï",
          "rhyme":"aj",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'suis l'genre de bête qui n'supporte pas le soleil",
          "rhyme":"Ej",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Je bouge de fête en fête sans jamais trouver l'sommeil",
          "rhyme":"Ej",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Le soir dans Paris, on me prend pour un OVNI",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"J'ai pas trop de thunes : j'ai besoin du RMI",
          "rhyme":"i",
          "persona_id":"kingju"
        }
      ],
