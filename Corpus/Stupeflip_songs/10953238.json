    {
      "section_id":"section_5",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Tu me verras plus jamais sur scène",
          "rhyme":"En",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"J'ai disparu comme les ruches",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"J'continue mon truc à l'arrache",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Seul dans ma piaule, je fais l'autruche",
          "rhyme":"yS",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"J'préfère rester dans mon canapé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"M'en bas les steaks si tu piges pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"C'est pas normal de s'exposer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Devant des gens que tu ne connais pas",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"La poule aux œufs d'or a fait des œufs durs",
          "rhyme":"yR",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Fini la super bête de foire",
          "rhyme":"aR",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Sur l'industrie, j'fais des ratures",
          "rhyme":"yR",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"J'évite les trucs federateurs",
          "rhyme":"9R",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"J'bosse à la menuisserie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"J'fais dans la bisounourserie",
          "rhyme":"i",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Et les tarés d'la bourserie, tous cramés dès la nurserie (serie, serie, ...)",
          "rhyme":"i",
          "persona_id":"kingju"
        }
      ],
