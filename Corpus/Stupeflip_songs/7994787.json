  "lyrics":[
    {
      "section_id":"section_0",
      "type":"intro",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"\"Mais, moi, j'aime bien aussi, Pop-Hip",
          "rhyme":"ip",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"Et puis, il est mort mais il faudrait le ressusciter",
          "rhyme":"e",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"Pourquoi tu ressuscites pas Pop-Hip ?\"",
          "rhyme":"ip",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"Pop-Hip",
          "rhyme":"ip",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"4",
          "text":"Réveille-toi",
          "rhyme":"a",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"ABAAC",
      "rhyme_vowel":"ABAAC"
    },
    {
      "section_id":"section_1",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Perdu dans mon enfer, j'reçois, du monastère",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"Des menaces, des SMS",
          "rhyme":"Om",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"J'visais le haut d'l'affiche, faire de la variétoche",
          "rhyme":"OS",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"À l'abri dans ma forteresse",
          "rhyme":"Es",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"4",
          "text":"J'ai pourri les albums 'vec mes sous qui t'assoment",
          "rhyme":"um",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"5",
          "text":"Bubble gum",
          "rhyme":"Om",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"6",
          "text":"J'voulais pas faire mal",
          "rhyme":"al",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"7",
          "text":"Mais j'ai vendu mon âme, c'est la gloire qui m'anime",
          "rhyme":"im",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"8",
          "text":"J'ai visé l'international",
          "rhyme":"al",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"ABCDEBFGF",
      "rhyme_vowel":"ABBACBDED"
    },
    {
      "section_id":"section_2",
      "type":"refrain",
      "performer":"",
      "lines":[
        {
