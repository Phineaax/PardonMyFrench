        }
      ],
      "rhyme":"AAAA",
      "rhyme_vowel":"AAAA"
    },
    {
      "section_id":"section_3",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"En enfer, je m'ennuie, dans la lave, je me noie",
          "rhyme":"a",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"1",
          "text":"Plus de fête",
          "rhyme":"Et",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"2",
          "text":"J'ai des hématomes",
          "rhyme":"om",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"3",
          "text":"J'voulais sauver mon âme pour éviter les drames",
          "rhyme":"am",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"4",
          "text":"Mais, la nuit, j'erre comme un fantôme",
          "rhyme":"om",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"5",
          "text":"J'voudrais ressusciter, être dans le Top 50",
          "rhyme":"Op",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"6",
          "text":"Faire le buzz",
          "rhyme":"az",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"7",
          "text":"Revenir sur Terre",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"8",
          "text":"Ma tête est mise à prix dans 3 systèmes solaires",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        },
        {
          "n":"9",
          "text":"J'connais pas les commanditaires",
          "rhyme":"ER",
          "persona":"pophip",
          "persona_id":"pophip"
        }
      ],
      "rhyme":"ABCDCEFGGG",
