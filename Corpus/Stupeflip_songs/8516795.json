    {
      "section_id":"section_1",
      "type":"refain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Tu veux des lyrics qui tachent à base de gros coups d'cravache ?",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Stupeflip Crou !",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Voilà le son qui fout des coups",
          "rhyme":"u",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Tu veux des lyrics qui tachent, un truc qui ruine à la hache ?",
          "rhyme":"aS",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Moi c'est King Ju l'toqué",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"La crème de la crème",
          "rhyme":"Em",
