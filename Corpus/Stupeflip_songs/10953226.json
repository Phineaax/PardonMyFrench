      "rhyme":"ABAAABAA",
      "rhyme_vowel":"ABAAABAA"
    },
    {
      "section_id":"section_3",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Les zig aïe, je les zigouille, je les nique j'en fait des bonzaïs",
          "rhyme":"aj",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Et les canailles, se taillent quand le CROU pose avec ses entrailles",
          "rhyme":"aj",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Les 60' c'était naze, je préfère Ilie Năstase",
          "rhyme":"az",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Les phases de Frukwan, Geto Boys ou les Gravediggaz",
          "rhyme":"az",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"J'suis à l'aise en cortèze, tue comme en 93",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"J'suis king'ju l'fossile celui qui rap avec ses prothèses",
          "rhyme":"Ez",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"J'suis le croc-mort, trop flippant, l'épouvantail mort-vivant",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"L'égocentrique freak qui nique ta clique se barre en s'marrant",
          "rhyme":"#",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AABBCDCC",
      "rhyme_vowel":"AAAABCBB"
    },
    {
