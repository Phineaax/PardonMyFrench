      "type":"refrain",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"On est le Flip Flip Crou, terroriste bienveillant",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Les autres trucs c'est chiant, va falloir vous réveiller",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Car nous sommes l'Understup, la ligue anti-réactionnaire",
          "rhyme":"ER",
