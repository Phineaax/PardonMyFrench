      "lines":[
        {
          "n":"0",
          "text":"J'exècre la rumba",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Mon truc, c’est d’la bomba",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"C’est la dèr' des dèr' que j'ressors de ma tomba",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Encore un coup de crasse et j’te rosse à coup d’crosse",
          "rhyme":"Os",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"V’la l’molosse, pas l’bolosse",
          "rhyme":"Os",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"Qui fait peur aux rhinocéros",
          "rhyme":"Os",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Trop la classe",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"La rythmique tabasse dans l’espace",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Et les rapaces trépassent sous les secousses de ma carcasse",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Trop d’la balle, trop maboule",
          "rhyme":"ul",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"Farandole de nerfs en boule, cool",
          "rhyme":"ul",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"J’agresse la foule et fais peur même aux cannibales",
          "rhyme":"al",
          "persona_id":"kingju"
        }
      ],
      "rhyme":"AAABBBCCCDDE",
      "rhyme_vowel":"AAABBBAAACCA"
