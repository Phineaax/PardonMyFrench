        },
        {
          "n":"3",
          "text":"Voilà venir le clavier\"",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"La combinaison d’son donne ce truc hystérique",
          "rhyme":"ik",
