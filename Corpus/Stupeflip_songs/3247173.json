      "lines":[
        {
          "n":"0",
          "text":"L'épouvantable épouvantail est dans la place",
          "rhyme":"as",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Tu te sens ballonné, t'es pâlot là",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Faudrait qu'un skeud pour nous déboulonner",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Du boulot ? Nan",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"La menuiserie revient te pilonner",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"La rythmique te plaque",
          "rhyme":"ak",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Ce son qui tue ne t'a pas couillonné",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"C'est bouillonnant, déjà mort",
          "rhyme":"OR",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Comme un revenant, j'suis revenu",
          "rhyme":"y",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Foutre le dawa pas pour les revenus",
          "rhyme":"y",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"T'es ravi là",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"J'te vois bouger t'es sur la piste là, tu kiffes là",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"Mets-toi ça en boucle et boucle-la",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"\"Clac !\" fait le verre en tombant sur le lino",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"C'est la Stup-Stup clique mais on a pas de limo",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"On est les as de la transe-danse",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"Toujours en cadence, ça balance",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"J'entends le bruit des ambulances",
          "rhyme":"#s",
          "persona_id":"kingju"
        },
        {
          "n":"18",
          "text":"On a le total respect pour toutes les zouzs et les minots",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"19",
          "text":"Cette fois-ci plus de Pop-Hip car il s'est fait éliminer",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"20",
          "text":"C'est le branle-bas d'combat",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"21",
          "text":"On est toujours dans la course",
          "rhyme":"uRs",
          "persona_id":"kingju"
        },
        {
          "n":"22",
          "text":"Et fuck les bâtards qui nous traiteront de Bisounours",
          "rhyme":"uRs",
          "persona_id":"kingju"
        }
      ],
