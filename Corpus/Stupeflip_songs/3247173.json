    {
      "section_id":"section_4",
      "type":"couplet",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"J'suis c'triste autiste, Stup-lyriciste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"1",
          "text":"Triste antéchrist qui fiste les fils de...",
          "rhyme":"@",
          "persona_id":"kingju"
        },
        {
          "n":"2",
          "text":"Ma force, elle est dans ces pistes",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"3",
          "text":"Et ces sons d'fous font flipper les radiesthésistes",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"4",
          "text":"Pourquoi tu insistes ?",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"5",
          "text":"La vie est si triste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"6",
          "text":"Check un peu ma carte aquoiboniste",
          "rhyme":"ist",
          "persona_id":"kingju"
        },
        {
          "n":"7",
          "text":"Triste terroriste, encore pire que la peste",
          "rhyme":"Est",
          "persona_id":"kingju"
        },
        {
          "n":"8",
          "text":"Contre les greedies qu'auraient trahi les manifestes j'peste",
          "rhyme":"Est",
          "persona_id":"kingju"
        },
        {
          "n":"9",
          "text":"Stup Crou ! Incrompréhensible, clairvoyant",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"10",
          "text":"La zik c'est pas dévoyé",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"11",
          "text":"N'oublie pas les non-voyants",
          "rhyme":"#",
          "persona_id":"kingju"
        },
        {
          "n":"12",
          "text":"On est hyper gentils, super-super-super cool",
          "rhyme":"ul",
          "persona_id":"kingju"
        },
        {
          "n":"13",
          "text":"On est doux comme des p'tits chats",
          "rhyme":"a",
          "persona_id":"kingju"
        },
        {
          "n":"14",
          "text":"Beaucoup plus sympas qu'les aut'",
          "rhyme":"o",
          "persona_id":"kingju"
        },
        {
          "n":"15",
          "text":"On est super marrants, toujours tranquille",
          "rhyme":"il",
          "persona_id":"kingju"
        },
        {
          "n":"16",
          "text":"Très posés (et on s'énerve jamais !)",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"17",
          "text":"Car il faut jamais s'énerver",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"18",
          "text":"On reste cool-cool-cool-cool-cool, ok ?",
          "rhyme":"e",
          "persona_id":"kingju"
        },
        {
          "n":"19",
          "text":"J'suis pas un embrouilleur, ok ?",
          "rhyme":"e",
          "persona_id":"kingju"
        }
      ],
