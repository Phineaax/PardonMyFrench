    {
      "section_id": "section_4",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "You called my friends, you called my dad",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "1",
          "text": "You begged for help to win me back",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "2",
          "text": "And they would never say it to your face",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "3",
          "text": "But no, they never liked you anyways",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "4",
          "text": "You missed my birthday and my shows",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "5",
          "text": "You made me feel so damn alone",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "6",
          "text": "And somehow now you got so much to say",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "7",
          "text": "Don't got time to listen anyway",
          "persona_id": "persona_tate_baseline"
        }
      ]
    },
