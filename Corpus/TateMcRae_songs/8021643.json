    {
      "section_id": "section_4",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "It's funny, you took me 'round town like you owned me",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "1",
          "text": "Wanted me for your eyes only, never wanted anyone to know me",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "2",
          "text": "Tried to make me more like you and less like me",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "3",
          "text": "You're saying things I won't repeat",
          "persona_id": "persona_tate_baseline"
        },
        {
          "n": "4",
          "text": "That's petty shit only you would do",
          "persona_id": "persona_tate_baseline"
        }
