      "section_id": "section_0",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Swear I'm only sleepin' at your house",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "1",
          "text": "Six times in one week",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "2",
          "text": "'Cause it's convenient",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "3",
          "text": "And I'm only kinda dressin' like you now (You now)",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "4",
          "text": "'Cause your clothes, they fit me",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "5",
          "text": "And that's good reason, oh yeah",
          "persona_id": "persona_tatiana"
        }
      ]
    },
    {
      "section_id": "section_1",
      "type": "pre-chorus",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Told you one, two, three times",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "1",
          "text": "Don't be readin' through lines",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "2",
          "text": "Every friend of mine",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "3",
          "text": "I told them the same",
          "persona_id": "persona_tatiana"
        }
      ]
    },
    {
      "section_id": "section_2",
      "type": "chorus",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "No, I am not in love",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "1",
          "text": "I am not thinkin' 'bout you",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "2",
          "text": "Sun's not gonna come up",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "3",
          "text": "And I don't hate every girl your eyes go to",
          "persona_id": "persona_tatiana"
        },
