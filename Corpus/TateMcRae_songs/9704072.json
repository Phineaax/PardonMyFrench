      "lines": [
        {
          "n": "0",
          "text": "Met you in a night out in Boston",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "1",
          "text": "Put your hand on my thigh in the Commons (Woo)",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "2",
          "text": "Been drinkin' somethin' blue, turn my phone off",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "3",
          "text": "'Cause if it's not you, I don't wanna talk",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "4",
          "text": "Don't know if it's been a minute or an hour",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "5",
          "text": "Kinda cute when you bribin' the bouncer",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "6",
          "text": "My friends got scared and they called the cops",
          "persona_id": "persona_tatiana"
        },
        {
          "n": "7",
          "text": "But I'm just at the Ritz with the door locked",
          "persona_id": "persona_tatiana"
        }
      ]
    },
