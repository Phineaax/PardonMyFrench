    {
      "section_id":"section_3",
      "type":"verse",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"I heard ain't nobody famous up in Heaven, everybody the same",
          "rhyme":"am",
          "persona":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"Just kick it up there in Heaven 'cause nobody goin' change",
          "rhyme":"#Z",
          "persona":"Mac_Miller"
        },
        {
          "n":"2",
          "text":"Nobody can complain, the parties are all insane",
          "rhyme":"an",
          "persona":"Mac_Miller"
        },
        {
          "n":"3",
          "text":"The people all know your name, shit, you entertain",
          "rhyme":")",
          "persona":"Mac_Miller"
        },
        {
          "n":"4",
          "text":"See everybody you want, always keepin' in touch",
          "rhyme":"uS",
          "persona":"Mac_Miller"
        },
        {
          "n":"5",
          "text":"And go and chill by yourself when everything get too much",
          "rhyme":"9tS",
