      "lines":[
        {
          "n":"0",
          "text":"Okay, time to rhyme with Cookie",
          "rhyme":"i",
          "persona":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"(Yeah, uh, yeah)",
          "rhyme":null,
