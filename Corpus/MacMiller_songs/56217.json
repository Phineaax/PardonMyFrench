    {
      "section_id":"section_2",
      "type":"verse",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"I sound like old (What?), I sound like new (Uh-huh)",
          "rhyme":"u",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"I sound like me and I sound like you",
          "rhyme":"u",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"2",
          "text":"I sound like yes, I sound like fresh (Fresh)",
          "rhyme":"aS",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"3",
          "text":"I sound like a bird first flyin' out the nest (Ha-ha)",
          "rhyme":"Est",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"4",
          "text":"I sound like rap, I sound like rock (Uh)",
          "rhyme":"Ok",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"5",
          "text":"I sound like every single type of hip-hop",
          "rhyme":"Op",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"6",
          "text":"I sound like pain, I sound like fame (Fame)",
          "rhyme":"am",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"7",
          "text":"I sound like water and I sound like flame (Flame)",
          "rhyme":"am",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"8",
          "text":"I sound like cash, you sound like change (Cha-ching)",
          "rhyme":"#Z",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"9",
          "text":"I sound like style, and I sound like bang (Bang)",
          "rhyme":"#g",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"10",
          "text":"Sound like trash, sound like ecstasy",
          "rhyme":"i",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"11",
          "text":"Sound like a harmony on a melody",
          "rhyme":"i",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"12",
          "text":"To determine what I sound like, please come listen (Come listen)",
          "rhyme":"En",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"13",
          "text":"This ain't no ordinary white boy spittin' (Boy spittin')",
          "rhyme":")",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"14",
          "text":"Mac Miller, here to give you sound bytes (What?)",
          "rhyme":"it",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"15",
          "text":"So why do people wanna know what I sound like?",
          "rhyme":"Ejk",
          "persona_id":"Mac_Miller"
        }
      ],
