      "lines":[
        {
          "n":"0",
          "text":"My swag official like a referee (Yeah)",
          "rhyme":"e",
          "persona":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"No one on the plane is stayin' fresh as me (Uh-huh)",
