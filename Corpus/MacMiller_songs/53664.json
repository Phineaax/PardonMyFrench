      "type":"chorus",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Throw a steak on the grill, put the drink on chill (Chill)",
          "rhyme":"il",
          "persona":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"This a motherfuckin' barbecue, for real (Real)",
          "rhyme":"il",
          "persona":"Mac_Miller"
        },
        {
          "n":"2",
          "text":"All these days already gone by (Gone by)",
          "rhyme":"i",
          "persona":"Mac_Miller"
        },
        {
          "n":"3",
          "text":"Man, I ain't seen your ass in a long time",
          "rhyme":"ajm",
          "persona":"Mac_Miller"
        },
        {
          "n":"4",
          "text":"Put a little gin in the punch (Punch)",
          "rhyme":"$S",
          "persona":"Mac_Miller"
        },
        {
          "n":"5",
          "text":"Grandma gettin' crunk, just fun, nobody give a fuck (Fuck)",
          "rhyme":"yk",
          "persona":"Mac_Miller"
        },
        {
          "n":"6",
          "text":"All these days already gone by (Gone by)",
          "rhyme":"i",
