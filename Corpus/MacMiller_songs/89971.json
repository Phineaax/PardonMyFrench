      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Y'all ain't doin' jack shit (Uh-uh), just a bunch of has-beens (Yep)",
          "rhyme":"in",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"What the fuck happened? Why you stop rappin', huh?",
          "rhyme":"u",
