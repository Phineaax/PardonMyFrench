        },
        {
          "n":"14",
          "text":"You bright, I'm neon",
          "rhyme":"$",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"15",
          "text":"I'm smokin' up the weed 'til the tree gone, yeah",
          "rhyme":"E",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"16",
          "text":"My life's up and down like a see-saw",
          "rhyme":"o",
