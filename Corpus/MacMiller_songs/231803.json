      "lines":[
        {
          "n":"0",
          "text":"I sport a long white tee, fitted cap, baggy pants (You know)",
          "rhyme":"#",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"If you see me, please be sure to slap my hand (What's good?)",
