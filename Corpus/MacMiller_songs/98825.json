        },
        {
          "n":"9",
          "text":"Is make love 'til the morning",
          "rhyme":"iN",
          "persona_id":"Larry_Lovestein"
        },
        {
          "n":"10",
          "text":"A one-way ticket to paradise",
          "rhyme":"iz",
          "persona_id":"Larry_Lovestein"
        },
        {
          "n":"11",
          "text":"The love train is boarding (Baby, let's go)",
