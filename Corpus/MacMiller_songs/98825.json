    {
      "section_id":"section_3",
      "type":"verse",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"Darling, you and me strollin' down the street",
          "rhyme":"it",
          "persona_id":"Larry_Lovestein"
        },
        {
          "n":"1",
          "text":"Talking 'bout our dreams, throwin' pebbles",
          "rhyme":"ibl",
          "persona_id":"Larry_Lovestein"
        },
        {
          "n":"2",
          "text":"I wanna hear 'bout everything you know",
          "rhyme":"o",
          "persona_id":"Larry_Lovestein"
        },
        {
          "n":"3",
          "text":"The places we could go, the songs that we could sing",
          "rhyme":"iN",
          "persona_id":"Larry_Lovestein"
        },
        {
          "n":"4",
          "text":"The two of us, such a wonderful pair",
          "rhyme":"ER",
