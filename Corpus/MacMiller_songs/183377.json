      "lines":[
        {
          "n":"0",
          "text":"Uh",
          "rhyme":"u",
          "persona":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"So it's the end of the tape, the last page (Last page)",
          "rhyme":"aZ",
          "persona":"Mac_Miller"
        },
        {
          "n":"2",
          "text":"Hoes backstage, party like my last day (Last day)",
          "rhyme":"E",
