      "lines":[
        {
          "n":"0",
          "text":"It's alright (Alright), it's okay (Okay)",
          "rhyme":"E",
          "persona":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"We gon' party from the night to the day (Haha)",
