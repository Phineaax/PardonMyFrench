      "lines":[
        {
          "n":"0",
          "text":"Yeah",
          "rhyme":"E",
          "persona":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"Thank you, everybody, for comin' out",
          "rhyme":"awt",
          "persona":"Mac_Miller"
        },
        {
          "n":"2",
          "text":"Listenin' to that Easy Mac",
          "rhyme":"ak",
          "persona":"Mac_Miller"
        },
        {
          "n":"3",
          "text":"Shit's for Pittsburgh, that 412",
          "rhyme":"a",
          "persona":"Mac_Miller"
        },
        {
          "n":"4",
          "text":"So light up your blunts",
          "rhyme":"(",
          "persona":"Mac_Miller"
        },
        {
          "n":"5",
          "text":"We got time for one more",
          "rhyme":"OR",
          "persona":"Mac_Miller"
        },
        {
          "n":"6",
          "text":"(Yeah) Aight?",
          "rhyme":"Et",
          "persona":"Mac_Miller"
        },
        {
          "n":"7",
          "text":"You at the back of the Mac",
          "rhyme":"ak",
          "persona":"Mac_Miller"
        },
        {
          "n":"8",
          "text":"Yo, yo",
          "rhyme":"o",
          "persona":"Mac_Miller"
        }
      ],
