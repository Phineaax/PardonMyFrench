    {
      "section_id": "section_7",
      "type": "outro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "(Just the two of us, just the two of us)",
          "persona_id": "slim_shady"
        },
        {
          "n": "1",
          "text": "Just me and you, baby, is all we need in this world",
          "persona_id": "slim_shady"
        },
        {
          "n": "2",
          "text": "(Just the two of us, just the two of us)",
          "persona_id": "slim_shady"
        },
        {
          "n": "3",
          "text": "Just me and you",
          "persona_id": "slim_shady"
        },
        {
          "n": "4",
          "text": "Your dada will always be here for you",
          "persona_id": "slim_shady"
        },
        {
          "n": "5",
          "text": "Your dada's always gonna love you, remember that",
          "persona_id": "slim_shady"
        },
        {
          "n": "6",
          "text": "If you ever need me, I'ma always be here for you",
          "persona_id": "slim_shady"
        },
        {
          "n": "7",
          "text": "You ever need anything, just ask",
          "persona_id": "slim_shady"
        },
        {
          "n": "8",
          "text": "Dada will be right there",
          "persona_id": "slim_shady"
        },
        {
          "n": "9",
          "text": "Your dada loves you",
          "persona_id": "slim_shady"
        },
        {
          "n": "10",
          "text": "I love you, baby",
          "persona_id": "slim_shady"
        }
      ]
