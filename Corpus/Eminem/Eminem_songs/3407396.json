      ]
    },
    {
      "section_id": "section_5",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Wake up, sweepyhead, we're here, before we pway",
          "persona_id": "slim_shady"
        },
        {
          "n": "1",
          "text": "We're gonna take Mama for a wittle walk along the pier",
          "persona_id": "slim_shady"
        },
        {
          "n": "2",
          "text": "Baby, don't cry, honey, don't get the wrong idea",
          "persona_id": "slim_shady"
        },
        {
          "n": "3",
          "text": "Mama's too sweepy to hear you scweamin' in her ear (Mama)",
          "persona_id": "slim_shady"
        },
        {
          "n": "4",
          "text": "That's why you can't get her to wake, but don't worry",
          "persona_id": "slim_shady"
        },
        {
          "n": "5",
          "text": "Dada made a nice bed for Mommy at the bottom of the lake",
          "persona_id": "slim_shady"
        },
        {
          "n": "6",
          "text": "Here, you wanna help Dada tie a rope around this rock? (Yeah)",
          "persona_id": "slim_shady"
        },
        {
          "n": "7",
          "text": "We'll tie it to her footsie then we'll roll her off the dock",
          "persona_id": "slim_shady"
        },
        {
          "n": "8",
          "text": "Ready now, here we go, on the count of free",
          "persona_id": "slim_shady"
        },
        {
          "n": "9",
          "text": "One, two, free, whee",
          "persona_id": "slim_shady"
        },
        {
          "n": "10",
          "text": "There goes Mama, spashin' in the water",
          "persona_id": "slim_shady"
        },
        {
          "n": "11",
          "text": "No more fightin' with Dad, no more restraining order",
          "persona_id": "slim_shady"
        },
        {
          "n": "12",
          "text": "No more step-dada, no more new brother",
          "persona_id": "slim_shady"
        },
        {
          "n": "13",
          "text": "Blow her kisses bye-bye, tell Mama you love her (Mommy)",
          "persona_id": "slim_shady"
        },
        {
          "n": "14",
          "text": "Now we'll go play in the sand, build a castle and junk",
          "persona_id": "slim_shady"
        },
        {
          "n": "15",
          "text": "But first, just help Dad with two more things out the trunk",
          "persona_id": "slim_shady"
        }
      ]
    },
