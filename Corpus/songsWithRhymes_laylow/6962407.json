    "lyrics": [
        {
            "section_id": "section_0",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "J'n'entendais que la pluie, ta voix qui chuchotait dans ma tête",
                    "rhyme": "Et",
                    "personna_id": "004"
                },
                {
                    "n": "1",
                    "text": "Probablement, j'étais seul, tellement seul qu'j'entendais même plus tes appels",
                    "rhyme": "El",
                    "personna_id": "004"
                },
                {
                    "n": "2",
                    "text": "Y a des gens qui arrivent à mentir, y en a même qui arrivent à trouver la paix",
                    "rhyme": "E",
                    "personna_id": "004"
                },
                {
                    "n": "3",
                    "text": "Mais tout ce jeu vaut pas ma peine, donc, sur un coup d'tête, j'ai pris mon sac, j'suis parti",
                    "rhyme": "i",
                    "personna_id": "004"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Comme ça, d'un coup one shot",
                    "rhyme": "o",
                    "personna_id": "004"
                },
                {
                    "n": "1",
                    "text": "J'ai dit \"Ciao, ciao\"",
                    "rhyme": "o",
                    "personna_id": "004"
                },
                {
                    "n": "2",
                    "text": "Pourquoi tu pleures ? Pourquoi tu pleures ?",
                    "rhyme": "9R",
                    "personna_id": "004"
                },
                {
                    "n": "3",
                    "text": "Pourquoi tu pleures ? Pourquoi tu pleures ?",
                    "rhyme": "9R",
                    "personna_id": "004"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Et j'aurais voulu revenir mais c'était trop tard, pas d'rеstart dans la vraie life",
                    "rhyme": "ajf",
                    "personna_id": "004"
                },
                {
                    "n": "1",
                    "text": "C'est quе la pluie, les gens comme moi font jamais marche arrière",
                    "rhyme": "ER",
                    "personna_id": "004"
                },
                {
                    "n": "2",
                    "text": "Et t'inquiète pas, j'peux prendre tes larmes, j'me lave avec",
                    "rhyme": "Ek",
                    "personna_id": "004"
                },
                {
                    "n": "3",
                    "text": "Tout c'qu'on a fait avant c'est rien, j'peux l'mettre entre parenthèses",
                    "rhyme": "Ez",
                    "personna_id": "004"
                },
                {
                    "n": "4",
                    "text": "J'ai erré, cherché euros toute la noche dans la ville",
                    "rhyme": "il",
                    "personna_id": "004"
                },
                {
                    "n": "5",
                    "text": "Le daron s'éloigne aïe aïe, j'étais high",
                    "rhyme": "Eg",
                    "personna_id": "004"
                },
                {
                    "n": "6",
                    "text": "Moi, j'croyais qu'c'était ça la life",
                    "rhyme": "ajf",
                    "personna_id": "004"
                },
                {
                    "n": "7",
                    "text": "J'ai l'sac plein d'remords quand j'claque la porte",
                    "rhyme": "ORt",
                    "personna_id": "004"
                },
                {
                    "n": "8",
                    "text": "Mais sache que c'était à contrecœur que j't'ai dit \"Bye-bye",
                    "rhyme": "aj",
                    "personna_id": "004"
                },
                {
                    "n": "9",
                    "text": "Papa, bye\"",
                    "rhyme": "aj",
                    "personna_id": "004"
                }
            ]
        },
