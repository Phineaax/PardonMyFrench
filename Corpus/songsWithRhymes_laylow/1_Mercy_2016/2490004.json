            "lines": [
                {
                    "n": "0",
                    "text": "T'es mon homie, t'es mon homie, t'es mon homie, t'es mon homie, t'es mon homie, t'es mon homie jusqu'à quand ?",
                    "rhyme": "an",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "Mama, je t'ai promis, je t'ai promis, je t'ai promis, je t'ai promis, je t'ai promis, j's'rai pas long",
                    "rhyme": "on",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "T'es mon homie jusqu'à quand ? Mama, je t'ai promis j's'rai pas long",
                    "rhyme": "an",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "T'es mon homie jusqu'à quand ? Mama ouais, j'ai promis, j's'rai pas long",
