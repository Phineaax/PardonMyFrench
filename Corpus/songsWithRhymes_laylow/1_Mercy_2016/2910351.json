            "lines": [
                {
                    "n": "0",
                    "text": "J'ai un feeling spécial",
                    "rhyme": "al",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "Sur cette nuit (Tu l'sais déjà)",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "J'ai fait l'tour de la ville, j'ai rencontré cette fille",
                    "rhyme": "ij",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "On a tourné un film",
                    "rhyme": "ilm",
                    "personna_id": "001"
                },
                {
                    "n": "4",
                    "text": "Éteins toutes les lumières mama",
                    "rhyme": "a",
                    "personna_id": "001"
                },
                {
                    "n": "5",
                    "text": "Oh na oh na, oh na oh na",
                    "rhyme": "a",
                    "personna_id": "001"
                },
                {
                    "n": "6",
                    "text": "Oh na oh na, no no (Ouais, ouais, ouais, ouais, ouais, ouais, ouais)",
                    "rhyme": "o",
                    "personna_id": "001"
                },
                {
                    "n": "7",
                    "text": "Million d'dollars bébé, no love (No love)",
                    "rhyme": "Ov",
                    "personna_id": "001"
                },
                {
                    "n": "8",
                    "text": "Rock'n'rolla, bébé no love (No love)",
                    "rhyme": "Ov",
                    "personna_id": "001"
                },
                {
                    "n": "9",
                    "text": "Rock'n'rolla, bébé no love",
                    "rhyme": "Ov",
                    "personna_id": "001"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Préviens ta copine : elle me plait, tête en bas, cul en l'air",
                    "rhyme": "ER",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "J'en ai fait tombé mon verre",
                    "rhyme": "ER",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "J'ai du temps, des jetons à perdre, qu'est c'que t'attends pour grimper dans la caisse, girl ?",
                    "rhyme": "9Rl",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "Tes copines acquiescent, viens faire un tour en enfer, oh",
                    "rhyme": "o",
                    "personna_id": "001"
                },
                {
                    "n": "4",
                    "text": "Remonte le son qu'on les blesse, DJ met tout dans la basse",
                    "rhyme": "as",
                    "personna_id": "001"
                },
                {
                    "n": "5",
                    "text": "Laisse les penser qu'on est bêtes, les voisins partent au taf avec trous dans la tête, yeah",
                    "rhyme": "E",
                    "personna_id": "001"
                },
                {
                    "n": "6",
                    "text": "Tu m'as trahi : t'es la énième ; tu m'as sali : t'es la dernière",
                    "rhyme": "ER",
                    "personna_id": "001"
                },
                {
                    "n": "7",
                    "text": "J'te verrai de loin, tu ne verras que l'ombre et le logo AMG-G-G",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "8",
                    "text": "Toi-même tu sais qu'on est très déter', paie les trente minutes en TTC",
                    "rhyme": "a",
                    "personna_id": "001"
                },
                {
                    "n": "9",
                    "text": "On n'est pas v'nu pour le fun, c'est eux contre nous",
                    "rhyme": "u",
                    "personna_id": "001"
                },
                {
                    "n": "10",
                    "text": "La Ferrari, la Subaru, préparer sa mort en parlant d'amour",
                    "rhyme": "uR",
                    "personna_id": "001"
                },
                {
                    "n": "11",
                    "text": "En parlant d'amour",
                    "rhyme": "uR",
                    "personna_id": "001"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "pont",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Toute la night, on s'est mis high, bien sûr qu'on sait qu'c'est sale",
                    "rhyme": "al",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "Bien sûr qu'on sait qu'on s'fait du mal, bien sûr qu'on rappe mieux qu'toi",
                    "rhyme": "a",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "Même éclatés à six du mat', j'suis digital",
                    "rhyme": "al",
                    "personna_id": "001"
                }
            ]
