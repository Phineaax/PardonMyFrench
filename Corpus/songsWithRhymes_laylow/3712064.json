                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Il est six du mat’, va dire à ta pote elle fait trop d’manières",
                    "rhyme": "ER",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "Dis-lui que l’appartement est haussmannien",
                    "rhyme": "un",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "Dis-lui qu’elle a pas besoin de porte-monnaie",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Elle va pas parler yeah, on sait pas se contrôler",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "Mais vu qu’elle est jamais dans le compromis",
                    "rhyme": "i",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "Comme nous quand on récupère cette money",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "L plus Wit. que des actions, j'kiffe mes frères pas la radio",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "7",
                    "text": "Jette-moi la ration, crypté comme ma génération",
                    "rhyme": "ion",
                    "personna_id": "002"
                },
                {
                    "n": "8",
                    "text": "Des accélérations",
                    "rhyme": "ion",
                    "personna_id": "002"
                },
                {
                    "n": "9",
                    "text": "Micro branché, j'suis dans ma chambre",
                    "rhyme": "ambR",
                    "personna_id": "002"
                },
                {
                    "n": "10",
                    "text": "Paraît qu'c'est fashion, augmente les basses",
                    "rhyme": "as",
                    "personna_id": "002"
                },
                {
                    "n": "11",
                    "text": "J'danse comme Johnny Quid dans rock’n’rolla",
                    "rhyme": "a",
                    "personna_id": "002"
                },
                {
                    "n": "12",
                    "text": "Tout est noir dans l’scénario de mon polar",
                    "rhyme": "aR",
                    "personna_id": "002"
                },
                {
                    "n": "13",
                    "text": "Jusqu’où t’irais pour soutirer ta poignée d’dollars ?",
                    "rhyme": "aR",
                    "personna_id": "002"
                }
            ]
        },
