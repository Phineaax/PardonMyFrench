            "lines": [
                {
                    "n": "0",
                    "text": "Flex, celle-là, c'est pour moi, t'inquiètes pas, j'te refais comme Madonna",
                    "rhyme": "a",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "J'vois ton rouge à lèvres, il est rouge, on voit rouge comme le maillot d'la Roma",
                    "rhyme": "a",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "Mets des diamants pour la re-mè, si ça va vite, nigga, remets",
                    "rhyme": "E",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "Rap jeu remis à jour, fait bisous sur ma joue, han",
                    "rhyme": "#",
                    "personna_id": "001"
                },
                {
                    "n": "4",
                    "text": "J'suis juste en face de toi bébé, pourquoi tu m'ignores ?",
                    "rhyme": "OR",
                    "personna_id": "001"
                },
                {
                    "n": "5",
                    "text": "Écoute pas ta pote à gauche, j'sais pas c'qu'elle mijote",
                    "rhyme": "Ot",
                    "personna_id": "001"
                },
                {
                    "n": "6",
                    "text": "Fais sortir le démon, desserre la camisole",
                    "rhyme": "Ol",
                    "personna_id": "001"
                },
                {
                    "n": "7",
                    "text": "Très, très cher comme Mona Lisa, plus d'aigu dans l'equalizer, yeah",
                    "rhyme": "E",
                    "personna_id": "001"
                },
                {
                    "n": "8",
                    "text": "Fais c'ment-dou, y'a la banalisée, mec",
                    "rhyme": "Ek",
                    "personna_id": "001"
                },
                {
                    "n": "9",
                    "text": "On sort la tendance, tu fais qu'analyser, wesh",
                    "rhyme": "aS",
                    "personna_id": "001"
                },
                {
                    "n": "10",
                    "text": "T'es du genre tétanisé d'vant des grosses jantes métallisées",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "11",
                    "text": "4-4-2 sur terrain usé, tu rentres pas où on s'est hissé",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "12",
                    "text": "J'roule ma fusée, t'sais qu'on les baise, abusé",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "13",
                    "text": "J'suis pas là pour sympathiser, fuck ta Classe sur les Champs Élysées",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "14",
                    "text": "Bébé, tu sais qui c'est, ch'mise hawaïenne, cheveux lissés",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "15",
                    "text": "J'peux la glisser, tu l'sais",
                    "rhyme": "E",
                    "personna_id": "001"
                }
            ]
        },
