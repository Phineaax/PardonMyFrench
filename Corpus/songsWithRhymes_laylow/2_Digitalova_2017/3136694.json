                },
                {
                    "n": "2",
                    "text": "Génération tête brûlée, Laylow, Man of the Yea-ea-ear",
                    "rhyme": "ER",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "J'veux toujours tout faire péter, surtout péter l'million",
                    "rhyme": "$",
                    "personna_id": "001"
                }
            ]
        },
