            "lines": [
                {
                    "n": "0",
                    "text": "Aïe, j'augmente le bénéf', tu fais faillite (Tu fais faillite)",
                    "rhyme": "it",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "Y'a deux-trois pétasses qui m'ont trahi (Qui m'ont trahi)",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "Aïe, m'en veux pas, j'étais naïf (J'étais naïf)",
                    "rhyme": "if",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "Maintenant, j'suis focus sur le khalis (Khalis)",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "4",
                    "text": "Dérapage contrôlé comme en rallye (Rallye)",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "5",
                    "text": "J't'ai vu au coin fumeur, j't'ais complètement high",
                    "rhyme": "Eg",
                    "personna_id": "001"
                },
                {
                    "n": "6",
                    "text": "Aïe, como esta mammi ? Mammi",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "7",
                    "text": "Han, j'ai ramené la flamme dans la ville, elle demande si j'suis l'Man of the Year (Man of the Year)",
                    "rhyme": "ER",
                    "personna_id": "001"
                },
                {
                    "n": "8",
                    "text": "J'lui réponds : \"j'sais pas\" mais que j'protège les miens tout comme Manuel Neuer",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "9",
                    "text": "Négro, fait pas genre t'es pas mal à l'aise, quand ça parle en euros, t'es dans monde parallèle",
                    "rhyme": "El",
                    "personna_id": "001"
                },
                {
                    "n": "10",
                    "text": "Ton flow pue la merde, j'te le laisse, comme mes exs, ouais",
                    "rhyme": "E",
                    "personna_id": "001"
                },
                {
                    "n": "11",
                    "text": "J'regarde la une, la deux, j'suis perplexe, j'te vois poser, t'es là, t'es pas flex",
                    "rhyme": "Eks",
                    "personna_id": "001"
                },
                {
                    "n": "12",
                    "text": "Devant l'alignement des planètes, diplomatique comme la plaque d'la Lexus, hey",
                    "rhyme": "E",
                    "personna_id": "001"
                },
                {
                    "n": "13",
                    "text": "Tu captes pas le lexique, sur l'terrain, c'est le Brésil",
                    "rhyme": "il",
                    "personna_id": "001"
                },
                {
                    "n": "14",
                    "text": "J'suis d'vant toi, je t'explique, le temps passe et t'hésites, girl",
                    "rhyme": "9Rl",
                    "personna_id": "001"
                }
