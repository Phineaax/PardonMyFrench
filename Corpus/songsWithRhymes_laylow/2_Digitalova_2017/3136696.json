        {
            "section_id": "section_3",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Amigo, on s'est perdu d'vue, la faute le fruit du time",
                    "rhyme": "ajm",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "À force de penser maille, on perd le sens des choses",
                    "rhyme": "oz",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "Bambino, j'étais sage mais j'voyais d'jà l'monde en large",
                    "rhyme": "aRZ",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "Et j'ai pas changé d'vision depuis 2002",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "4",
                    "text": "Que la villa sur la côte, tout près de l'eau",
                    "rhyme": "o",
                    "personna_id": "001"
                },
                {
                    "n": "5",
                    "text": "Pour inviter mes brothers (Pour inviter mes brothers)",
                    "rhyme": "ER",
                    "personna_id": "001"
                },
                {
                    "n": "6",
                    "text": "Bientôt, j'suis plus dans le tel-hô, plus d'sol dans ma mélodie",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "7",
                    "text": "T'inquiètes, on va pas rater l'coche",
                    "rhyme": "OS",
                    "personna_id": "001"
                },
                {
                    "n": "8",
                    "text": "Même si c'est l'même feeling everyday, on cherche à l'éviter",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "9",
                    "text": "Sur Paname en train d'effriter (Sur Paname en train d'effriter)",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "10",
                    "text": "Elle bouge son pétard comme à Mexico, dangereux comme un Perisco'",
                    "rhyme": "o",
                    "personna_id": "001"
                },
                {
                    "n": "11",
                    "text": "Mojo, moto débridée (Débridée)",
                    "rhyme": "e",
                    "personna_id": "001"
                }
            ]
        },
        {
            "section_id": "section_4",
            "type": "pont",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Pourvu qu'mes ennemis vivent une longue vie",
                    "rhyme": "i",
                    "personna_id": "001"
                },
                {
                    "n": "1",
                    "text": "Pourvu qu'ils la passent sans regretter les actes passés",
                    "rhyme": "e",
                    "personna_id": "001"
                },
                {
                    "n": "2",
                    "text": "Nigga, j'suis en showcase, all eyes on me",
                    "rhyme": "@",
                    "personna_id": "001"
                },
                {
                    "n": "3",
                    "text": "Digitalmundo, babe, on n'attend pas le jour de paie",
                    "rhyme": "E",
                    "personna_id": "001"
                }
            ]
        },
