            "lines": [
                
                {
                    "n": "0",
                    "text": "J'ai des démons, des anges qui m'volent au-dessus d'la tête",
                    "rhyme": "Et",
                    "personna_id": "004"
                },
                {
                    "n": "1",
                    "text": "J'ai plein d'problèmes mais rien que j'peux pas surmonter",
                    "rhyme": "e",
                    "personna_id": "004"
                },
                {
                    "n": "2",
                    "text": "Fuck vivre pour eux, j'le fais pour le fun",
                    "rhyme": "yn",
                    "personna_id": "004"
                },
                {
                    "n": "3",
                    "text": "Fuck, j'laisse sonner quand la vraie vie m'appеlle",
                    "rhyme": "El",
                    "personna_id": "004"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Yeah, et j'vеux pas m'poser trop d'questions",
                    "rhyme": "ion",
                    "personna_id": "004"
                },
                {
                    "n": "1",
                    "text": "Faut qu'j'te nique ta mère pour le fun",
                    "rhyme": "yn",
                    "personna_id": "004"
                },
                {
                    "n": "2",
                    "text": "Anderson est dans la maison",
                    "rhyme": "On",
                    "personna_id": "004"
                },
                {
                    "n": "3",
                    "text": "Y a tout l'temps deux-trois putes qui braillent, Dunhill aux lèvres, pas d'Lucky Strike",
                    "rhyme": "Ejk",
                    "personna_id": "004"
                },
                {
                    "n": "4",
                    "text": "J'suis dans la street en Peaky Blinders, police veut que m'mettre v'là des strikes",
                    "rhyme": "Eks",
                    "personna_id": "004"
                },
                {
                    "n": "5",
                    "text": "Je vous déteste par habitude, jeune nègre avec de l'attitude",
                    "rhyme": "yd",
                    "personna_id": "004"
                },
                {
                    "n": "6",
                    "text": "Spécial, mais bon c'ça qui tue, han",
                    "rhyme": "an",
                    "personna_id": "004"
                },
                {
                    "n": "7",
                    "text": "Monde est cruel, a pas pitié d'toi, j'fume une clope, là j'suis sur le toit",
                    "rhyme": "a",
                    "personna_id": "004"
                },
                {
                    "n": "8",
                    "text": "Mélancolie, mode cinq étoiles, j'dois faire comme s'j'étais sûr de moi",
                    "rhyme": "a",
                    "personna_id": "004"
                },
                {
                    "n": "9",
                    "text": "Y a du monde quand faut faire la fête mais plus personne quand faut assumer",
                    "rhyme": "e",
                    "personna_id": "004"
                },
                {
                    "n": "10",
                    "text": "Les yeux dans l'vide, c'est parce que j'vois loin, c'est pas parce qu'y a de la fumée",
                    "rhyme": "e",
                    "personna_id": "004"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "pont",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Seul dehors, j'fais l'tour d'la ciudad, en vrai",
                    "rhyme": "E",
                    "personna_id": "004"
                },
                {
                    "n": "1",
                    "text": "Et j'veux pas leur ressembler, en vrai",
                    "rhyme": "E",
                    "personna_id": "004"
                },
                {
                    "n": "2",
                    "text": "Ils méritent pas ma peine, non",
                    "rhyme": "On",
                    "personna_id": "004"
                }
            ]
        },
