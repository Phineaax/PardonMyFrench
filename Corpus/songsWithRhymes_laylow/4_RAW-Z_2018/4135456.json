            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Haaan, fuck cette musique et c'qui va avec",
                    "rhyme": "Ek",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "Haaan, j'aime cette musique",
