            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Hey, prince de sang-mêlé",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "T'es toujours des deux côtés",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "Mais t'sais, ce double-jeu n'peut plus durer",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Prince de sang-mêlé",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "Tu vas t'emmêler dans ce double jeu",
                    "rhyme": "2",
