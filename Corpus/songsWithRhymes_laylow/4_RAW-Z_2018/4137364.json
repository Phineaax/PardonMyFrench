    ],
    "lyrics": [
        {
            "section_id": "section_0",
            "type": "intro",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Hey",
                    "rhyme": "E",
                    "personna_id": "002"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "J'suis dans la ville avec Mehdi, j'voulais savoir c'que tu fais, babe",
                    "rhyme": "ab",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "J'ai du cash, j'ai la CB, résine de hash va pas m'aider",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "Maman va sûrement s'inquiéter, la cigale a chanté tout l'été, yeah",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Fils d'immigrés dans le BM, liquide tout frais dans l'ADN",
                    "rhyme": "$",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "Appel de phares dans les DM, elle veut me chauffer, c'est réel",
                    "rhyme": "El",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "Tout dans la tête, on les tue comme à la Play",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "J'voulais savoir c'que tu fais, babe, dis-le-moi",
                    "rhyme": "a",
                    "personna_id": "002"
                },
                {
                    "n": "7",
                    "text": "Oooh, descends, j'suis devant l'bât', yeah yeah yeah",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "8",
                    "text": "Jusqu'au lever du jour, j't'attends toujours en bas, yeah yeah yeah",
                    "rhyme": "E",
                    "personna_id": "002"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Ouh, j'suis dans l'allée, ouh, j'suis condamné à chercher l'cash money toute l'année",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "Ouh, fuck tous ces niggas ont l'culo en l'air même s'ils veulent pas l'admettre",
                    "rhyme": "EtR",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "Moi, j'vois clair, je ne bois pas la lean (Hey, hey, hey, hey)",
                    "rhyme": "in",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "225 sur le poster, fils d'immigrés dans le roadster",
                    "rhyme": "9R",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "Que la villa sur la coast, remonte le son sur le poste",
                    "rhyme": "Ost",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "Ça va toaster comme à Houston, faut s'élancer, tout est fucked up",
                    "rhyme": "9p",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "Dès que je sens qu'elle est love de moi, j'arrête le jeu comme un boss de fin, oh",
                    "rhyme": "o",
                    "personna_id": "002"
                }
            ]
        },
