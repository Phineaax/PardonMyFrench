            "lines": [
                {
                    "n": "0",
                    "text": "Ramène ton cul dans la caisse, ramène ton cul dans la caisse",
                    "rhyme": "Es",
                    "personna_id": "003"
                },
                {
                    "n": "1",
                    "text": "Trinity dans la matrice, elle a mis que du latex (flex)",
                    "rhyme": "Eks",
                    "personna_id": "003"
                },
                {
                    "n": "2",
                    "text": "Elle voudrait que je la blesse, elle veut même un peu plus",
                    "rhyme": "ys",
                    "personna_id": "003"
                },
                {
                    "n": "3",
                    "text": "Très tard le soir, je l'appelle, après j'vais casser ma puce",
                    "rhyme": "ys",
                    "personna_id": "003"
                },
                {
                    "n": "4",
                    "text": "Jeune tis-mé toujours dans les temps (j'suis dans les temps)",
                    "rhyme": "an",
                    "personna_id": "003"
                },
                {
                    "n": "5",
                    "text": "J'surfe sur l'rap français comme sur tes jambes (sur tes jambes)",
                    "rhyme": "anb",
                    "personna_id": "003"
                },
                {
                    "n": "6",
                    "text": "M'en veux pas quand ma vision devient rouge (devient rouge)",
                    "rhyme": "uZ",
                    "personna_id": "003"
                },
                {
                    "n": "7",
                    "text": "Quand j'change de mood, oh, pétasse casse un tour (oh, casse un tour)",
                    "rhyme": "uR",
                    "personna_id": "003"
                },
                {
                    "n": "8",
                    "text": "J'sors de tour, j'suis trop déter', j'les prends tous (oh, dis-moi tout)",
                    "rhyme": "us",
                    "personna_id": "003"
                },
                {
                    "n": "9",
                    "text": "Si c'est juste pour faire la mala, j'passe mon tour (ouais, j'passe mon tour)",
                    "rhyme": "uR",
                    "personna_id": "003"
                },
                {
                    "n": "10",
                    "text": "Business avant tout, j'roule sur ton cœur, j'écrase tout",
                    "rhyme": "u",
                    "personna_id": "003"
                },
                {
                    "n": "11",
                    "text": "(Pleins phares, pleine lune sur la ville)",
                    "rhyme": "i",
                    "personna_id": "003"
                }
            ]
        },
