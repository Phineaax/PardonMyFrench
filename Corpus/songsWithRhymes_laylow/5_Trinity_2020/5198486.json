        {
            "section_id": "section_3",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Moi, j'recompte mes lovés, me dis pas qu't'es love de moi",
                    "rhyme": "a",
                    "personna_id": "003"
                },
                {
                    "n": "1",
                    "text": "On s'connait que depuis .RAW-Z (.RAW, .RAW)",
                    "rhyme": "e",
                    "personna_id": "003"
                },
                {
                    "n": "2",
                    "text": "C't'année, j'me suis promis d'élever le niveau, le level",
                    "rhyme": "El",
                    "personna_id": "003"
                },
                {
                    "n": "3",
                    "text": "J'ai bossé comme never, fils d'immigré fait pas grève, eh",
                    "rhyme": "e",
                    "personna_id": "003"
                },
                {
                    "n": "4",
                    "text": "J'veux pas vivre tranquillement, Lamborghini me manque",
                    "rhyme": "ank",
                    "personna_id": "003"
                },
                {
                    "n": "5",
                    "text": "J'veux pas la pilote à soixante-dix ans",
                    "rhyme": "an",
                    "personna_id": "003"
                },
                {
                    "n": "6",
                    "text": "Flammes dans les yeux d'l'OPJ quand j'lui dis que j'fais que du rap (flex)",
                    "rhyme": "ap",
                    "personna_id": "003"
                },
                {
                    "n": "7",
                    "text": "Mec, c'est du développement durable, j'vais leur apprendre à me chercher la frappe (hey, hey, hey, hey)",
                    "rhyme": "ap",
                    "personna_id": "003"
                },
                {
                    "n": "8",
                    "text": "J'veux pas le bien, que le pire, numéro 9 de l'équipe",
                    "rhyme": "ip",
                    "personna_id": "003"
                },
                {
                    "n": "9",
                    "text": "Chaque nouveau projet, je drift, Laylow, c'est l'adrénaline",
                    "rhyme": "in",
                    "personna_id": "003"
                },
                {
                    "n": "10",
                    "text": "J'pourrais jamais t'aimer jusqu'à l'infini (j'pourrais jamais t'aimer jusqu'à l'infini)",
                    "rhyme": "i",
                    "personna_id": "003"
                },
                {
                    "n": "11",
                    "text": "Pourquoi tu veux t'insérer dans ma vie (vie) ?",
                    "rhyme": "i",
                    "personna_id": "003"
                },
