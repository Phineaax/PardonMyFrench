            "lines": [
                {
                    "n": "0",
                    "text": "- Laylow : Pourquoi tu m'fais ça ?",
                    "rhyme": "a",
                    "personna_id": "003"
                },
                {
                    "n": "1",
                    "text": "- Trinity : Tu le sais... tu cherches la réponse mais c'est la question qui nous guide",
                    "rhyme": "id"
                },
                {
                    "n": "2",
                    "text": "- Laylow : Tout c'qu'on a vécu, c'était réel au moins ?",
                    "rhyme": ")",
                    "personna_id": "003"
                },
                {
                    "n": "3",
                    "text": "- Trinity : Les concepts de réalité et de virtualité sont très flous pour moi... je suis désolée",
                    "rhyme": "e"
                },
                {
                    "n": "4",
                    "text": "- Laylow : Mais t'es quoi en fait... t'es qui ?",
                    "rhyme": "i",
                    "personna_id": "003"
                },
                {
                    "n": "5",
                    "text": "- Trinity : Je suis... Trinity. Logiciel de stimulation d'émotions",
                    "rhyme": "$"
                }
            ]
        }
    ]
