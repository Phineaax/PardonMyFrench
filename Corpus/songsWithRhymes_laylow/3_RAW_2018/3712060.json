{
    "song_id": 3712060,
    "title": ".RAW",
    "language": "fr",
    "lyricists": [
        308564
    ],
    "lyrics": [
        {
            "section_id": "section_0",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Tu m'as parlé vrai mais c't'ait trop tard",
                    "rhyme": "aR",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "J'avais d'jà cool-al dans prostate, tout dans ma rotation",
                    "rhyme": "ion",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "À part p't-être un avocat mais t'as capté, j'voulais palper la totale",
                    "rhyme": "al",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Maintenant que j'peux fixer les rotas, j'veux putain d'auto quand j'fais des photos",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "Mais je sais c'est quoi mon taf, j'm'enregistre moi-même, c'est moi, j'fais mes montages",
                    "rhyme": "aZ",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "Tu n'as pas l'gab' pour le faire, keumé, reste à ta place",
                    "rhyme": "as",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "J'vole dans la ciudad comme un prince au Qatar sur son deltaplane",
                    "rhyme": "an",
                    "personna_id": "002"
                },
                {
                    "n": "7",
                    "text": "C'est chaud mais c'est qu'la mise à plat, pull up le track, j'suis dans un classe C",
                    "rhyme": "s",
                    "personna_id": "002"
                },
                {
                    "n": "8",
                    "text": "Concentré comme avant l'casse-pipe, j'repense à tout c'qu'on n'a pas fait",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "9",
                    "text": "J'le conjugue toujours à l'imparfait comme Paname et Ben Arfa",
                    "rhyme": "a",
                    "personna_id": "002"
                },
                {
                    "n": "10",
                    "text": "Et quand j'trouve pas Morphée, j'fais cinquante lignes en un quart d'heure",
                    "rhyme": "9R",
                    "personna_id": "002"
                },
                {
                    "n": "11",
                    "text": "J'les jette en l'air comme actrice X, jamais c'est l'armistice",
                    "rhyme": "is",
                    "personna_id": "002"
                },
                {
                    "n": "12",
                    "text": "Nique tes statistiques",
                    "rhyme": "ik",
                    "personna_id": "002"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "J'démarre le Tmax, tu té-ma, té-ma la démarche, j'ai l'pantalon bas et les TN",
                    "rhyme": "N",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "Regarde la BM, ce-vi gravé dans l'ADN",
                    "rhyme": "N",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "Bitchies veut toujours glisser dans mes DMs, j'sais pas pourquoi ça m'intéresse",
                    "rhyme": "Es",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Avec Wit, on t'attend sur le terrain juste pour vérifier si t'es réel, ouais, ouais",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "J'dérape en R1, j'pose, ça fait les teras",
                    "rhyme": "a",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "404 bébé, y'a erreur, tu nous a pris pour ces keumés tout péraves",
                    "rhyme": "av",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "Fais gaffe, j'rappe, ouais, je les terrasse, Digitalova la menace tenace",
                    "rhyme": "as",
                    "personna_id": "002"
                },
                {
                    "n": "7",
                    "text": "Tu veux changer l'entraîneur ? Tu perds à domicile, à l'extérieur, ouais, ouais",
                    "rhyme": "E",
                    "personna_id": "002"
                },
                {
                    "n": "8",
                    "text": "T'inquiètes j'traîne avec DZ, tu valides en deux seizes",
                    "rhyme": "Ez",
                    "personna_id": "002"
                },
                {
                    "n": "9",
                    "text": "Concu' fait \"ohlala\", j'vais gagner haut la main, j'veux pas les check (Les check hun hun)",
                    "rhyme": "Ek",
                    "personna_id": "002"
                },
                {
                    "n": "10",
                    "text": "J'rentre à la baraque, a fait des empanadas, trouve pas d'prétextes (Trouve pas d'prétextes)",
                    "rhyme": "Ekst",
                    "personna_id": "002"
                },
                {
                    "n": "11",
                    "text": "J'fais pas de turnover, j'arrive et game over, les spots s'éteignent (Ouh)",
                    "rhyme": "EJ",
                    "personna_id": "002"
                },
                {
                    "n": "12",
                    "text": "Woh, tes gavas sont wo",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "13",
                    "text": "J'les vois d'en haut, j'suis dans les airs à la Kobe",
                    "rhyme": "Ob",
                    "personna_id": "002"
                },
                {
                    "n": "14",
                    "text": "T'pisser dessus c'est mon hobbie",
                    "rhyme": "i",
                    "personna_id": "002"
                },
                {
                    "n": "15",
                    "text": "L'jour où ça tombe, on fait \"woh\" (Woh)",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "16",
                    "text": "Si ça tombe pas, on fait autre chose, nos mains valent de l'or",
                    "rhyme": "OR",
                    "personna_id": "002"
                }
            ]
        }
    ]
}