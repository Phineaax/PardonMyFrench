    "lyrics": [
        {
            "section_id": "section_0",
            "type": "intro",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Benjay",
                    "rhyme": "E",
                    "personna_id": "002"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Ce soir, y’a rien qui bouge (Bouge) à part ton boule (Boule)",
                    "rhyme": "ul",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "Première fois, j’sais qu’tu couches (Couches), j’ai pas pris ma OG kush (Kush)",
                    "rhyme": "9S",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "I got my eyes on you (You), envoie-moi juste un nude (Nude)",
                    "rhyme": "yd",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Elle demande si j’fais du lourd (lourd), j’lui réponds : \"I don’t know\" (Hey)",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "Vas-y doucement bitch (Bitch), t’es que ma side bitch (Bitch)",
                    "rhyme": "itS",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "Fais pas la shabi, on s’connait que d’IG (G), ces niggas me fatiguent, j’suis dans la street avec Nabil (Avec Nabil)",
                    "rhyme": "il",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "J’te fais pas la bise, j’te donne un bras, tu veux ma bite",
                    "rhyme": "it",
                    "personna_id": "002"
                },
                {
                    "n": "7",
                    "text": "C’est mouillé, je navigue, tour de ton boule et de ta ville",
                    "rhyme": "il",
                    "personna_id": "002"
                },
                {
                    "n": "8",
                    "text": "Young Nigga dans Rari', j’suis là pour faire foirer tes paris",
                    "rhyme": "i",
                    "personna_id": "002"
                },
                {
                    "n": "9",
                    "text": "J’ppe-ra comme si c’était facile, étoilé comme maillot du Brasil",
                    "rhyme": "il",
                    "personna_id": "002"
                },
                {
                    "n": "10",
                    "text": "Ils vont rester assis (Yeah, yeah, yeah)",
                    "rhyme": "i",
                    "personna_id": "002"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Ouuuh, elle est dans un bad mood",
                    "rhyme": "ud",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "À 220, j’y vois tout flou",
                    "rhyme": "u",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "J’leur ai tout fait sauf l’amour",
                    "rhyme": "uR",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Parce que bitch fait du yo-yo, rien qu’on pense au seille-o",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "J’suis l’Bonhomme of the Year (J’suis l’Bonhomme of the Year)",
                    "rhyme": "ER",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "Parce que bitch fait du yo-yo, rien qu’on pense au seille-o",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "J’suis l’Bonhomme of the Year (J’suis l’Bonhomme of the Year)",
