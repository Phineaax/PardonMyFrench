    ],
    "lyrics": [
        {
            "section_id": "section_0",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Sur ma chaîne hi-fi (sur ma chaîne hi-fi)",
                    "rhyme": "i",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "J’fais défiler les prods jusqu’à trouver la bonne",
                    "rhyme": "On",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "Celle qui m’enverra loin d’ici (tellement loin)",
                    "rhyme": "i",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "Ils nous r'gardaient de haut, j’avais prévenu mes homies",
                    "rhyme": "i",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "J’savais d’jà qu’c’était difficile (tellement difficile)",
                    "rhyme": "il",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "J’suis dans l’truc jusqu’aujourd’hui, même si musique a changé",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "J’regrette rien, tout est magnifique (tout est magnifique)",
                    "rhyme": "ik",
                    "personna_id": "002"
                },
                {
                    "n": "7",
                    "text": "À part quelques moments (quelques moments), tellement de temps (tellement de temps)",
                    "rhyme": "an",
                    "personna_id": "002"
                },
                {
                    "n": "8",
                    "text": "Perdu sur ma chaîne hi-fi",
                    "rhyme": "i",
                    "personna_id": "002"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "J’suis dans la street, elle me té-ma, verre de whisky pour la démarrer",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "1",
                    "text": "J’ai fait un rêve, c’était très noir (très noir, très noir, très noir), très noir",
                    "rhyme": "aR",
                    "personna_id": "002"
                },
                {
                    "n": "2",
                    "text": "J’calcule le bénéf’ en peignoir, tu veux me gérer, j’peux pas",
                    "rhyme": "a",
                    "personna_id": "002"
                },
                {
                    "n": "3",
                    "text": "J’ai d’jà mamacita dans la baignoire (okay-kay-kay-kay)",
                    "rhyme": "aR",
                    "personna_id": "002"
                },
                {
                    "n": "4",
                    "text": "Dix-huit piges, j'distribue tout dans la ciudad (ouh)",
                    "rhyme": "ad",
                    "personna_id": "002"
                },
                {
                    "n": "5",
                    "text": "Nigga, j’ai perdu des euros, j’ai toujours pas perdu la mémoire (nan, nan, nan)",
                    "rhyme": "aR",
                    "personna_id": "002"
                },
                {
                    "n": "6",
                    "text": "Tout est écrit dans le mémo’, tout est retranscrit dans la mélo’ (hey)",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "7",
                    "text": "Ces derniers temps, je suis sous l’eau, j'descends l’calice au goulot, oh",
                    "rhyme": "o",
                    "personna_id": "002"
                },
                {
                    "n": "8",
                    "text": "Je bois, je nage, j’te vois, j’me noie direct (direct)",
                    "rhyme": "Ekt",
                    "personna_id": "002"
                },
                {
                    "n": "9",
                    "text": "Bolide rate un virage, j’vais p’t-être pas m’en tirer (pas m’en tirer)",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "10",
                    "text": "J’repense aux gens qui m’aiment, à ceux qu'j'ai abimés",
                    "rhyme": "e",
                    "personna_id": "002"
                },
                {
                    "n": "11",
                    "text": "J’repense aux nuits passées",
                    "rhyme": "e",
                    "personna_id": "002"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
