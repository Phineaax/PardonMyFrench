{"song_id": 6263296, "title": "The Chocolate Conquistadors", "language": "es", "lyricists": "[999281, 979645, 142460, 979646, 70, 65708, 400965]", "lyrics": [{"section_id": "section_0", "type": "intro", "performer": "", "lines": [{"n": "0", "text": "Ni\u00f1o"}, {"n": "1", "text": "Ni\u00f1o, vente conmigo"}, {"n": "2", "text": "Esc\u00fachame, te cuento unas cosas"}, {"n": "3", "text": "De unos hombres, ay"}, {"n": "4", "text": "Estos hombres eran hombres bravos"}, {"n": "5", "text": "Llegaban de \u00c1frica con la fuerza y la belleza"}, {"n": "6", "text": "Ay, mijo, conquistaban la ignorancia"}, {"n": "7", "text": "Y las bestias de la humanidad"}, {"n": "8", "text": "Daban al mundo la luz y la fe"}, {"n": "9", "text": "Y tambi\u00e9n el dios c\u00f3smico"}, {"n": "10", "text": "Los llamamos los conquistadores chocolates"}, {"n": "11", "text": "(It's yours)"}]}, {"section_id": "section_1", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "Legitimize living lies, channel the cosmos"}, {"n": "1", "text": "These God flows here to civilize"}, {"n": "2", "text": "Hear them footsteps, here come the Moors"}, {"n": "3", "text": "Neanderthals in scores, eatin\u2019 wild boars"}, {"n": "4", "text": "Thousands of y\u0435ars on tour, organize y'all"}, {"n": "5", "text": "Wild whores smellin' lik\u0435 animals through the pores on all fours"}, {"n": "6", "text": "Foul cannibals, hear the roars"}, {"n": "7", "text": "Raw flesh, rebellious and lawless"}, {"n": "8", "text": "Taught by the autochthonous, all bless"}, {"n": "9", "text": "All dressed in garbs of royalty"}, {"n": "10", "text": "Gods, who swore to be, righteous laws accordingly"}, {"n": "11", "text": "Educated by the highly elevated"}, {"n": "12", "text": "Melanated and mind renovated"}, {"n": "13", "text": "Once they stumble across the right answer (It\u2019s yours)"}, {"n": "14", "text": "Remarkably similar to Wakanda, white panther"}, {"n": "15", "text": "Herbs combat cancer"}, {"n": "16", "text": "Detoxin' the liver, sexual enhancers"}, {"n": "17", "text": "Symbolisms in Hollywood, jolly good"}, {"n": "18", "text": "Shows us how evil will manifest, or prob'ly could"}, {"n": "19", "text": "Divine beings, mind freeing"}, {"n": "20", "text": "Conquistadores chocolates"}]}, {"section_id": "section_2", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "Dates of fake history to erase"}, {"n": "1", "text": "Comin' through the corridors of deep space"}, {"n": "2", "text": "High beings"}, {"n": "3", "text": "All-eye seein', find meaning, clairvoyant, mind reading"}, {"n": "4", "text": "Nervous system, serve as wisdom"}, {"n": "5", "text": "Flow superior, determine rhythm"}, {"n": "6", "text": "Electricity, eccentricity"}, {"n": "7", "text": "Afrocentric synchronicity"}, {"n": "8", "text": "In the air everywhere, takin' over"}, {"n": "9", "text": "Chocolate conquerors, supernova"}, {"n": "10", "text": "Educatin', dominatin'"}, {"n": "11", "text": "Time deflatin\u2019, bomb on Satan"}, {"n": "12", "text": "Wicked is gone, shorn and shaken"}, {"n": "13", "text": "The force awakens (It\u2019s time)"}, {"n": "14", "text": "Back to them caves"}, {"n": "15", "text": "Conquistadores chocolates"}]}, {"section_id": "section_3", "type": "instrumental", "performer": "", "lines": []}]}