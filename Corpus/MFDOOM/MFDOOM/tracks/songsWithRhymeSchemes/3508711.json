{"song_id": 3508711, "title": "Close Talker", "language": "en", "lyricists": "[255632, 5828, 70, 24980]", "lyrics": [{"section_id": "section_0", "type": "skit", "performer": "", "lines": [{"n": "0", "text": "Hey, there, you\u2014in the Metal. What's your name?", "rhyme": "am"}, {"n": "1", "text": "DOOM. Shit.\u00a0", "rhyme": "it"}, {"n": "2", "text": "DOOM? Mmmm\u2014I like it. I'm CZARFACE. I know a guy who can change your life.\u00a0", "rhyme": "ajf"}, {"n": "3", "text": "Who?", "rhyme": "o"}, {"n": "4", "text": "Me!", "rhyme": "@"}, {"n": "5", "text": "Ten feet, nigga.\u00a0", "rhyme": "a"}, {"n": "6", "text": "Sometimes, hearin' in this helmet's hard, it's made me a close talker.\u00a0", "rhyme": "9R"}, {"n": "7", "text": "My space, yo.\u00a0", "rhyme": "o"}, {"n": "8", "text": "What do ya say we do a little team-up?", "rhyme": "9p"}, {"n": "9", "text": "What?", "rhyme": "a"}, {"n": "10", "text": "Ya know, a team-up\u2014like Spidey and The Torch, Hawk and Animal, 7L and\u2014umm, uhh\u2014", "rhyme": "a"}, {"n": "11", "text": "Play your position.\u00a0", "rhyme": "$"}, {"n": "12", "text": "Well, my position is hero, and\u2014stop me if you've heard this one\u2014every hero needs a\u2014Villain.\u00a0", "rhyme": ")"}, {"n": "13", "text": "That's right.\u00a0", "rhyme": "ajt"}, {"n": "14", "text": "Hahaha.\u00a0", "rhyme": "a"}, {"n": "15", "text": "A villain!", "rhyme": ")"}], "rhyme": "ABCDEFGDHFFIJKFJ", "rhyme_vowel": "ABACDAECEAAFGAAG"}]}