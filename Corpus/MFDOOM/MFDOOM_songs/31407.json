      "lines": [
        {
          "n": "0",
          "text": "I dunno... well, do you know the guy??",
          "rhyme": "i",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "1",
          "text": "(I've heard of him alright...)",
          "rhyme": null,
          "persona_id": "MF_DOOM"
        }
      ],
      "rhyme": "AB",
      "rhyme_vowel": "AB"
    },
    {
      "section_id": "section_1",
      "type": "hook",
      "performer": ", ",
      "lines": [
        {
          "n": "0",
          "text": "Well, is he ill? \"Yes!\"",
          "rhyme": "ej",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "1",
          "text": "Do he really fit the bill? \"Yes!\"",
          "rhyme": "ej",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "2",
          "text": "Spit to kill? \"Yes!\"",
          "rhyme": "ej",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "3",
          "text": "Keep things real? \"Yes!\"",
          "rhyme": "ej",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "4",
          "text": "Know the drill? \"Yes!\"",
          "rhyme": "ej",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "5",
          "text": "The ledge edge still? \"Yes!\"",
          "rhyme": "ej",
