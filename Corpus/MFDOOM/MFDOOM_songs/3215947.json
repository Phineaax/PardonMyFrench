        },
        {
          "n": "14",
          "text": "Oh, Erik Estrada",
          "rhyme": "a",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "15",
          "text": "Fat rat, the mask made 'em batty as a mad hatter",
