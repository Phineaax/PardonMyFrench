        },
        {
          "n": "6",
          "text": "The one he often frequently slapped around",
          "rhyme": "awnd",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "7",
          "text": "All the while waited and graduated cap and gown",
          "rhyme": "awn",
