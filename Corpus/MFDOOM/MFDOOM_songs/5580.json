        },
        {
          "n": "6",
          "text": "Just go with the flow",
          "rhyme": "o",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "7",
          "text": "Ayo, I'd like to test this microphone 'fore I start right quick",
          "rhyme": "ik",
          "persona_id": "MF_DOOM"
        },
        {
          "n": "8",
          "text": "Yeah, here we go, just go with the flow",
          "rhyme": "o",
