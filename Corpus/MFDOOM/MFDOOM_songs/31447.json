      "lines": [
        {
          "n": "0",
          "text": "Shit",
          "rhyme": "it",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "1",
          "text": "Tired of all this",
          "rhyme": "i",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "2",
          "text": "It's too hot out here, to be having all this shit on my face, man",
          "rhyme": "#",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "3",
          "text": "Fuckin', thick ass shit man, take it all off",
          "rhyme": "Of",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "4",
          "text": "Take it all off, boss",
          "rhyme": "Os",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "5",
          "text": "No matter what the cost",
          "rhyme": "Ost",
          "persona_id": "Viktor_Vaughn"
        }
      ],
      "rhyme": "ABCDEF",
