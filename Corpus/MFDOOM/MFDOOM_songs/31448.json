        },
        {
          "n": "8",
          "text": "Spit it like raw grits, get it?",
          "rhyme": "it",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "9",
          "text": "They better off forfeit, admit it",
          "rhyme": "it",
          "persona_id": "Viktor_Vaughn"
        },
        {
          "n": "10",
