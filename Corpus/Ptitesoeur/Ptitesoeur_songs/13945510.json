      "lines": [
        {
          "n": "0",
          "text": "Les tinp' s'masturbent sur la place publique quand j'les bloque",
          "rhyme": "Ok",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Même dans l'mépris tu vis dans l'ombre de quelqu'un d'autre",
          "rhyme": "otR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Sont tell'ment à l'ouest, ils ont pris cette jeune crasseuse pour Kanye West",
          "rhyme": "Est",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Crache sur ma face autant qu'tu veux, les poches s'remplissent anyway",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCD",
      "rhyme_vowel": "ABCD"
    },
    {
      "section_id": "section_2",
