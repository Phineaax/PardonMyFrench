        },
        {
          "n": "1",
          "text": "L'argent est plus gentil que l'homme",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Lui vit pas pour les caméras",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Même sur l'siège d'la Panamеra",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Son tact n'a pas d'équivalent",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Il m'fait des rendеz-vous galants",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Il m'a d'jà sortie des galères",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Mais il m'en a créées beaucoup d'autres",
          "rhyme": "otR",
