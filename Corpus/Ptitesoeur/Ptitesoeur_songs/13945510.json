        }
      ],
      "rhyme": "AABBCCDE",
      "rhyme_vowel": "AABBCCDE"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Ça coûte cher passe le beau couteau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'vais l'planter dans mon portefeuille",
          "rhyme": "9j",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "L'ami d'la veille me porte l'œil",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Celui d'demain se frotte les mains",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "L'humain me voit comme un plavon",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Bâtard j'ai même pas fait ma pièce",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'acquiesce quand tu parles des lèche-queues",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Sauf que moi j'pensais à ta face",
          "rhyme": "as",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Les grands ont rien compris au jeu",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Ils s'oublient pour deux trois billets",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Le cash sait comment m'habiller",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Pendant qu'eux veulent me mettre à nue",
          "rhyme": "y",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Poseur m'aime tant qu'j'ai la lumière",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Il trouv'ra d'autres queues à sauter",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "P'tite j'faisais pas d'corde à sauter",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "J'pensais à comment pas mourir",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "J'fais des efforts pour pas m'ouvrir",
          "rhyme": "iR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Tu f'rais quoi 'vec 100k maint'nant ?",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "Certainement pas c'que tu nous racontes",
          "rhyme": "$t",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "Sans, j'aurais d'jà sauté du balcon",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Les gars d'l'étage nous crient à l'aide",
          "rhyme": "Ed",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "Moi j'l'aide juste à prendre la mallette",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "L'argent est plus gentil que l'homme",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "L'argent est plus gentil que l'homme",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
