          "persona_id": "room1"
        },
        {
          "n": "7",
          "text": "C'est comme ça le soir on le touche à peine",
          "rhyme": "En",
          "persona_id": "room1"
        },
        {
          "n": "8",
          "text": "Moi et moi c'était pour la vida",
          "rhyme": "a",
          "persona_id": "room1"
        },
        {
          "n": "9",
          "text": "Je n'ai plus que le torse à vider",
          "rhyme": "e",
          "persona_id": "room1"
        },
        {
          "n": "10",
          "text": "Habiller Anima, j'ai fait des progrès pour m'abîmer",
          "rhyme": "e",
          "persona_id": "room1"
        },
        {
          "n": "11",
          "text": "Habiller Anima, un billet un humain",
          "rhyme": ")",
