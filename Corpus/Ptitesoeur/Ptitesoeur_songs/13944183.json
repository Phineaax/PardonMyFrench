      "lines": [
        {
          "n": "0",
          "text": "C'était similaire à l'enfer",
          "rhyme": "ER",
          "persona_id": "room1"
        },
        {
          "n": "1",
          "text": "J'ai monté tout mon corps à l'envers",
          "rhyme": "ER",
          "persona_id": "room1"
        },
        {
          "n": "2",
          "text": "(Y'avait plus que mes tripes)",
          "rhyme": null,
          "persona_id": "room1"
        },
        {
          "n": "3",
          "text": "Je crois que j'en voulais qu'à ma chair",
          "rhyme": "ER",
          "persona_id": "room1"
        },
        {
          "n": "4",
          "text": "M'a fait mal derrière la chapelle",
