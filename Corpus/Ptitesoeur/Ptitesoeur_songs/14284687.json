        {
          "n": "0",
          "text": "I don't know where we at",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Est c'que c'est la même for you ?",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "SI j'me tue me suivras tu j'esquisse le parfait près des ratures",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Même s'il existe pas, -te pas, -te pas Le paradis est à deux pas, deux pas, deux pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'revis le temps d'une mesure",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Ici c'est deux poids deux mesures",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Qu'importe à quel point je monte on restera des enfants d'la misère",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Même s'il existe pas, -te pas, -te pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Le paradis est à deux pas, deux pas, deux pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "J'veux m'accrocher à tes rêves",
          "rhyme": "Ev",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Parle moi des choses dont t'as envie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Chaque jour j'tue un peu plus mon égo mais c'est lui qui m'garde en vie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Dis-moi y a qui qui me tend, me tend, me tend",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Un bout du monde laisse moi le temps, le temps, le temps",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Pour juste un p'tit bout du cœur qui pourrait nous reconforter",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "C'est la passion qui nous traverse de la tête jusqu'à nos pieds",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Même s'il existe pas, -te pas, -te pas",
