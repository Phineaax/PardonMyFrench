  "lyrics": [
    {
      "section_id": "section_1",
      "type": "intro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Higher, higher",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Ils comprennent pas le job comme si on v'nait d'ailleurs",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Ce laud-sa s'fait des films j'rock pas de Hood By Air",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'vais diluer la peine dans le produit de Bayer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCA",
      "rhyme_vowel": "ABCA"
    },
    {
      "section_id": "section_2",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'passe par la way qu'a fait que m'blesser",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Way-way qu'à fait que m'blesser",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "La maille à l'image d'mes pêchés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Le boug à l'étage fait qu'lécher",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "On tangue à travers le desk",
          "rhyme": "Esk",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "On a qu'à tank le temps de l'averse",
          "rhyme": "ERs",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Le tanga fait que s'égarer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Respire même pas le temps d'une cigarette",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'te laisserai tailler mes cuisses sous la table du desk",
          "rhyme": "Esk",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "J'voulais en finir entre le mur et la caisse",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Les trois G, la goutte d'eau, j'sais pas choisir lequel",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Ma bish, j'fais les yeux doux à la vie quand elle me ken",
          "rhyme": "En",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AAAABCADBEFG",
      "rhyme_vowel": "AAAABBABBBBB"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "On fait les comptines pour les tits-pe qui veulent leur dose",
          "rhyme": "oz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'me suis jamais sentie aussi bien qu'près d'l'overdose",
          "rhyme": "oz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'vais pas be-ger soir-ce c'est promis",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "On mérite bien au moins le PIB",
          "rhyme": "ib",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Y a que le cash que j'appelle baby",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Ça veut nos têtes ouais très bien paye les",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Tu veux nos têtes ouais très bien payes les",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "[?] c'est la faute au hasard",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'ai fait que d'la merde depuis la casa",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "ACDC pas besoin de claim",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Le PDG n'est pas loin dla kish",
          "rhyme": "iS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Tu suces ma teub avant tu t'inclines",
          "rhyme": "in",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "T'es pas dans l'bail et toi tu t'impliques",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'me bats pour pas m'buter d'vant la pic",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "La douleur dans mes jambes m'donne la trique",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABCBDDEFGHIJJJ",
      "rhyme_vowel": "AABBBCCDDEBBBBB"
