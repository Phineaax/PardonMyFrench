          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tout est si facile et si compliqué",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Et je le sens au fond de moi, j'suis d'jà m-",
          "rhyme": "m",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Un jour ça va, un jour ça va pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Et je le sens au fond de moi, j'suis d'jà m-",
          "rhyme": "m",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'imagine que c'est l'équilibre",
          "rhyme": "ibR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Et je le sens au fond de moi qu'j'suis d'jà morte (ah-ah)",
