      "lines": [
        {
          "n": "0",
          "text": "Comme je t'aime, je t'aime, je t'aime, alright",
          "rhyme": "ajt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'ai pas tout fait pour le moral",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Y a des choses que j'ressens qu'on peut pas dire à l'oral",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Comme je t'aime, je t'aime, je t'aime",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Comme je t'aime, je t'aime, je t'aime",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Et je le sens au fond de moi, j'suis d'jà m-",
          "rhyme": "m",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Et je le sens au fond de moi, j'suis d'jà m-",
          "rhyme": "m",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Et je le sens au fond de moi qu'j'suis d'jà m-",
          "rhyme": "m",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Ah, mm, ah, mam, ah, mam, ah, mam",
          "rhyme": "am",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABBCCDDDE",
      "rhyme_vowel": "AAABBCCCA"
    },
    {
      "section_id": "section_8",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Personne me parle comme j'me parle, ah-ah-ah-ah, ah-ah-ah-ah",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "À force je sais plus qui écouter (je sais plus qui écouter)",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Comme je t'aime, je t'aime, je t'aime",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Donc j'apprends, ouais, j'apprends",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "À aimer l'cycle avant d'aimer la vie (avant d'aimer la vie)",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Hémisphère droit, hémisphère gauche ([la vie la mort, la vie la mort, la vie la mort, la vie la m- ?])",
          "rhyme": "oS",
          "persona_id": "Ptite_soeur"
        },
        {
