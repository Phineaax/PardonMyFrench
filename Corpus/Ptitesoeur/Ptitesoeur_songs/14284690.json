      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Et je lui tends juste un bout du monde (les humains font de l'ombre)",
          "rhyme": "$d",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Sa part obscure entretient l'imposture (l'autre bout du monde)",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Mais quel beau temps pour juste un bout du monde (les humains font de l'ombre)",
          "rhyme": "$d",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "En espérant qu'il soit vrai pour une fois",
          "rhyme": "a",
