    {
      "section_id": "section_2",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Tu m'as fait mal, donc si j’me bats c'est pour la life",
          "rhyme": "ajf",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'me ferais la malle avec une balle droit dans la face",
          "rhyme": "as",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Que j’ai hâte de m'libérer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Pendue dans l'back de ma house, on fait tous semblant d'arrêter",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Personne me forcera à rester (lick a knife, lick a knife, lick a knife)",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Personne me forcera à rester là",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "La vie, ma bish, c'pas Interstellar (lick a knife, lick a knife, lick a knife)",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "La fame, l'argеnt, ça pue la merde",
          "rhyme": "ERd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Sans l'amour, bih, c'еst plus la même",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Mais sans tout ça, j’serais d’jà plus là (là)",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Faut jamais baisser les bras",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Mais quand t'as mal, ils viennent tous le célébrer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Jeune dépressive et célèbre",
          "rhyme": "EbR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J’crache les mots qui brûlaient ses lèvres (lick a knife, lick a knife, lick a knife)",
          "rhyme": "EvR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Oublie pas d'mentir sur le web (wa, wa, wa, wa)",
          "rhyme": "Eb",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "J'leur ai supplié d'pas l’faire, ils l'font quand même (lick a knife, lick a knife, lick a knife)",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Putain, c'que j'ai hâte qu'on m'emmène",
          "rhyme": "En",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Comme l'oiseau, à l'autre bout du monde",
          "rhyme": "$d",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCCCDEFGDDCHIJGKL",
      "rhyme_vowel": "AABBBAACCAABCCCCCD"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "À l'autre bout du monde (ah-ahh)",
          "rhyme": "$d",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Tous les humains font de l'ombre à l'amour",
          "rhyme": "uR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "À l'autre bout du monde (si loin)",
          "rhyme": "$d",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Tous les humains font de l'ombre à la mort",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Les souvenirs dont on parle pas s'envolent avec le vent",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'sais plus qui y avait au bord quand on m'a laissée sous l'eau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Certains naissent avec la cuillère en argent",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "D'autres n'avaient pas d'autre choix que de lécher l'couteau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "T'en fais pas, ma belle, d'en bas j'ai d'jà fait toutes mes tasks, ouais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Parfois on est trop honnêtes, parfois on manque de tact",
          "rhyme": "akt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "N'fais pas les mêmes erreurs, sérieux, regarde comme je lack",
          "rhyme": "ak",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Reste underground, plus rien n'a d'sens vu d'en haut",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Du ciel que les humains sont beaux",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Tu l'remarques que quand ils partent en lambeaux (lick a knife, lick a knife, lick a knife)",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Personne m'a prévenu qu'la pute dans ma tête s'rait là pour toute la life",
          "rhyme": "ajf",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABACDEDEFGHEEEI",
      "rhyme_vowel": "ABACDEDEFGGEEEG"
    },
