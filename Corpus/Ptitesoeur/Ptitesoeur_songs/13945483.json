      "lines": [
        {
          "n": "0",
          "text": "Poseur s'étouffe sur ma queue c'est bon débarras",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'imprime du sous-sol on part plus jamais bara",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Baise mon desk, j'ai renversé toute la vovo tonic",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Tit-pe j'priais pour qu'on me fasse la lobotomie",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'doom dans le taudis",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "MNG comme deux Tonny",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Tu pompes les barres on va t'faire sucеr l'AT20-20",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "On fait la police",
          "rhyme": "is",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Ces tapins m'trouvent malpoliе",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Sur son crâne on fait des ollies",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Il avait déjà plus de cheveux",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Tu veux finir fait le bond, saute",
          "rhyme": "ot",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "J'marche sur les déchets de ma conso",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Block le 12MV dans le cargo",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Ma teub dans la teub à Sarko",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "MNG comme zig et sharko",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "On a bien baisé ces chards-clo",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        }
      ],
