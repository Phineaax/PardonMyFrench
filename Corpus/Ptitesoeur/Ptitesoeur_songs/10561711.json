        },
        {
          "n": "1",
          "text": "J'me réveille avec la gueule d'un cadavre",
          "rhyme": "avR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Faut qu'on investisse dans une catapulte",
          "rhyme": "ylt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "T'es-t'es dans le dièse, on n'en veut pas qu'à ta pute",
          "rhyme": "yt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Gem Soeur comme des politiciens",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'me suis d'jà fait péter par la police d'ici",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "W.E.F., Adrenochrome so good",
          "rhyme": "ud",
