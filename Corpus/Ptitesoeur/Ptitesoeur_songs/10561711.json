    {
      "section_id": "section_6",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Soeur Gem comme Brende et Schwab dans le B&B chez les Bilderberg",
          "rhyme": "ERg",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'm'en fous que ton coup d'pute me déçoive",
          "rhyme": "av",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Ma gueule, j'ai trop soif, j'ai plus rien à perdre",
          "rhyme": "ERdR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Faut qu'j'échappe aux vibrations qui vont vers le bas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Quand les vampires d'ici viennent pour presser le pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Patron du label a la main dans le col",
          "rhyme": "Ol",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Si j'mets la main sur un Colt, tu m'reverras pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Soeur Gem, faut j'me sorte du trou",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'aurais jamais dû lire l'rapport d'Marc Dutroux",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Je sais pas où j'vais mais je sais c'que j'vaux",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Y a beaucoup trop de veaux dans ce monde de fou",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Y a plus qu'les questions d'la masse pour les réponses évidentes",
          "rhyme": "#t",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Vie d'merde, plus rien n'est trépidant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'suis de Saturne, dans l'hexagone, j'suis résident",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Prépare le snipe, shoot le président",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        }
