        },
        {
          "n": "1",
          "text": "J'vis comme si j'respirais enfin",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Un peu d'air dont on m'a privé quand j'-",
          "rhyme": "Z",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Moi j'écris plus comme",
          "rhyme": "Om",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Mes yeux qui pleurent",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Je fixais l'heure",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Eux ils m'ont tous regardé comme l'éléphant dans la pièce",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCDEEF",
