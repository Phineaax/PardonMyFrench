        {
          "n": "0",
          "text": "On s'est blessés, mais c'est pas grave",
          "rhyme": "av",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'mettrai ma peine dans tes bagages",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'prends mon pied coincé sous l'avalanche",
          "rhyme": "#S",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "On pourra s'recroiser les bras ballants",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Tu reposes une dernière fois tes mains sur mes hanches",
          "rhyme": "#S",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
