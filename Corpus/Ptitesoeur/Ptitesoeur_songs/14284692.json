    },
    {
      "section_id": "section_3",
      "type": "pont",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Dis-moi, dis-moi, dis-moi, dis-moi, dis-moi, dis-moi comment faire",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'ai mal au cœur, puis c'est comme si j'avais pris dix ans ferme",
          "rhyme": "ERm",
