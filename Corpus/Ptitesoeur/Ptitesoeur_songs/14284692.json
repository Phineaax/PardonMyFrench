        },
        {
          "n": "5",
          "text": "Est-ce que si l'amour nous aime pas, on est ennemis alors ?",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "On est ennemis à hum",
