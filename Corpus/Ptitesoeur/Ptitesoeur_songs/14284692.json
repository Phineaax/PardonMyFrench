  ],
  "lyrics": [
    {
      "section_id": "section_1",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Regarde comme j'aime la vie depuis là-haut",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'envie l'amour que tu simules avec tes bijoux",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "L'environnement a fait de moi une ordure",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Comme je m'aimais quand j'étais encore pure",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Tout le monde est dans la pièce, face contre les angles",
          "rhyme": "#gl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'aimerais changer le monde, mais j'peux pas contrôler les gens",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Les contes et les légendes me suffisent plus pour rêver",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "On a tous merdé, y a méprise",
          "rhyme": "iz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'apprends à lâcher prise",
          "rhyme": "iz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Mon amour s'demande c'est quand que j'arrête de faire mes crises",
          "rhyme": "iz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Le temps s'écoule dans la mallette",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "À chaque seconde je m'arrête",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "À chaque seconde j'ai mal",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'm'en rends compte que quand j'écris",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Elle m'a senti comme une brise",
          "rhyme": "iz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Juste avant la tempête",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "J'faisais tout pour esquiver",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "L'éléphant dans la piè-è-èce",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCCDEFGGGHHIJGHFK",
      "rhyme_vowel": "ABCCDDEFFFGGHFFGEG"
    },
    {
      "section_id": "section_2",
