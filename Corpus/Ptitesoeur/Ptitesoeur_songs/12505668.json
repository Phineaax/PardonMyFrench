      "lines": [
        {
          "n": "0",
          "text": "La guala, la guala, la guala, la guala",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'ai niqué ma vie pour en faire et puis voilà",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "La police me surveille, c'est même pas une image",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "La police me surveille, c'est même pas une image",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "On s'était maudits à vie, B, j'avais pas l'âge",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'm'étais même mise à bibi dans les parages",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Faut sortir du jeu comme Emilia Pérez",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Y a que du balcon que le sol l'intéresse",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Il te d'mandait ton âme et toi, tu dis oui",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Petit, ça veut t'baiser comme Morandini",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "V-v-v-v'-esqui les cours, c'était courant ici",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Depuis qu'j'ai grandi, y a plus qu'des mourants ici",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "On doit tout renta' pour dompter les remords",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'voulais faire pareil puis t'es mort et re-mort",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "On a fait rage quit le MJ, B, c'est un record",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Avant d'sauter, ma chair s'accrochait sur le rebord",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        }
      ],
