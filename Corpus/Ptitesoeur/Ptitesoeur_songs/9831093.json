      "lines": [
        {
          "n": "0",
          "text": "On s'éloigne d'la piaule, à six serrés, bi’, ça fait l'effet d'la psoriasis",
          "rhyme": "is",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'fais qu'payer les pots cassés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu parles sur moi bish ? J'me fiche des mots passés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Dedans j'ai mal, mal, mal",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'arrive avec une ceinture au bal, bal, bal",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Elle parle mal, belek elle a pas d’parе-balles (Elle a pas de Pall Mall)",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J’rеpars du rencard en car car y a toujours pas la carte pour cop 100 cars",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "On peut faire 100K sans toi, guette les bi'",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Ça m’acclame quand j'coupe l'acap' 100 fois",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Laisse mes mains, j’peux faire des barz sans voix",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Cherche des comme toi, si j'en vois, j'envoie",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "MNG sur la route, c'est l'convoi qu'on voit",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "MFN, plus grand qu'toi, tu veux pas qu'on soit",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Abrège ou aboie, ça fait mal dehors",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "À bord j'arbore, ça fait mal dedans",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Tellement c'est acide dans la boca, j'name drop dans l'track avec le mal de dents",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "D'en bas, on a trouvé un peu d'or",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "On s'emballe pas, pas de pas de danse",
