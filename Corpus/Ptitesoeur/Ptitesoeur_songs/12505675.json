    },
    {
      "section_id": "section_7",
      "type": "outro",
      "performer": ", ",
      "lines": [
        {
          "n": "0",
          "text": "Hey boy, salut garçon",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Comment ça va ? Moi, j'ai niqué ma vie par passion",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Hey girl, salut, jeune fille",
          "rhyme": "ij",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Comment ça va ? J'vais niquer ma vie sur un plot twist",
          "rhyme": "ist",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Hey boy, va pas par là",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "On a d'jà testé, tous les chemins mènent au parloir",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Hey girl, ne te retourne pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Derrière les monstres sont si méchants, laisse-les dans l'placard",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABCDEDE",
      "rhyme_vowel": "AABBCCCC"
    }
