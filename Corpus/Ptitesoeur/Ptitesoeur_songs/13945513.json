        },
        {
          "n": "9",
          "text": "Le reuf ne m'a jamais vue si pâle",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Jamais j'retourne bas-là, 'vec le plombier d'la municipale",
          "rhyme": "al",
