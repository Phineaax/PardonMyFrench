        },
        {
          "n": "5",
          "text": "Turn",
          "rhyme": "9Rn",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Si j'l'envoie qui rend la balle après?",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "La dèche",
          "rhyme": "ES",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "On a lock-in quatre ans",
