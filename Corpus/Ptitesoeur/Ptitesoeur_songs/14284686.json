      ],
      "rhyme": "ABCCDDEE",
      "rhyme_vowel": "ABCCDDEE"
    },
    {
      "section_id": "section_5",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Aaah, on peut pas rater l'opération",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'oublie pas qu'on s'est faits dans la coopération",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Moi je détruisais tout c'que je créais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'ai fait des toncar avec mon carnet",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'dois composer 'vec leurs secrets (ça m'plaît pas)",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Ma douleur porte un goût sucré depuis que j'la déguste",
          "rhyme": "yst",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Je fais l'artiste ou j'fais la muse ?",
          "rhyme": "yz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Peu importe on voulait s'amuser, quelle misère",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'crois plus en la dualité",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Y a qu'ensemble qu'on forme la réalité",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "En été, en hiver, ça m'importe peu, face aux lois d'l'univers",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Le temps passe, les jeunes meurent",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "P-P-P-P-Pour financer des gambas",
          "rhyme": "as",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Peu importe je gambaderai",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "On détruit puis on crée, on crée, on crée, on crée, on crée, on crée, on crée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABBBCDEFFEGHBF",
      "rhyme_vowel": "AABBBCCBDDBEFBD"
    }
  ]
