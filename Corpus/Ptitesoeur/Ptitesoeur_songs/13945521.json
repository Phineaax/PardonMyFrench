        },
        {
          "n": "5",
          "text": "Tu voulais m'acheter mais tu n'as pas de blé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "T'as des kilos de prods, tu n'as pas d'quoi meubler",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "On fait la tête d'affiche quand y a pas de plan B",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Quinze heures par jours tu peux [?]",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
