    {
      "section_id": "section_10",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "On lave ces bâtards à l'eau d'javel, la track elle s'arrête jamais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'ai chié partout pendant ta diarhée, on arrive en r'tard comme les trains",
          "rhyme": ")",
