        },
        {
          "n": "16",
          "text": "L'argent sale ma leug' c'est ma happy bara",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Tu sais ma leug' y a des trucs qui s'achètent pas",
