        },
        {
          "n": "2",
          "text": "J'cala pas l'agent du coup son label est fâché",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "On s'en balec' t'façon son label il est fauché, maintenant, il est fauché",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Il est pauvre, ma le-geu il est pauvre, que passa hombre?",
          "rhyme": "$bR",
