        },
        {
          "n": "2",
          "text": "Bish la vie m'a train, dis-moi ils suck ma strain",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Bish et la bish dans l'bain",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "La kich' dans l'bain, la vie d'en bas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Je me sens comme Johnny Crying (poser)",
