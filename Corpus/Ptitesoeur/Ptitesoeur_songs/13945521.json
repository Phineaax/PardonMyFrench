        },
        {
          "n": "3",
          "text": "Le cachet c'est l'même si j'rate la perf au set",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Switch, moi j'ai ma beuteu",
