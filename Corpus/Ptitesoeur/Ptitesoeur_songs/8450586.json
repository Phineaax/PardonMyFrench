  "lyrics": [
    {
      "section_id": "section_1",
      "type": "intro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "It came to you that day..",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "The day Mari died",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "When MARI..",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "When MARI fell",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "You... You couldn't have done it",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "It was something behind you... wasn't it ?",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCDEE",
      "rhyme_vowel": "ABCACC"
    },
    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'ai pas tué MARI",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Attend c'est la présomption d'innocence",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Pour s'réchauffer on va faire mariner son corps dans l'essence",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Anatomie complète mais il f'ra plus usage de ses sens",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'en fais beaucoup trop putain la vie elle part dans tous les sens",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Suite de caractère risqué comme dans rockyou.txt",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Avant d'pomper la vague lil hoe j'suis pas sûr que t'existais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "On fait tout dans la démesure",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Otherkin mi-humain mi-dieu tu verras pas dans mes yeux",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "On va tout faire on beat",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Lil hoe là j'fais des blancs à chaque mesure",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Partie inhabituelle tu comprends pas mais j'articule",
          "rhyme": "yl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Ils écoutent [?]",
          "rhyme": "ut",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "On l'aura pas à l'usure",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Bitch t'iras où après la mort si t'es hautain comme Usul?",
          "rhyme": "yl",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABBBBCDEFGEHIEH",
      "rhyme_vowel": "ABBBBBCDEADDFDD"
    },
    {
      "section_id": "section_3",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Putain j'l'aurai pas à l'usure",
          "rhyme": "yR",
