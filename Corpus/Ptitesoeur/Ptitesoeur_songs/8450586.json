        },
        {
          "n": "1",
          "text": "J'ai 9999 HP mais il fait l'dur",
          "rhyme": "yR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "On fait des pas mais c'est pas sûr",
          "rhyme": "yR",
