    {
      "section_id": "section_4",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "(Verse)",
          "rhyme": null,
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "9-6-4 face à la machine ça baise le moteur dès qu'on démarre",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Loin d'l'époque où SoundCloud c'était des school shooters et des trimars",
          "rhyme": "aRs",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Quinze ans c'est trop tôt j'aurais pu mâcher mes paras comme des Kréma",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Poker face quand c'boug a fell off j'avais les yeux c'était des trémas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "On n'avait rien prévu, on a jamais fait de backup",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Dollar, euro, yen j'adore dépenser c'qu'on a pile up",
          "rhyme": "9p",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Personne va les couronner, pourquoi ils m'parlent de cojones ?",
          "rhyme": "On",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Même dans leur ville de merde y a d'ces bâtards qui nous reco- N-",
          "rhyme": "n",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "On m'éduque pas moi si j'fais 100K moi j'm'achète du PCP",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Pas d'mesure B on baise ton média rap comme la BBC",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "T'sais même pas DL FL tu penses signer chez ADA",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "On a made it, y a d'jà d'ces bâtards qui copient la DA",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'imprime allongée B si on s'lève",
          "rhyme": "Ev",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "C'est pas l'4ème art, c'est l'11ème",
          "rhyme": "Em",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Va faire tes tals et prends tes xans frère",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "La fin d'la partie signée double G l'unique e-",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        }
      ],
