        },
        {
          "n": "2",
          "text": "J't'ais d'vant l'miroir la ge-gor démangeait l'one blade",
          "rhyme": "ad",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "B, si j'canne, call pas l'nine-one-one, d'jà",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Ça m'tend l'contrat qui stipule de r'faire le one man one jar",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Hey, GG well played",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J't'ais d'vant l'miroir la ge-gor démangeait l'one blade",
          "rhyme": "ad",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Gario belle garce",
          "rhyme": "aRs",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Fuck les play-backs",
          "rhyme": "ak",
