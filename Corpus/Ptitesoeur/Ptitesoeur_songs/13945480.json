  "lyrics": [
    {
      "section_id": "section_1",
      "type": "intro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Yeah, yeah, they like: \"How this white boy do that?\"",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Pop my shit, 'cause I'm a cool cat",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Run through these racks, I got new racks",
          "rhyme": "ak",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AAB",
      "rhyme_vowel": "AAA"
    },
    {
      "section_id": "section_2",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'remplis mes poches quand j'me rapproche d'la vie d'la veille",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Planter tes proches, tu vas le faire juste pour la paye",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'ai fait mon cash, j'm'en bats les couilles d'l'avis d'la vieille",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'ai fait mon cash, j'm'en bats les couilles d'l'avis d'la vieille",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "J'ai fait mon cash, j'm'en bats les couilles d'l'avis d'la vieille",
          "rhyme": "Ej",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AAAAA",
      "rhyme_vowel": "AAAAA"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'f'rais pas la passe à tous ces poseurs, rien de nouveau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "M.N.G n'a pas de bourreau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Nous on passe pas sous le bureau",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'vais m'la trancher avec le bout rond",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Passer une coms' me donne le bourdon",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'ai tout zappé dans le bourbon",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Niquer ma te-tê sur le goudron",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "J'suis sur un plav', bish, il est bourbier",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "À la base, c'était passionnel",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "On n'est pas vraiment professionnels",
          "rhyme": "El",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Les professionnels veulent nous groomer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Et les groomeurs restent groupés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Ramène ton gros crâne qu'on l'allège",
          "rhyme": "EZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "M.N.G en calèche",
          "rhyme": "ES",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "On le reprend si ton gars l'laisse",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "L'quart d'la géné' me fait d'la lèche",
          "rhyme": "ES",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Toi, t'aimes mettre ton nez dans les galères",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "J'appelle Blizzard pour faire le manège",
          "rhyme": "EZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "T'es dans l'jeu, t'as même pas les manettes",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "J'ai les chevilles d'la taille d'la planète",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Fais gicler l'liquide de sa braguette",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "Bish, j'étais livide pour ce brin d'herbe",
          "rhyme": "ERb",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "Oui, j'étais livide pour ce brin d'herbe",
          "rhyme": "ERb",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "On dirait bien qu'on veut le bread",
          "rhyme": "Ed",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "On dirait bien qu'tu veux ma baguette",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AAABBBBCDDCCEFGFHEIIIJJKI",
      "rhyme_vowel": "AAABBBBCDDCCDDDDDDDDDDDDD"
    },
