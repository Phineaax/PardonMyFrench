      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Et j'fais la musique avec les basses vibrations",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "On les fait courir pour la maille, comme Sidaction",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'ai pas la ceinture dans la voiture, sin-cou freine",
          "rhyme": "En",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "J'me réveille, trois G, j'ai déjà les acouphènes",
