    },
    {
      "section_id": "section_5",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'ai fait les cent pas, y avait qu'des caves dans le périmètre",
          "rhyme": "EtR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Ils écoutaient, c'bâtard a périmé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Il veut m'frapper dans le périnée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Tu cook un bail, il est d'jà périmé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Même l'aveugle il cala le dénivelé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'mets pas de côté pour me délivrer",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'peux même chanter \"Libérée, délivrée\"",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Ma pute n'apprécie pas le délivre",
          "rhyme": "ivR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Comme j'ai mal, tu sais qu'le dél' est vrai",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Pour prendre ma dose, tu sais qu'le tél' est près",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'rentre du concert, tant mieux, l'hôtel est prêt",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Loin d'l'époque où ça s'voyait dans mes prés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Cette life a fait des tunnels dans mes plaies",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Parle pas d'mon blase, on peut pas l'épeler",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Y a toujours pas grand monde pour m'épauler",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "M.N.G dans la cave démantelée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "On grattait l'te-shi dans des mentholées",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Parle pas aux caves qui te demande salaire",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "C'est vrai maintenant donc toi tu manges ta lèvre",
          "rhyme": "EvR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "J'm'attrape la gorge, tout ça, c'est qu'[?]",
          "rhyme": "k",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Khabat, j'frappe les cordes comme un métalleux",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABBBBBBCDDDBDBBBBEFGH",
      "rhyme_vowel": "ABBBBBBCAAABABBBBAADE"
