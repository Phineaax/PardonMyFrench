  "lyrics": [
    {
      "section_id": "section_1",
      "type": "intro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Oh ma baby, baby, baby",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Personne n'est parfait-fait-fait-fait-fait",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Donc je t'aime à hauteur de tes péchés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Ils veulent figer notre monde, on doit s'dépêcher",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Oh ma baby, baby, baby",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Personne n'est parfait-fait-fait-fait-fait",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Cependant toi t'as participé, quand ils m'ont r'trouvée sur le parquet-quet-quet-quet",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCCABB",
      "rhyme_vowel": "ABCCABB"
    },
    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Dans cette life de merde, j'ai facilement consommé mille grammes",
          "rhyme": "am",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "J'étais sur la chaise, y avait l'bouton d'l'expérience de Milgram",
          "rhyme": "am",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu connais pas les humains, pourquoi tu stan fort ?",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Choisis de quel côté tu es d'l'expérience de Stanford",
          "rhyme": "ORd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Faut croire en les gens que le monde abandonne",
          "rhyme": "On",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Nourrir la répulsion, j'l'ai fait abondamment",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'me bats pour trouver l'équilibre dans la bonbonne",
          "rhyme": "On",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Donc j'appréhende les mauvais d'après comme je recompte les bons d'avant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Faut faire un bond en avant, même avec bon d'avance",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Tu t'demandes quel était mon chemin, j'sais pas mais bon j'avance",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABCDEDEFF",
      "rhyme_vowel": "AABBBCBCCC"
    },
    {
      "section_id": "section_3",
      "type": "pré-refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Sur la cadence, j'avance, même quand ça danse plus, j'avance",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Quand j'suis derrière, j'avance, quand j'suis loin devant, j'avance",
          "rhyme": "#s",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AA",
      "rhyme_vowel": "AA"
    },
    {
      "section_id": "section_4",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
