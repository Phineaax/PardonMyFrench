    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'suis bloquée chambre 1 comme dans BHR",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Faut doubler l'cachet pour le VHR",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Le temps l'a marqué.e comme du copper bleu",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Pourquoi tu donnes du gaz à des gobeurs de",
          "rhyme": "@",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "C'est tous des porteurs de chapeau comme le sheriff",
          "rhyme": "if",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'aurais déjà prié Satan si j'étais née riche",
          "rhyme": "iS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "S'il cala pas la bar on a qu'à radoter",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Nada dans mes poches mais t'en fais pas ma beauté",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Les gars concernés peuvent même pas venir en concert",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Ils gaspillent des ronds dans des rappeurs en conserve",
          "rhyme": "ERv",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'suis qu'un jour à jeun bish jamais je vais DM",
          "rhyme": "EtR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "La vie devenait pire que les posts de VDM",
          "rhyme": "EtR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "Le skin du gourou avec les trois lettres brodées",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'ai serré ma bish m'a dit casse toi sale droguée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "J'sors pas beaucoup les putes elles sont à deux pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Quand j'consomme au moins la drogue elle m'insulte pas",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Même quand je dors j'imprime assez de pesos",
          "rhyme": "Os",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Un poseur pareil qui copie c'est dénigrant",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "L'élite met tes tales dans la soirée chemsex",
          "rhyme": "Eks",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "Pendant qu'toi tu t'indignes des trannys et des migrants",
          "rhyme": "#",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "J'pète la conso d'une équipe et j'crame un bout seule",
          "rhyme": "9l",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "J'avance et y avait pas d'aiguilles dans ma boussole",
          "rhyme": "Ol",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "Le suicide est pas remboursé par la sécu",
          "rhyme": "y",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Avant je frottais l'escarre avec le P-",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABCDEFFAGHHFFIIJKLKMNOP",
      "rhyme_vowel": "AABCDDEEAAAAEEFFGHAHIGJK"
    },
