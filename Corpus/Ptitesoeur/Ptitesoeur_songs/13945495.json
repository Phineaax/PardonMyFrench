    {
      "section_id": "section_4",
      "type": "outro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'allais pas traîner 'vec ces gars juste pour m'droguer dans leur gova",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Tu tends l'contrat j'suis déçue, j'm'attendais à au moins six-sept ovales",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "La prochaine fois tu rajoutes ton trou d'balle béant à la propal'",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "La prochaine fois tu rajoutes ta baraque, ta gov' à la propral'",
