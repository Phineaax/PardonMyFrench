          "rhyme": "En",
          "persona_id": "room1"
        },
        {
          "n": "3",
          "text": "Une nouvelle douleur par quart d'heure",
          "rhyme": "9R",
          "persona_id": "room1"
        },
        {
          "n": "4",
          "text": "Qui m'aurait vu devenir si faible ?",
          "rhyme": "Ebl",
          "persona_id": "room1"
        }
      ],
      "rhyme": "AAABC",
      "rhyme_vowel": "AAABA"
    },
    {
      "section_id": "section_3",
      "type": "post-refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Un peu d'poison dans un verre terne",
          "rhyme": "ERn",
          "persona_id": "room1"
        },
        {
          "n": "1",
          "text": "Un court parcours sur mes vertèbres",
          "rhyme": "EbR",
          "persona_id": "room1"
        },
        {
          "n": "2",
          "text": "Deux mots coincés dans une artère",
          "rhyme": "ER",
          "persona_id": "room1"
        },
        {
          "n": "3",
          "text": "Coupe moi les mains pour me faire taire",
          "rhyme": "ER",
          "persona_id": "room1"
        }
      ],
      "rhyme": "ABCC",
      "rhyme_vowel": "AAAA"
    },
    {
      "section_id": "section_4",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Si tu t'attaches, j'te laisserai, pleure",
          "rhyme": "9R",
          "persona_id": "room1"
        },
        {
          "n": "1",
          "text": "Si tu m'attrapes, j'me laisserai faire",
          "rhyme": "ER",
          "persona_id": "room1"
        },
        {
          "n": "2",
          "text": "Les yeux fermés quand tout s'dévoile",
          "rhyme": "al",
          "persona_id": "room1"
        },
        {
          "n": "3",
          "text": "Le cœur ouvert quand l'ciel se ferme",
          "rhyme": "ERm",
          "persona_id": "room1"
        },
        {
          "n": "4",
          "text": "Partir le temps que l'affaire sèche",
          "rhyme": "ES",
          "persona_id": "room1"
        },
        {
          "n": "5",
          "text": "Corps entre l'âme et la chair fraîche",
          "rhyme": "ES",
          "persona_id": "room1"
        },
        {
          "n": "6",
          "text": "Qu'est-ce qui change cette fois devant la glace ?",
          "rhyme": "as",
          "persona_id": "room1"
        },
        {
          "n": "7",
          "text": "Elle s'est installée sans la place",
          "rhyme": "as",
          "persona_id": "room1"
        },
        {
          "n": "8",
          "text": "Il ferait tout pour mes demandes",
          "rhyme": "#d",
          "persona_id": "room1"
        },
        {
          "n": "9",
          "text": "Pourquoi dis-tu qu'il m'aide, il ment",
          "rhyme": "#",
          "persona_id": "room1"
        },
        {
          "n": "10",
          "text": "Monstre au boulevard de mes deux hanches",
          "rhyme": "#S",
          "persona_id": "room1"
        },
        {
          "n": "11",
          "text": "Trois plaies cachées sous mes deux manches",
          "rhyme": "#S",
          "persona_id": "room1"
        },
        {
          "n": "12",
          "text": "On s'verra tout les deux dimanche",
          "rhyme": "#S",
          "persona_id": "room1"
        }
      ],
      "rhyme": "ABCDEEFFGHIII",
      "rhyme_vowel": "ABCBBBCCDDDDD"
