  "lyrics": [
    {
      "section_id": "section_1",
      "type": "intro",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Chaque pas de plus vers la falaise",
          "rhyme": "Ez",
          "persona_id": "room1"
        },
        {
          "n": "1",
          "text": "Me rapproche de la forme finale",
          "rhyme": "al",
          "persona_id": "room1"
        },
        {
          "n": "2",
          "text": "Transforme une forme abominable",
          "rhyme": "abl",
          "persona_id": "room1"
        },
        {
          "n": "3",
          "text": "De la douleur abdominale",
          "rhyme": "al",
          "persona_id": "room1"
        },
        {
          "n": "4",
          "text": "Les proches tombent comme des dominos",
          "rhyme": "o",
          "persona_id": "room1"
        },
        {
          "n": "5",
          "text": "Trop loin des yeux d'nous deux minots",
          "rhyme": "o",
          "persona_id": "room1"
        },
        {
          "n": "6",
          "text": "J'incise un doute par chemin",
          "rhyme": ")",
          "persona_id": "room1"
        }
      ],
      "rhyme": "ABCBDDE",
      "rhyme_vowel": "ABBBCCD"
    },
    {
      "section_id": "section_2",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Une nouvelle douleur par semaine",
          "rhyme": "En",
