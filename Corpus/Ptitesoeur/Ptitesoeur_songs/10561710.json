  "lyrics": [
    {
      "section_id": "section_1",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'affronte le mauvais sort",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Soeur Gem les professors (huun, huuun)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Descend avec nous, c'est mort",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Tes sangs c'est tous des porcs (yeah, yeah)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "On les a baisé en back to back (huun)",
          "rhyme": "ak",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "D'vant l'pc speak en fact to fact",
          "rhyme": "akt",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'affronte le mauvais sort",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Soeur Gem les professors (yeah, yeah)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Descend avec nous, c'est mort",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Tes sangs c'est tous des porcs (huun, huuun)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "On fait leur merde sans les études, toi tu vas crier \"ça c'est fort\" (huun, huuun)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Qui a prié pour mon downfall n'a pas prié assez fort (heeu)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AAAABCAAAAAA",
      "rhyme_vowel": "AAAABBAAAAAA"
    },
    {
      "section_id": "section_2",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Bientôt j'me casse, j'en ai marre des gueux",
          "rhyme": "2",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Gemroz Gario comme MNG²",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'ai l'inspi qui exauce les vœux",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "De l'ordi on imprime, jamais on s'lève",
          "rhyme": "Ev",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Dans le 18 comme dans l'5",
          "rhyme": "l",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "T'es ni mon frère ni mon zinc",
          "rhyme": ")g",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Les propositions sont minces",
          "rhyme": ")s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Moi je vaux 1 million 5",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "On a vu toi t'enchainais bite sur bite",
          "rhyme": "it",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "Les valeurs sont en sang comme streamer sur Kick",
          "rhyme": "ik",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "J'ai beaucoup trop faim, j'ai pas la main sur l'cœur",
          "rhyme": "9R",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "J'suis né doomé, j'avais la main sur l'bide",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "C'est des sacs à merde, z'ont pas d'âme",
          "rhyme": "am",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Quand j'y suis, j'suis l'meilleur d'Paname",
          "rhyme": "am",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Sur l'ring comme Rey, j'met des six-one-nine",
          "rhyme": "in",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "J'suis nobody, une hook machine banal",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Nouvelle peine que j'écope, nouvelle peine que j'essorre (hey, hey)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Nouveau croc sur le corps, j'suis monsieur j'ai le mort (hey, hey)",
          "rhyme": "OR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "Fait l'mal en face de nous, ce soir j'suis dans la loop (hey, hey)",
          "rhyme": "up",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "J'ai mangé, une faim de loup, faut finir dans le Louvre (feey)",
          "rhyme": "uvR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Faut je braque la banque des âmes, où sont passés tous mes Phillies",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "Faut qu'je rec un nouveau bail, sans cette merde je me sens si vide (hey)",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "J'entasse les sous, j'mets d'la haine dans mes bails",
          "rhyme": "Ejl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Je sais c'que la money imply",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "J'suis sûr de nous, j'ai jamais changé d'side",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "25",
          "text": "Gem Soeur comme Bonnie and Clyde",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "ABCDEFGBHIJKLLMNOOPQRKSRKK",
      "rhyme_vowel": "ABCDEFFBGGHGIIGIJJKKGGDGGG"
    },
    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Gem Soeur fuck les plafonds de verre",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Belek nos bougs sur la track ils sont devins (hee)",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Toi t'es stuck au plafond de merde",
          "rhyme": "ERd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Si j'tombe OSEF j'remonte des bas fonds demain (hee)",
          "rhyme": ")",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Gem Soeur c'est la bonne combine",
          "rhyme": "in",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "Je grind les deux bras dans ma Cop-Copine",
          "rhyme": "in",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Des gens biens, t'as pas l'quota",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "T'façon toi B tes gars c'est des pâles copies (hee)",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Digital money, je flex",
          "rhyme": "Eks",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "On god devant l'ordi je pex",
          "rhyme": "Eks",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "USDT c'est mes racks",
          "rhyme": "ak",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "On me demande si je perce",
          "rhyme": "ERs",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "On passe des SOS au bless on bless",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "Si j'le dis, j'le fais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "Si on blesse, on blesse",
          "rhyme": "Es",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "Dans la classe, c'était pas nous les mieux notés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "Sur le web on est free comme les menottés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Gem Soeur comme Ye et Bianca",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "Avant ça j'étais banca",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "Pisté des plavons bancals",
          "rhyme": "al",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Nique sa mère le plafond bancaire",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "Faut qu'la bish reparte en calèche",
          "rhyme": "ES",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "100x ta dose ça m'a calé",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Sur la prod, y'a 2 macabés",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "Veulent nous jarter comme à Calais",
          "rhyme": "E",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "25",
          "text": "Parle pas avec ces pétasses",
          "rhyme": "as",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "26",
          "text": "B c'est des sheep",
          "rhyme": "ip",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "27",
          "text": "Que des pions bons qu'à faire des dac'o'dac",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "28",
          "text": "Toi tu veux qu'on colle et qu'on collab",
          "rhyme": "ab",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "29",
          "text": "Oublie ma gueule ton taff vaut pas 1 cacolac",
          "rhyme": "ak",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "30",
          "text": "J'entasse les sous",
          "rhyme": "u",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "31",
          "text": "J'mets d'la haine dans mes bails",
          "rhyme": "Ejl",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "32",
          "text": "Je sais c'que la money imply",
          "rhyme": "i",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "33",
          "text": "J'suis sûr de nous, j'ai jamais changé d'side",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "34",
          "text": "Gem Soeur comme Bonnie and Clyde",
          "rhyme": "id",
          "persona_id": "Ptite_soeur"
        }
