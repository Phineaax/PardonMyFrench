    {
      "section_id": "section_3",
      "type": "couplet",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "J'passe de highlight au bye-bye",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "1",
          "text": "Il doit gratter pour prendre mon cash dans un drive-by",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "J'dois toujours payer pour les péchés de la past-life",
          "rhyme": "ajf",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Les-les péchés de la fast-life",
          "rhyme": "ajf",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Faut s'dépêcher pour les bagages",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'veski les méchantes depuis bas âge",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "J'baise les poseurs, son dos fait l'dos-d'âne",
          "rhyme": "an",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Ma bish est basée, stream pas Donda",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "Mais quel est donc ce don qu't'as",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "9",
          "text": "C'est celui d'mal lécher mon gros paff",
          "rhyme": "af",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "10",
          "text": "Si tu parles trop Sim mets des grosses baffes",
          "rhyme": "af",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "11",
          "text": "Ça m'fait du papier quand le gosse bave",
          "rhyme": "av",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "12",
          "text": "On avait tapé là où l'boss taffe",
          "rhyme": "af",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "13",
          "text": "J'vais me servir galon dans une grosse tache",
          "rhyme": "aS",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "14",
          "text": "J'm'arrache un ongle et j'tire une grosse taff",
          "rhyme": "af",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "15",
          "text": "J'crache dans mes déchets j'fais la pose",
          "rhyme": "oz",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "16",
          "text": "J'fais mon cash et j'prends ma [?]",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "17",
          "text": "Non jamais on s'accorde",
          "rhyme": "ORd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "18",
          "text": "Il m'a ché-bran comme un c-",
          "rhyme": "s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "19",
          "text": "J'fais mon cash et j'prends ma [?]",
          "rhyme": "a",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "20",
          "text": "Il m'a ché-bran comme un c-",
          "rhyme": "s",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "21",
          "text": "Non jamais-jamais on s'accorde",
          "rhyme": "ORd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "22",
          "text": "Il m'a ché-bran comme un cow-boy",
          "rhyme": "Oj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "23",
          "text": "Pour un bout d'sa peau j'serais sa hoe boy",
          "rhyme": "Oj",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "24",
          "text": "Non jamais-jamais on s'accorde",
          "rhyme": "ORd",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "25",
          "text": "J'veux qu'il mette des coups d'lame dans l'heart",
          "rhyme": "aR",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "26",
          "text": "On s'compte plus dans l'malaise",
          "rhyme": "Ez",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "27",
          "text": "C'est mon dièse donc j'le fais all the way",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "28",
          "text": "C'est par chez nous, passe par la high-way",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "29",
          "text": "T'abimais que j'voulais pas faire",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "30",
          "text": "J'rejette le dièse qu'on fini par faire",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "31",
          "text": "On vient du ciel pour finir par terre",
          "rhyme": "ER",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "32",
          "text": "Macère l'produit près d'mes affaires",
          "rhyme": "ER",
