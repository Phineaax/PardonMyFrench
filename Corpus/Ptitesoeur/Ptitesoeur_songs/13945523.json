        },
        {
          "n": "1",
          "text": "Une cannette, deux cannettes, trois cannettes, quatrе cannettes, cinq cannettеs",
          "rhyme": "$",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Tu veux nous voir perf il faut",
          "rhyme": "o",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Un K net, deux K net, trois K net, quatre K net, cinq K net",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Là j'ai au moins vidé",
