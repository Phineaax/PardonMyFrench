        },
        {
          "n": "1",
          "text": "MNG l'intro j'vais la gâcher",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "2",
          "text": "Appuie sur la cloche ou la gachette",
          "rhyme": "Et",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "3",
          "text": "Avec le printer je suis casée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "4",
          "text": "Avec le blinker je suis gazée",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "5",
          "text": "J'retape la tour qu'a failli casser",
          "rhyme": "e",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "6",
          "text": "Bouge du rooftop au marécage",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "7",
          "text": "Y a trente-six balles y a pas les cages",
          "rhyme": "aZ",
          "persona_id": "Ptite_soeur"
        },
        {
          "n": "8",
          "text": "J'parle même pas et j'fais des mailles",
          "rhyme": "aj",
          "persona_id": "Ptite_soeur"
        }
      ],
      "rhyme": "AABAAACCD",
      "rhyme_vowel": "AABAAACCC"
    },
    {
