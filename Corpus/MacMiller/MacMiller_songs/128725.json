{"song_id": 128725, "title": "You", "language": "en", "lyricists": [4389143], "lyrics": [{"section_id": "section_0", "type": "intro", "performer": "", "lines": [{"n": "0", "text": "I'd like to say thank you, for joining us this evening", "rhyme": "iN", "persona_id": "Larry_Lovestein"}, {"n": "1", "text": "I hope you enjoyed yourself", "rhyme": "Elf", "persona_id": "Larry_Lovestein"}, {"n": "2", "text": "Now the boys and I have one more number we'd like to play for you", "rhyme": "u", "persona_id": "Larry_Lovestein"}, {"n": "3", "text": "I hope you stick around, these are the after hours", "rhyme": "uR", "persona_id": "Larry_Lovestein"}, {"n": "4", "text": "So my fellas in here", "rhyme": "eR", "persona_id": "Larry_Lovestein"}, {"n": "5", "text": "Pour up one more glass of scotch, stick around for a little bit", "rhyme": "it", "persona_id": "Larry_Lovestein"}, {"n": "6", "text": "And all the ladies", "rhyme": "iz", "persona_id": "Larry_Lovestein"}, {"n": "7", "text": "What I want you to do right now", "rhyme": "o", "persona_id": "Larry_Lovestein"}, {"n": "8", "text": "I want you to look me directly in my eyes", "rhyme": "Ej", "persona_id": "Larry_Lovestein"}, {"n": "9", "text": "I can promise you this, I will be looking back at you", "rhyme": "u", "persona_id": "Larry_Lovestein"}, {"n": "10", "text": "And I see you, I see you", "rhyme": "u", "persona_id": "Larry_Lovestein"}], "rhyme": "ABCDEFGHICC", "rhyme_vowel": "ABCCDAAEBCC"}, {"section_id": "section_1", "type": "verse", "performer": "", "lines": [{"n": "0", "text": "Baby, you", "rhyme": "u", "persona_id": "Larry_Lovestein"}, {"n": "1", "text": "Your smile remind me of sunshine, girl", "rhyme": "9Rl", "persona_id": "Larry_Lovestein"}, {"n": "2", "text": "You smile just like roses", "rhyme": "oz", "persona_id": "Larry_Lovestein"}, {"n": "3", "text": "You say you don't, don't need a man", "rhyme": "#", "persona_id": "Larry_Lovestein"}, {"n": "4", "text": "Well, I just want your lovin', darlin'", "rhyme": ")", "perso