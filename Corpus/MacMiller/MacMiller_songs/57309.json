      "lines":[
        {
          "n":"0",
          "text":"We spendin' all this",
          "rhyme":"i",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"Money, gettin' all this shine, hittin' all this",
          "rhyme":"i",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"2",
          "text":"Cuddi, spendin' all this time, I'm",
          "rhyme":"Om",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"3",
          "text":"Feelin' better than ever before (Ever before)",
          "rhyme":"OR",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"4",
          "text":"This my life for better or for—",
          "rhyme":"OR",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"5",
          "text":"All this money, gettin' all this shine, and it's all so",
          "rhyme":"o",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"6",
          "text":"Funny, 'cause it's all just mine, I'm",
          "rhyme":"Om",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"7",
          "text":"Feelin' better than ever before (Ever before)",
          "rhyme":"OR",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"8",
          "text":"This my life (Hey) for better or for worse",
          "rhyme":"ORs",
          "persona_id":"Mac_Miller"
        }
      ],
      "rhyme":"AABCCDBCE",
