    },
    {
      "section_id":"section_1",
      "type":"verse",
      "performer":"",
      "lines":[
        {
          "n":"0",
          "text":"I'm lookin' out the window, the kid stayin' lit like a Zippo",
          "rhyme":"o",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"1",
          "text":"You hatin', I don’t trip, bro, it's gravy, 'cause your bitch know",
          "rhyme":"o",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"2",
          "text":"Cup of Henny, I sip slow, the spins, yo",
          "rhyme":"o",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"3",
          "text":"Hit the stage to bust a rhyme, call me Flipmode",
          "rhyme":"Od",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"4",
          "text":"This, that, the other, I'ma make it happen",
          "rhyme":"@n",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"5",
          "text":"Travel all around the country in a station wagon",
          "rhyme":"$",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"6",
          "text":"Take it back, you reminisce on all your favorite classics",
          "rhyme":"ik",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"7",
          "text":"My words play more than Mad Libs",
          "rhyme":"ib",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"8",
          "text":"I got plenty lyrics, they got plenty ad-libs",
          "rhyme":"ib",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"9",
          "text":"Warn the holy spirit, my father's on some rap shit",
          "rhyme":"it",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"10",
          "text":"Listenin' to Tribe, gettin' high, puffin' lye",
          "rhyme":"i",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"11",
          "text":"See some people ridin' by, come outside, say what up",
          "rhyme":"9p",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"12",
          "text":"I ain't nothin' like a star, I’m chillin', layin' back",
          "rhyme":"ak",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"13",
          "text":"Travel round the whole world, enjoyin' everywhere I'm at",
          "rhyme":"a",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"14",
          "text":"Meetin' different people, eatin' different food",
          "rhyme":"ud",
          "persona_id":"Mac_Miller"
        },
        {
          "n":"15",
          "text":"No one like a gourmet meal more than Q though",
          "rhyme":"O",
          "persona_id":"Mac_Miller"
        }
      ],
      "rhyme":"AAABCDEFFGHIJKLM",
      "rhyme_vowel":"AAABCDEEEEEFGGHB"
