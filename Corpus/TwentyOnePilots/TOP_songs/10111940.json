        {
            "section_id": "section_0",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I can't be alone",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "Guess I never told you so",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Makin' my way towards you",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "Tracin' out a line",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "A route I've mapped a thousand times",
                    "persona_id": "Clancy"
                },
                {
                    "n": "5",
                    "text": "Makin' my way towards you",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I would swim the Paladin Strait",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "Without any floatation",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Just a glimpse of visual aid",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "Of you on the other shoreline",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "Waitin', expectations that I'm gonna make it",
                    "persona_id": "Clancy"
                },
                {
                    "n": "5",
                    "text": "Mm-hm, hm-hm-hm",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
