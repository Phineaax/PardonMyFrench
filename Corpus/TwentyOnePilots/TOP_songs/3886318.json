            "lines": [
                {
                    "n": "0",
                    "text": "I could take the high road",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "But I know that I'm goin' low",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "I'm a ban—I'm a bandito",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "I could take the high road",
                    "persona_id": "Clancy"
