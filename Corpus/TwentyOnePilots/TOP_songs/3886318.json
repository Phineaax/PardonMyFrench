            ]
        },
        {
            "section_id": "section_1",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "This is the sound we make",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "When in between two places",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Where we used to bleed",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "And where our blood needs to be",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "chorus",
            "performer": "",
