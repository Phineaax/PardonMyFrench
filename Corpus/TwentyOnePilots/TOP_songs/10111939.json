                    "n": "1",
                    "text": "There's no chance I will shake this again",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "'Cause I feel the pull, water's over my head",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "Strength enough for one more time",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "Reach my hand above the tide",
                    "persona_id": "Clancy"
                },
                {
                    "n": "5",
                    "text": "I'll take anything you have",
                    "persona_id": "Clancy"
                },
                {
                    "n": "6",
                    "text": "If you could throw me a line",
                    "persona_id": "Clancy"
                },
                {
                    "n": "7",
                    "text": "I should've loved you better",
                    "persona_id": "Clancy"
                },
                {
                    "n": "8",
                    "text": "Do you think that now's the time",
                    "persona_id": "Clancy"
                },
                {
                    "n": "9",
                    "text": "You should let go?",
                    "persona_id": "Clancy"
                }
            ]
        },
