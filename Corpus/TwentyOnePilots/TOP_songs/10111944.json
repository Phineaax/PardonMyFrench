    "lyrics": [
        {
            "section_id": "section_0",
            "type": "intro",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I don't know why I can't stop crying",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "And I'm thinking about getting old",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "And I don't know a lot about you still",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Seems I get in my own way",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "The more I think, the less I say",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "I hope I communicate the craving",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "Now I see intentions don't mean much",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Say enough, say enough",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "Did I let her know, let her know?",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "If I found my body in chains",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "I'd lay down and wait",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "And hope she looks for me",
                    "persona_id": "Clancy"
                },
                {
                    "n": "5",
                    "text": "And hope she looks for me-e-e-e-e",
                    "persona_id": "Clancy"
                },
                {
                    "n": "6",
                    "text": "(Ooh-ooh-ooh-ooh-ooh)",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_3",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "She just wants to catch a wave",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "Ride it out to the end of her days",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "I hope that I can satiate the craving",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "Now I see the gesture don't mean much",
                    "persona_id": "Clancy"
