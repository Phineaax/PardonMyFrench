                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I can't seem to turn the page",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "This haze around my face makes me feel all alone",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "I know you see me standin' still",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "But when our fingers touch, I feel my way back home",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Pardon my delay",
                    "persona_id": "Clancy"
                },
