                },
                {
                    "n": "3",
                    "text": "Feelin' the reality that everybody leaves",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "My dad just lost his mom, I think that everybody leaves",
                    "persona_id": "Clancy"
                },
                {
                    "n": "5",
                    "text": "And now I'm tryin' to hold onto you 'cause everybody leaves",
                    "persona_id": "Clancy"
