    "lyrics": [
        {
            "section_id": "section_0",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I wish I found some better sounds no one's ever heard",
                    "persona_id": "Blurryface"
                },
                {
                    "n": "1",
                    "text": "I wish I had a better voice that sang some better words",
                    "persona_id": "Blurryface"
                },
                {
                    "n": "2",
                    "text": "I wish I found some chords in an order that is new",
                    "persona_id": "Blurryface"
                },
                {
                    "n": "3",
                    "text": "I wish I didn't have to rhyme every time I sang",
                    "persona_id": "Blurryface"
                },
                {
                    "n": "4",
                    "text": "I was told, when I get older, all my fears would shrink",
                    "persona_id": "Blurryface"
                },
                {
                    "n": "5",
                    "text": "But now I'm insecure, and I care what people think",
                    "persona_id": "Blurryface"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "pre-chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "My name's Blurryface and I care what you think",
                    "persona_id": "Blurryface"
                },
