        {
            "section_id": "section_3",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "He's thinking, \"There's no way I'm headed there\"",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "Always sure-footed, educated, and was never scared",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Now he can't hold out his hand without it shaking",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "Hounded by a bunch of dead when the search party found him",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "Fresh off a binger in the woods",
                    "persona_id": "Clancy"
                },
