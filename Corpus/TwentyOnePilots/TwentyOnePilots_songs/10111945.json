    "lyricists": "[50268, 574050]",
    "lyrics": [
        {
            "section_id": "section_0",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Not sure when it started, peelin' from his bones",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "Piece it back together all alone",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Hope it held together long enough for he",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "To pitch the greener grasses and hope that she would agree",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "Fresh off a binger in the woods",
                    "persona_id": "Clancy"
                },
                {
                    "n": "5",
                    "text": "Flesh covered in bites",
                    "persona_id": "Clancy"
                },
                {
                    "n": "6",
                    "text": "Testing what is real, what is good",
                    "persona_id": "Clancy"
                },
                {
                    "n": "7",
                    "text": "Man, it's been a long night",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "pre-chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "It's a tribute to zombies of which I've become",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "Where do I go from here?",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Where do I go from here?",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Clinging to promisеs",
