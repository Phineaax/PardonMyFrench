            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I'm evil to the core, what I shouldn't do I will",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "They say I'm emotional, what I wanna save I'll kill",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Is that who I truly am? I truly don't have a chance",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "Tomorrow I'll keep a beat and repeat yesterday's dance",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_2",
