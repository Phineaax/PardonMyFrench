        {
            "section_id": "section_6",
            "type": "bridge",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Days feel like a perfect length",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "I don't need them any longer, but for goodness' sake",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "Do the years seem way too short for my soul, corazón",
                    "persona_id": "Clancy"
