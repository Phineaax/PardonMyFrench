        {
            "section_id": "section_0",
            "type": "verse",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "I'm tired of tending to this fire",
                    "persona_id": "Clancy"
                },
                {
                    "n": "1",
                    "text": "I've used up all I've collected",
                    "persona_id": "Clancy"
                },
                {
                    "n": "2",
                    "text": "I have singed my hands",
                    "persona_id": "Clancy"
                },
                {
                    "n": "3",
                    "text": "It's glowing, embers barely showing",
                    "persona_id": "Clancy"
                },
                {
                    "n": "4",
                    "text": "Proof of life in the shadows",
                    "persona_id": "Clancy"
                },
                {
                    "n": "5",
                    "text": "Dancing on my plans",
                    "persona_id": "Clancy"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "chorus",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "They know that it's almost",
                    "persona_id": "Clancy"
                },
