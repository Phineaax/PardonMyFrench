_id": "Dr. Octagon"}, {"n": "40", "text": "Ants...", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "41", "text": "Ants, terrible lookin, walkin side to side like a work farm", "rhyme": "uRm", "persona_id": "Dr. Octagon"}, {"n": "42", "text": "Some mean no harm", "rhyme": "uRm", "persona_id": "Dr. Octagon"}, {"n": "43", "text": "With the fire department, ring the alarm", "rhyme": "uRm", "persona_id": "Dr. Octagon"}, {"n": "44", "text": "Ants work for America, some work for Saddam", "rhyme": "am", "persona_id": "Dr. Octagon"}, {"n": "45", "text": "Some speak out talk loud, some chew on bread", "rhyme": "Ed", "persona_id": "Dr. Octagon"}, {"n": "46", "text": "Some move calm, ants move well", "rhyme": "El", "persona_id": "Dr. Octagon"}, {"n": "47", "text": "Church and collars with the lapel", "rhyme": "El", "persona_id": "Dr. Octagon"}, {"n": "48", "text": "Time's up, ants move with the bell", "rhyme": "El", "persona_id": "Dr. Octagon"}, {"n": "49", "text": "You can't tell, that's ants", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "50", "text": "{*DJ Dexter scratches to end*}", "rhyme": "End", "persona_id": "Dr. Octagon"}]}], "album_id": 2611}