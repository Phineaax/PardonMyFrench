{"song_id": 18009, "title": "Ants", "language": "en", "lyricists": [2533, 1692], "lyrics": [{"section_id": "section_0", "type": "kool", "performer": "", "lines": [{"n": "0", "text": "Ants... ants...", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "1", "text": "Los Angeles", "rhyme": "abl", "persona_id": "Dr. Octagon"}, {"n": "2", "text": "Ants, cruisin up with airplanes", "rhyme": "an", "persona_id": "Dr. Octagon"}, {"n": "3", "text": "Lookin out, down at people like ants", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "4", "text": "Overcrowded streets", "rhyme": "it", "persona_id": "Dr. Octagon"}, {"n": "5", "text": "Two zillion pairs of shoes and sneakers walk the streets", "rhyme": "it", "persona_id": "Dr. Octagon"}, {"n": "6", "text": "Eight thousand million people swimmin on the beach", "rhyme": "a", "persona_id": "Dr. Octagon"}, {"n": "7", "text": "Ants, work in factory a lot", "rhyme": "o", "persona_id": "Dr. Octagon"}, {"n": "8", "text": "Walkin in back of me", "rhyme": "@", "persona_id": "Dr. Octagon"}, {"n": "9", "text": "You jam-packed, the place is agony", "rhyme": "i", "persona_id": "Dr. Octagon"}, {"n": "10", "text": "9 to 5 workin like ants", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "11", "text": "You don't have to be a chance", "rhyme": "#s", "persona_id": "Dr. Octagon"}, {"n": "12", "text": "Under the circumstance, look at 'em crawl", "rhyme": "ol", "persona_id": "Dr. Octagon"}, {"n": "13", "text": "Look at 'em move up the wall like roaches", "rhyme": "otS", "persona_id": "Dr. Octagon"}, {"n": "14", "text": "That's right you see the coaches", "rhyme": "otS", "persona_id": "Dr. Octagon"}, {"n": "15", "text": "Look through the microscope and glance", "rhyme": "#s", "persona_id": "Dr. Octagon"}, {"n": "16", "text": "People are ants", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "17", "text": "Ants...", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "18", "text": "Ants...", "rhyme": "#", "persona_id": "Dr. Octagon"}, {"n": "19",