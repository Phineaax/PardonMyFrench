            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "J'ai la mélo’ dans la tête, tu veux le flow, je l'amène",
                    "rhyme": "En",
                    "persona_id": "003"
                },
                {
                    "n": "1",
                    "text": "Viens faire un tour dans les hills, j'te laisse passer les vitesses",
                    "rhyme": "Es",
                    "persona_id": "003"
                },
                {
                    "n": "2",
                    "text": "Deux mille euros dans la veste, en tournée y'a tout qu'est complet",
                    "rhyme": "E",
                    "persona_id": "003"
                },
                {
                    "n": "3",
                    "text": "Je fais que ce qui me plait, j'pourrais tuer la concu' comme aç",
                    "rhyme": "$",
                    "persona_id": "003"
                },
                {
                    "n": "4",
                    "text": "Hun avoue, t'en as jamais croisé des comme moi",
                    "rhyme": "a",
                    "persona_id": "003"
                },
                {
                    "n": "5",
                    "text": "Hun, ils essayent de tout décrypter en comments",
                    "rhyme": "ent",
                    "persona_id": "003"
                },
                {
                    "n": "6",
                    "text": "Hun, on fait les euros, me demande pas comment",
                    "rhyme": "ent",
                    "persona_id": "003"
                }
            ]
        },
        {
            "section_id": "section_2",
