    "song_id": 6962413,
    "title": "UNE HISTOIRE ÉTRANGE",
    "language": "fr",
    "lyricists": [
        308564
    ],
    "lyrics": [
        {
            "section_id": "section_0",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "C'est une histoire étrange",
                    "rhyme": "anZ",
                    "persona_id": "004"
                },
                {
                    "n": "1",
                    "text": "P't-être même que c'est qu'un rêve",
                    "rhyme": "Ev",
                    "persona_id": "004"
                },
                {
                    "n": "2",
                    "text": "Toi, tu veux pas comprendre",
                    "rhyme": "andR",
                    "persona_id": "004"
                },
                {
                    "n": "3",
                    "text": "Mais tu veux qu'ils te comprennent",
                    "rhyme": "En",
                    "persona_id": "004"
                },
                {
                    "n": "4",
                    "text": "Donc tu cours toute la semaine",
                    "rhyme": "En",
                    "persona_id": "004"
                },
                {
                    "n": "5",
                    "text": "Tu vois même plus les étoiles dans l'ciel",
                    "rhyme": "El",
                    "persona_id": "004"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Je t'ai vu, toutes ces nuits d'vant ton iPod cassé",
                    "rhyme": "e",
                    "persona_id": "004"
                },
                {
                    "n": "1",
                    "text": "Écrire des lignes et des lignes sur des bouts d'papier",
                    "rhyme": "e",
                    "persona_id": "004"
                },
                {
                    "n": "2",
                    "text": "C'était pas ouf mais au moins t'essayais, réessayais",
                    "rhyme": "E",
                    "persona_id": "004"
                },
                {
                    "n": "3",
                    "text": "Pendant qu'les autres faisaient qu'bégayer",
                    "rhyme": "e",
                    "persona_id": "004"
                },
                {
                    "n": "4",
                    "text": "Et t'as traîné des fois juste pour voir c'que ça fait",
                    "rhyme": "E",
                    "persona_id": "004"
                },
                {
                    "n": "5",
                    "text": "D'être éclaté sous Jack, en avoir rien à foutre",
                    "rhyme": "utR",
                    "persona_id": "004"
                },
                {
                    "n": "6",
                    "text": "T'as fait des connaissances et t'as ouvert ton cœur comme si c'était un stadium de foot",
                    "rhyme": "ut",
                    "persona_id": "004"
                },
                {
                    "n": "7",
                    "text": "Tu croyais que c'était tes potes et qu'ils l'seraient à vie",
                    "rhyme": "i",
                    "persona_id": "004"
                },
                {
                    "n": "8",
                    "text": "Que vos destins resteraient liés quoi qu'il arrive",
                    "rhyme": "iv",
                    "persona_id": "004"
                },
                {
                    "n": "9",
                    "text": "Tu t'es trompé mais j'peux pas t'en vouloir, non",
                    "rhyme": "on",
                    "persona_id": "004"
                },
                {
                    "n": "10",
                    "text": "Parce que c'lui qui a jamais essayé s'ra jamais éveillé",
                    "rhyme": "e",
                    "persona_id": "004"
                },
                {
                    "n": "11",
                    "text": "Le bonheur faut l'payer, pas en euros mais avec des larmes, ouais",
                    "rhyme": "E",
                    "persona_id": "004"
                }
            ]
        },
        {
            "section_id": "section_2",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
                    "n": "0",
