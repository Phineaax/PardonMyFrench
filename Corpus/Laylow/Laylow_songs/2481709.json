        {
            "section_id": "section_2",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "Aaaaah, j'suis pas bien pourtant, c'est mon birthday, la faute au rap automatisé",
                    "rhyme": "e",
                    "persona_id": "001"
                },
                {
                    "n": "1",
                    "text": "Ton ke-tru, c'est du copié-collé, j'suis différent, j'en suis pas désolé-olé",
                    "rhyme": "e",
                    "persona_id": "001"
                },
                {
                    "n": "2",
                    "text": "Passement d'jambes, on a fauché des egos et des mollets, mieux vaut pas regarder",
                    "rhyme": "e",
                    "persona_id": "001"
                },
                {
                    "n": "3",
                    "text": "On a tourné quatre clips, on a retourné la son-mai, ah ouais mamen",
                    "rhyme": "En",
                    "persona_id": "001"
                },
                {
                    "n": "4",
                    "text": "J'amène ma merde, amen, elle est mieux qu'la tienne, ça pue sa mère",
                    "rhyme": "ER",
                    "persona_id": "001"
                },
                {
                    "n": "5",
                    "text": "Ils ont le zen ché-bou par la coca', mode de vie de camé, han hrsheum",
                    "rhyme": "2m",
                    "persona_id": "001"
                },
                {
                    "n": "6",
                    "text": "On était au top, gosse-beau tah Nicky Larson (On était au top gosse-beau tah Nicky Larson)",
                    "rhyme": "$",
                    "persona_id": "001"
                },
                {
                    "n": "7",
                    "text": "La vie, ça file vite hein, comme la bouteille en club",
                    "rhyme": "9b",
                    "persona_id": "001"
                },
                {
                    "n": "8",
                    "text": "J'essaie, j'réessaie mais j'tourne en rond",
                    "rhyme": "$",
                    "persona_id": "001"
                },
                {
                    "n": "9",
                    "text": "Le gars veut pas hausser l'taro",
                    "rhyme": "o",
                    "persona_id": "001"
                },
                {
                    "n": "10",
                    "text": "J'suis pas pressé, sers un jus d'orange pressées",
                    "rhyme": "e",
                    "persona_id": "001"
                },
                {
                    "n": "11",
                    "text": "J'connais le processus, à la fin, il donne ses thunes",
                    "rhyme": "yn",
                    "persona_id": "001"
                }
            ]
        },
