    "lyrics": [
        {
            "section_id": "section_0",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "On s'est tués dans la chambre d’hôtel à la Kurt Cobain",
                    "rhyme": "ain",
                    "persona_id": "001" 
                },
                {
                    "n": "1",
                    "text": "Comprends mon langage hyper codé, y a des gouttes de codéine dans ton putain d'gobelet, goddamn",
                    "rhyme": "aim",
                    "persona_id": "001"
                },
                {
                    "n": "2",
                    "text": "On a pris des photos puis on a pris d'autres merdes, j'ai l'foulard de Jimi, les coupes à Dennis Rodman",
                    "rhyme": "an",
                    "persona_id": "001"
                },
                {
                    "n": "3",
                    "text": "Flow de rockstar sur l'Boulevard Haussmann, tous mes négros sont prêts, prêts",
                    "rhyme": "E",
                    "persona_id": "001"
                },
                {
                    "n": "4",
                    "text": "Pour mes négros en r'trait, ceux qu't'as jamais rt, fonces-dé devant Arte",
                    "rhyme": "aRt",
                    "persona_id": "001"
                },
                {
                    "n": "5",
                    "text": "Faut qu'j'roule en Harley, que j'te laisse parler, on s'est aimé faussement mais j't'ai baisé en vrai",
                    "rhyme": "E",
                    "persona_id": "001"
                },
                {
                    "n": "6",
                    "text": "Ça y est, j'suis déconcentré, t'es là, tu t'laisses contempler",
                    "rhyme": "e",
                    "persona_id": "001"
                },
                {
                    "n": "7",
                    "text": "J'peux pas m'contenter, putain c'que t'es bonne quand t'écoutes mon son depuis ton iPhone",
                    "rhyme": "On",
                    "persona_id": "001"
                },
                {
                    "n": "8",
                    "text": "Tu dis qu'tu m'aimes mais t'as dit la même chose à tous les autres",
                    "rhyme": "otR",
                    "persona_id": "001"
                },
                {
                    "n": "9",
                    "text": "J'mets personne d'accord, que des faux raccords",
                    "rhyme": "OR",
                    "persona_id": "001"
                },
                {
                    "n": "10",
                    "text": "Quand il est tard l'inspi' se réveille, le monde se rendort",
                    "rhyme": "OR",
                    "persona_id": "001"
                }
            ]
        },
        {
            "section_id": "section_1",
            "type": "refrain",
            "performer": "",
            "lines": [
                {
