            ]
        },
        {
            "section_id": "section_1",
            "type": "couplet",
            "performer": "",
            "lines": [
                {
                    "n": "0",
                    "text": "J'suis d'vant ta porte avec million d'flowers",
                    "rhyme": "9R",
                    "persona_id": "003"
                },
                {
                    "n": "1",
                    "text": "Dis-moi si c'est trop tard, dis-moi si j'suis toujours à l'heure",
                    "rhyme": "9R",
                    "persona_id": "003"
                },
                {
                    "n": "2",
                    "text": "C'est quand les gens s'éloignent qu'on voit leur valeur",
                    "rhyme": "9R",
                    "persona_id": "003"
                },
                {
                    "n": "3",
                    "text": "Y'a des choses qu'ont pas d'égal, dis-moi si t'es partie ailleurs",
                    "rhyme": "9R",
                    "persona_id": "003"
                },
                {
                    "n": "4",
                    "text": "Et la vie sonne comme mélodie sans l'harmonie",
                    "rhyme": "i",
                    "persona_id": "003"
                },
                {
                    "n": "5",
                    "text": "J'traîne ma peine comme tous ces mélancoliques anonymes",
                    "rhyme": "im",
                    "persona_id": "003"
                },
                {
                    "n": "6",
                    "text": "J'ai la vingtaine mais j'suis triste dans un Merco-Benz",
                    "rhyme": "inz",
                    "persona_id": "003"
                },
                {
                    "n": "7",
                    "text": "Surtout quand j'pense à toi avec un autre",
                    "rhyme": "otR",
                    "persona_id": "003"
                },
                {
                    "n": "8",
                    "text": "Mes projets tombent à l'eau",
                    "rhyme": "o",
                    "persona_id": "003"
                },
                {
                    "n": "9",
                    "text": "Pourtant t'sais bien qu'y a pas d'homme qui fait mieux, oh no",
                    "rhyme": "o",
                    "persona_id": "003"
                },
                {
                    "n": "10",
                    "text": "J'ai la liasse, qu'est ce qui faut d'autre, mama mia ?",
                    "rhyme": "a",
                    "persona_id": "003"
                },
                {
                    "n": "11",
                    "text": "Corazon troué au fusil d’assaut, buenos días",
                    "rhyme": "a",
                    "persona_id": "003"
                },
                {
                    "n": "12",
                    "text": "My love, tu réponds pas quand j'dis \"allô\"",
                    "rhyme": "o",
                    "persona_id": "003"
                }
            ]
        },
