    },
    {
      "section_id": "section_1",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I wanna talk, I wanna call you and talk",
          "rhyme": "Ok",
          "persona_id": "persona_igor"
        },
        {
          "n": "1",
          "text": "I wanna walk to your front door and knock",
          "rhyme": "Ok",
          "persona_id": "persona_igor"
        },
        {
          "n": "2",
          "text": "After I start my vehicle",
          "rhyme": "ikl",
          "persona_id": "persona_igor"
        },
        {
          "n": "3",
          "text": "Drive to your city 'cause we live an hour apart",
          "rhyme": "aR",
          "persona_id": "persona_igor"
        },
        {
          "n": "4",
          "text": "Land at your driveway and put it in park",
          "rhyme": "aRk",
          "persona_id": "persona_igor"
        },
        {
          "n": "5",
          "text": "Then do the third line of this verse",
          "rhyme": "ERs",
          "persona_id": "persona_igor"
        },
        {
          "n": "6",
          "text": "Then back to my house and we pack up our bikes",
          "rhyme": "Eks",
          "persona_id": "persona_igor"
        },
        {
          "n": "7",
          "text": "And we ride through the park, chase the sun",
          "rhyme": "un",
          "persona_id": "persona_igor"
        },
        {
          "n": "8",
          "text": "God, that's all I want, other than air",
          "rhyme": "ER",
          "persona_id": "persona_igor"
        },
        {
          "n": "9",
          "text": "Oxygen and financial freedom, yeah",
          "rhyme": "E",
          "persona_id": "persona_igor"
        },
        {
          "n": "10",
          "text": "I want your company, I need your company",
          "rhyme": "i",
          "persona_id": "persona_igor"
        },
        {
          "n": "11",
          "text": "I want you to want from me",
          "rhyme": "@",
          "persona_id": "persona_igor"
        },
        {
          "n": "12",
          "text": "I can't maneuver without you next to me",
          "rhyme": "@",
          "persona_id": "persona_igor"
        },
        {
          "n": "13",
          "text": "It's so complex to me",
          "rhyme": "@",
          "persona_id": "persona_igor"
        }
      ],
      "rhyme": "AABCDEFGHIJKKK",
      "rhyme_vowel": "AABCCDDEDDBFFF"
    },
    {
      "section_id": "section_2",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "What do you need? Do you need bread?",
          "rhyme": "Ed",
          "persona_id": "persona_igor"
        },
        {
          "n": "1",
          "text": "Do you need this? Do you need a hug?",
          "rhyme": "yg",
