  "lyrics": [
    {
      "section_id": "section_1",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "If God was here with us today",
          "rhyme": "E",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "1",
          "text": "I think I know what He would say (Some shit like)",
          "rhyme": "E",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "2",
          "text": "\"You're so beautiful, and your lips look nice\"",
          "rhyme": "is",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "3",
          "text": "Uh (Not the- not the one on your face)",
          "rhyme": "u",
          "persona_id": "persona_tyler_baudelaire"
        }
      ],
      "rhyme": "AABC",
      "rhyme_vowel": "AABC"
    },
    {
      "section_id": "section_2",
      "type": "refrain",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I got a new boat, you should come with",
          "rhyme": "it",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "1",
          "text": "I got a section for your luggage",
          "rhyme": "aZ",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "2",
          "text": "Bring some fiction and a nightlight",
          "rhyme": "ajt",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "3",
          "text": "Record player and your top five",
          "rhyme": "iv",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "4",
          "text": "Where we goin'? We should get lost",
          "rhyme": "Ost",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "5",
          "text": "No more questions, let the wharf talk, uh",
          "rhyme": "u",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "6",
          "text": "(So there's a lot goin' on, make you comfortable)",
          "rhyme": null,
          "persona_id": "persona_tyler_baudelaire"
        }
      ],
      "rhyme": "ABCDEFG",
      "rhyme_vowel": "ABBACDE"
    },
    {
      "section_id": "section_3",
      "type": "chorus",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "I want you to come get lost with me",
          "rhyme": "@",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "1",
          "text": "Ask you one more time before I tread too deep (I want you)",
          "rhyme": "ip",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "2",
          "text": "So can you make up your mind?",
          "rhyme": "#",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "3",
          "text": "A wave's gonna come, wave's gonna come",
          "rhyme": "om",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "4",
          "text": "So can you make up your mind?",
