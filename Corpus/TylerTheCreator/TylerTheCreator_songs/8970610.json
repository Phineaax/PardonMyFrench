        {
          "n": "2",
          "text": "Soccer mom with the Vans in every color, it seems",
          "rhyme": "Em",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "3",
          "text": "Kids push down the block, cuttin' Dickies into shorts when it's hot",
