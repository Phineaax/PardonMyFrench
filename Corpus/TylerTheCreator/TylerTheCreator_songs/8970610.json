        },
        {
          "n": "4",
          "text": "Fuckin' Wendy's up, brainstormin' ways to get our pennies up",
          "rhyme": "9p",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "5",
          "text": "Me and Jasper spendin' last bucks on the city bus",
          "rhyme": "ys",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "6",
          "text": "Wayne tapes and Vice mags and Portishead drops",
          "rhyme": "o",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "7",
          "text": "Peglegs, Ice Cream shoes, the Mr. Krabs watch",
          "rhyme": "atS",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "8",
          "text": "That was heaven for me 'round time seventeen",
          "rhyme": "in",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "9",
          "text": "Eggin' niggas' houses, fuckin' girls from Pasadena",
          "rhyme": "a",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "10",
          "text": "Bastard wasn't finished, I was formin' up a team",
          "rhyme": "im",
          "persona_id": "persona_tyler_baudelaire"
        },
