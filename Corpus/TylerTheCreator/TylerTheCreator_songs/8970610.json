      "lines": [
        {
          "n": "0",
          "text": "It used to be the 'Preme hat in the green",
          "rhyme": "in",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "1",
          "text": "The cheetah print on the tee, the dark wash on the jean",
