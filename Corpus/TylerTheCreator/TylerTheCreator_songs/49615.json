      "lines": [
        {
          "n": "0",
          "text": "I can grab the fireworks, and soda, all the cookies we can eat",
          "rhyme": "at",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "1",
          "text": "Make you nauseous, but be cautious, this is not Dawson's Creek",
