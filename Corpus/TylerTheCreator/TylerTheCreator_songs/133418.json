      "lines": [
        {
          "n": "0",
          "text": "Went to Six Flags, six fags came up",
          "rhyme": "9p",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "1",
          "text": "And said \"Ayo! Can we get a pic?\" I said no",
          "rhyme": "o",
