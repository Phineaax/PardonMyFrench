        },
        {
          "n": "33",
          "text": "I carved OF on it this morning with a glass shard",
          "rhyme": "aR",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "34",
          "text": "On my green mini ramp that I built in my backyard (That's weird)",
