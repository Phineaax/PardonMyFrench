          "rhyme": "ud",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "5",
          "text": "Call me lumbеrjack 'cause I wish a nigga would race (Uh-huh, right)",
          "rhyme": "as",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
