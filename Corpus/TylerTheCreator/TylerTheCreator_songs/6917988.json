        {
          "n": "0",
          "text": "Ayo, I might just sled in Utah, LA is too warm",
          "rhyme": "uRm",
          "persona_id": "persona_tyler_baudelaire"
        },
        {
          "n": "1",
          "text": "My nigga tall, he look like a bitch, I call him Mulan (Hey, oh)",
