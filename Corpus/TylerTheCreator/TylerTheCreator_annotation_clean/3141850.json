      "lines": [
        {
          "n": "0",
          "text": "I wrote a song about you, I want your opinion",
          "rhyme": "$",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "1",
          "text": "Opposite of my heart rate, it slows down at the ending",
          "rhyme": "iN",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "2",
          "text": "'Cause the love that I got for you has exceeded appearance",
          "rhyme": "#s",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "3",
          "text": "The lyrics are—",
          "rhyme": "aR",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "4",
          "text": "Matter of fact, I'ma just call you, so you can hear it",
          "rhyme": "it",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "5",
          "text": "If you do answer, I'll play it to state facts",
