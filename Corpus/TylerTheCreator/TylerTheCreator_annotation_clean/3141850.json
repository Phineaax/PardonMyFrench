          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "7",
          "text": "At that point, I'll hang up, disappear and just stay back",
          "rhyme": "ak",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "8",
