      "lines": [
        {
          "n": "0",
          "text": "Fly with the birds in the wind",
          "rhyme": "#",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "1",
          "text": "Where you wanna go, who, what, why, when? Uh",
