        },
        {
          "n": "2",
          "text": "Motherfuckers getting lynched and burned",
          "rhyme": "Ed",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "3",
          "text": "I earned it, my Flog Gnaw badge is looking good",
          "rhyme": "ud",
