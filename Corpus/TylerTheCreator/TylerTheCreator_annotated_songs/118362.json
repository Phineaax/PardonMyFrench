          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "7",
          "text": "Hurry, quickly, I need a piece of Hershey's",
          "rhyme": "ins",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "8",
          "text": "Darker than the corners of the bushes we be lurking",
          "rhyme": "iN",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "9",
          "text": "I centered the mellow over the graham",
          "rhyme": "am",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "10",
          "text": "Heated it too long now, it's melting over my hand",
          "rhyme": "#d",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "11",
          "text": "Fuck it, I'll bite it, I burnt it, but I liked it",
          "rhyme": "it",
          "persona_id": "persona_wolf_haley"
        },
        {
          "n": "12",
          "text": "Camping with my niggas, it's so fucking exciting",
          "rhyme": "iN",
          "persona_id": "persona_wolf_haley"
        }
