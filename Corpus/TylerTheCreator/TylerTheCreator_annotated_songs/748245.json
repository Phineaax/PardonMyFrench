        }
      ],
      "rhyme": "ABC",
      "rhyme_vowel": "AAA"
    },
    {
      "section_id": "section_1",
      "type": "verse",
      "performer": "",
      "lines": [
        {
          "n": "0",
          "text": "Aw, nah, boy, don't cut that wood",
          "rhyme": "ud",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "1",
          "text": "Found out his flowers don't smell that good",
          "rhyme": "ud",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "2",
          "text": "But if they smell real good to him",
          "rhyme": "im",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "3",
          "text": "Then he don't need nobody else nose to win",
          "rhyme": ")",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "4",
          "text": "Look, I am a god",
          "rhyme": "ud",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "5",
          "text": "Nobody prays to the sight of you",
          "rhyme": "u",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "6",
          "text": "All y'all niggas wear camouflage",
          "rhyme": "aZ",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "7",
          "text": "I'm in a field wearing pink and blue",
          "rhyme": "y",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "8",
          "text": "I wear pink, they can see me",
          "rhyme": "@",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "9",
          "text": "Nigga, you don't create, you just repeat",
          "rhyme": "at",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "10",
          "text": "Nigga, you don't got drive, you just beep-beep",
          "rhyme": "ip",
          "persona_id": "persona_chur_bum"
        },
        {
          "n": "11",
          "text": "Beep-beep, talk shit from the backseat",
