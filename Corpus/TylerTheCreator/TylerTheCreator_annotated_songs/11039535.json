          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "20",
          "text": "Ten years later, mighta changed my mind",
          "rhyme": "#",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "21",
          "text": "I'm a fake-ass bitch, don't kill me",
