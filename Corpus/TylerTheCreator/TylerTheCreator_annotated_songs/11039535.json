        },
        {
          "n": "10",
          "text": "I got a big ol' head, I ain't like these niggas (Yes)",
          "rhyme": "a",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "11",
          "text": "Uh-uh, don't put me with these niggas (Yes)",
          "rhyme": "a",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "12",
          "text": "I don't \"haha, keke\" with these niggas (Yes)",
          "rhyme": "a",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "13",
          "text": "Loiter Squad, baby, I don't be with these niggas (Yes)",
          "rhyme": "a",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "14",
          "text": "Same boys with me since back, back then (Alright)",
          "rhyme": "En",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "15",
          "text": "Everything I said I'd do, I did (True story)",
