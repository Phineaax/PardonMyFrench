          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "23",
          "text": "I'm a big troll, haha, I'm silly (I'm silly)",
          "rhyme": "i",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "24",
          "text": "Fuck you know about being better than them niggas that you hate?",
