        },
        {
          "n": "28",
          "text": "Don't test V, he pop for real (Don't bother)",
          "rhyme": "il",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "29",
          "text": "Had to call him like stop and chill, look (Ah)",
