        },
        {
          "n": "7",
          "text": "They just got the closest picture of the fuckin' sun surface, that was us",
          "rhyme": "ys",
          "persona_id": "persona_guest"
        },
        {
          "n": "8",
          "text": "Got the LaFerrari, park that bitch just for one purpose, catchin' dust",
