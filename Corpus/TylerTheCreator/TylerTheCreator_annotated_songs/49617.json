          "n": "12",
          "text": "You gotta be fucking kidding me",
          "rhyme": "@",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "13",
          "text": "In school, I was a zero, now I'm every boy's hero, and they fear it",
          "rhyme": "it",
          "persona_id": "persona_tyler_baseline"
