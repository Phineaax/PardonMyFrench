      "performer": ", ",
      "lines": [
        {
          "n": "0",
          "text": "Down to fucking Earth, huh? Down to fucking Earth, huh?",
          "rhyme": "u",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "1",
          "text": "Fuck everybody, here goes some extra girth, Sir",
