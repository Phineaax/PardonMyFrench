        },
        {
          "n": "14",
          "text": "You sing along, but you don't know me, nigga",
          "rhyme": "a",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "15",
          "text": "Nah, never ever, not at all, y'all",
          "rhyme": "ol",
          "persona_id": "persona_tyler_baseline"
        },
        {
          "n": "16",
          "text": "Niggas crossed the line, like fuck the stop sign (Noid)",
