          "persona_id": "persona_guest"
        },
        {
          "n": "2",
          "text": "Let me try that hat on",
          "rhyme": "$",
          "persona_id": "persona_guest"
        },
        {
          "n": "3",
          "text": "I told you come over here, stupid bitch",
          "rhyme": "itS",
          "persona_id": "persona_guest"
        },
        {
          "n": "4",
          "text": "Come over here with that weak ass hat",
          "rhyme": "a",
          "persona_id": "persona_guest"
        },
        {
          "n": "5",
          "text": "You bitch ass nigga",
          "rhyme": "a",
