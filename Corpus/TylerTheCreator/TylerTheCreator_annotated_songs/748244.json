        },
        {
          "n": "6",
          "text": "Preachy shit, my nigga",
          "rhyme": "a",
          "persona_id": "persona_guest"
        },
        {
          "n": "7",
          "text": "Yeah, we all black, who give a fuck, cuz?",
          "rhyme": "y",
          "persona_id": "persona_guest"
        },
        {
          "n": "8",
          "text": "I'm runnin', I'm runnin', I'm runnin'",
